name: XOTA DUB 82
meter: 3/4
# Galicia. Tempo sugerido: 82 BPM (negras; compas 3/4).
# Fusion: xota en 3/4 con one drop (bombo e aro no terceiro pulso) e skank a contratempo.
# Voces: kick=bombo · snare=tamboril/caixa · clap=pel da pandeireta, cunchas ou palmas
# hhc=ferrenas (pandeireta) · hho=xiro/arrastre de ferrenas · lotom/hitom=baixo (ronco, bordon).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    ..X. ..X. ..X.
hho    .... .... ..X.

[p1]
kick   X... .... ....
snare  .... .... X...
hhc    ..X. ..X. ..X.
hho    .... .... ..X.
lotom  X... .... ....

[p2]                         # ENERGIA
kick   .... .x.. X...
snare  .... ...o X...
clap   .... x... ....
hhc    o-X- o-X- o-X-
hho    .... .... ..X.
hitom  .... .... x...
lotom  X... ..X. ....

[p3]
kick   .... .x.. XX..
snare  .... ...o X...
clap   .... x... ....
hhc    o-X- o-X- o-X-
hho    .... .... ..X.
hitom  .... .... x.X.
lotom  X... X.X. ....

[p4]                         # BASE
kick   .... .... X...
snare  .... .... X...
clap   .... x... ....
hhc    ..X. ..X. ..X.
hho    .... .... ..X.
hitom  .... .... x...
lotom  X... ..X. ....

[p5]
kick   .... .... X...
snare  .... .... X...
clap   .... x... ....
hhc    ..X. ..X. ..X.
hho    .... .... ..X.
hitom  .... .... x...
lotom  X... X.X. ....

[p6]                         # VARIACION
kick   .... .... X...
snare  .... x... ....
clap   .... .... X...
hhc    .... .... ..X.
hho    ..X. ..X. ..X.
hitom  .... .... x...
lotom  X... ..X. ....

[p7]
kick   .... .... X...
snare  .... x... ....
clap   .... .... X...
hhc    .... .... ..X.
hho    ..X. ..X. ..X.
hitom  .... .... xx..
lotom  X... X.X. ..Xo

[p8]                         # FILL
kick   X... .... ....
hhc    ..X. ..X. ..X.
hho    .... .... ..X.
hitom  .... .... x.X.
lotom  X... .... ....
