name: CANDOMBE 110
# Latin America & Caribbean. Tempo sugerido: 110 BPM.
# Candombe (Uruguai): madeira coa clave, tambor piano marcando.
# Voces: clap=madeira · lotom=piano · hitom=repique.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.XX X.XX X.XX X.XX

[p1]
kick   X... .... .... ....
snare  .... .X.X ...X .XXX
clap   X..X ..X. ..X. X...
hhc    X.XX X.XX X.XX X.XX
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x X... ....
snare  .... oXoX ..oX oXoX
clap   X.oX .oX. .oXo X...
hhc    X-XX X-XX X-XX X-XX
hho    .... .... .... ..X.
hitom  ..X. .... X.X. ....
lotom  X... X..X .... X...

[p3]
kick   X... ...x X... .X..
snare  .... oXoX ..oX oXXX
clap   X.oX .oX. .oXo X...
hhc    X-XX X-XX X-XX X-XX
hho    .... .... .... ..X.
hitom  ..X. .... X.X. ..X.
lotom  X... X..X .... X...

[p4]                         # BASE
kick   X... .... X... ....
snare  .... .X.X ...X .X.X
clap   X..X ..X. ..X. X...
hhc    X.XX X.XX X.XX X.XX
hitom  ..X. .... X.X. ....
lotom  X... X..X .... X...

[p5]
kick   X... .... X... ....
snare  .... .X.X ...X .XXX
clap   X..X ..X. ..X. X...
hhc    X.XX X.XX X.XX X.XX
hitom  ..X. .... X.X. ..X.
lotom  X... X..X .... X...

[p6]                         # VARIACION
kick   X... .... X... ....
snare  X..X ..X. ..X. X...
clap   .... .X.X ...X .X.X
hhc    X..X X..X X..X X..X
hho    ..X. ..X. ..X. ..X.
hitom  ..X. .... X.X. ....
lotom  X... X..X .... X...

[p7]
kick   X... .... X... ....
snare  X..X ..X. ..X. X...
clap   .... .X.X ...X .XXX
hhc    X..X X..X X..X X..X
hho    ..X. ..X. ..X. ..X.
hitom  ..X. .... X.X. .xX.
lotom  X... X..X .... X..o

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
