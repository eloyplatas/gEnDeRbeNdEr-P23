name: UK DUB STEPPERS 140
# Reggae, dub & rocksteady. Tempo sugerido: 140 BPM.
# Dub steppers britanico (anos 90): catro no chan a 140 e caixa no 3 (medio tempo).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    ..X. ..X. ..X. ..X.

[p1]
kick   X... .... .... ....
snare  .... .... X... ....
hhc    ..X. ..X. ..X. ..X.
hho    .... .... .... ..X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... X..x X... X...
snare  .... ...o X... ....
hhc    o-X- o-X- o-X- o-X-
hho    .... .... .... ..X.
lotom  X... .... X..X ....

[p3]
kick   X... X..x X... XX..
snare  .... ...o X... ....
hhc    o-X- o-X- o-X- o-X-
hho    .... .... .... ..X.
lotom  X... .... X... ..X.

[p4]                         # BASE
kick   X... X... X... X...
snare  .... .... X... ....
hhc    ..X. ..X. ..X. ..X.
lotom  X... .... X..X ....

[p5]
kick   X... X... X... X...
snare  .... .... X... ....
hhc    ..X. ..X. ..X. ..X.
hho    .... .... .... ..X.
lotom  X... .... X... ..X.

[p6]                         # VARIACION
kick   X... X... X... X...
snare  .... .... X... ....
hho    ..X. ..X. ..X. ..X.
hitom  .... .... ...X ....
lotom  X... .... X... ....

[p7]
kick   X... X... X... X...
snare  .... .... X... ....
hhc    .... .... .... ..X.
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .... Xx..
lotom  X... .... X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
