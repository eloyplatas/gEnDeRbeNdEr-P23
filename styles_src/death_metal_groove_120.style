name: DEATH METAL GROOVE 120
# Metal. Tempo sugerido: 120 BPM.
# Death metal: groove medio con redobres de dobre bombo.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hho    X... .... X... ....

[p1]
kick   X... .... .... ....
snare  .... X... .... X...
hho    X... .... X... ....
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X.XX X.XX X.XX XXXX
snare  ...o X... ...o X...
hho    X... .... X... ....
lotom  X... X... X... X...

[p3]
kick   X.XX X.XX X.XX XXXX
snare  ...o X... ...o X...
hho    X... .... X... ....
hitom  .... .... .... ..X.
lotom  X... X... X... X...

[p4]                         # BASE
kick   X.XX X.XX X.XX XXXX
snare  .... X... .... X...
hho    X... .... X... ....
lotom  X... X... X... X...

[p5]
kick   X.XX X.XX X.XX XXXX
snare  .... X... .... X...
hho    X... .... X... ....
lotom  X... X... X... X...

[p6]                         # VARIACION
kick   X.XX X.XX X.XX XXXX
snare  .... X... .... X...
hho    X... .... X... ....
lotom  X... X... X... X...

[p7]
kick   X.XX X.XX X.XX XXXX
snare  .... X... .... X...
hho    X... .... X... ....
hitom  .... .... .... .x..
lotom  X... X... X... X.Xo

[p8]                         # FILL
kick   X..X .... X... ....
snare  ........ ........ xoxoxoxo xoXXXXXX
hhc    ..Xo XoXo .... ....
hho    X... .... .... ....
hitom  .... ..XX .... ....
lotom  .... .... .... ...X
