name: JOTA ARAGONESA 200
meter: 3/4
# European folk. Tempo sugerido: 200 BPM (negras; compas 3/4).
# Xota aragonesa, 3/4 rapido: castanolas con redobre no un.
# Voces: hhc=castanolas · kick/snare=tambor.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    XxxX X.X. X.X.

[p1]
kick   X... .... ....
snare  .... X... X...
hhc    XxxX X.X. X.X.
lotom  X... .... ....

[p2]                         # ENERGIA
kick   X... .x.. ....
snare  ...o X..o X...
hhc    XXXX X-X- X-X-
hho    .... .... ..X.
lotom  X... .... X...

[p3]
kick   X... .x.. .X..
snare  ...o X..o X...
hhc    XXXX X-X- X-X-
hho    .... .... ..X.
hitom  .... .... ..X.
lotom  X... .... X...

[p4]                         # BASE
kick   X... .... ....
snare  .... X... X...
hhc    XxxX X.X. X.X.
lotom  X... .... X...

[p5]
kick   X... .... ....
snare  .... X... X...
hhc    XxxX X.X. X.X.
lotom  X... .... X...

[p6]                         # VARIACION
kick   X... .... ....
snare  .... X... X...
hhc    Xx.X X... X...
hho    ..x. ..X. ..X.
lotom  X... .... X...

[p7]
kick   X... .... ....
snare  .... X... X...
hhc    Xx.X X... X...
hho    ..x. ..X. ..X.
hitom  .... .... .x..
lotom  X... .... X.Xo

[p8]                         # FILL
kick   X... X... X...
snare  .... .... ooxX
clap   .... .... ...X
hhc    XxxX X.X. X.X.
hho    X... .... ....
hitom  .... Xx.. ....
lotom  .... ..Xx ....
