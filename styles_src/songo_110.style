name: SONGO 110
# Jazz & blues. Tempo sugerido: 110 BPM.
# Songo (Changuito, Cuba): caixa e toms cruzados sobre clave 2-3, bombo anticipado.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X.X. X.X. X.X.

[p1]
kick   X... .... .... ....
snare  ..X. .X.. .... X...
clap   ..X. X... X..X ..X.
hhc    X.X. X.X. X.X. X.X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   ...X ...x ..X. ....
snare  .oX. oX.x ...o X..x
clap   .oXo X..o X.oX .oX.
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
hitom  .... ..X. .... ..X.
lotom  ...X ...X ..X. ....

[p3]
kick   ...X ...x ..X. .X..
snare  .oX. oX.x ...o X..x
clap   .oXo X..o X.oX .oX.
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
hitom  .... ..X. .... .XX.
lotom  ...X ...X ..X. ....

[p4]                         # BASE
kick   ...X .... ..X. ....
snare  ..X. .X.x .... X..x
clap   ..X. X... X..X ..X.
hhc    X.X. X.X. X.X. X.X.
hitom  .... ..X. .... ..X.
lotom  ...X ...X ..X. ....

[p5]
kick   ...X .... ..X. .X..
snare  ..X. .X.x .... X..x
clap   ..X. X... X..X ..X.
hhc    X.X. X.X. X.X. X.X.
hitom  .... ..X. .... .XX.
lotom  ...X ...X ..X. ....

[p6]                         # VARIACION
kick   ...X .... ..X. ....
snare  ..X. X... X..X ..X.
clap   ..X. .X.x .... X..x
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
hitom  .... ..X. .... ..X.
lotom  ...X ...X ..X. ....

[p7]
kick   ...X .... ..X. .X..
snare  ..X. X... X..X ..X.
clap   ..X. .X.x .... X..x
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
hitom  .... ..X. .... XXX.
lotom  ...X ...X ..X. ...o

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
