name: BHANGRA 100
# Asia & Middle East. Tempo sugerido: 100 BPM.
# Bhangra: dhol con chaal (dagga grave e tilli agudo).
# Voces: kick/lotom=dagga · snare/hitom=tilli.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
clap   .... X... .... X...

[p1]
kick   X... .... .... ....
snare  ..X. X..X X.X. .X.X
clap   .... X... .... X...
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ..Xx ..X. ....
snare  .oXo X.oX XoX. oXoX
clap   ...o X... ...o X...
hitom  ...X .... .X.. .X..
lotom  X... ..X. ..X. ....

[p3]
kick   X... ..Xx ..X. .X..
snare  .oXo X.oX XoX. oXoX
clap   ...o X... ...o X...
hitom  ...X .... .X.. .XX.
lotom  X... ..X. ..X. ....

[p4]                         # BASE
kick   X... ..X. ..X. ....
snare  ..X. X..X X.X. .X.X
clap   .... X... .... X...
hitom  ...X .... .X.. .X..
lotom  X... ..X. ..X. ....

[p5]
kick   X... ..X. ..X. ....
snare  ..X. X..X X.X. .X.X
clap   .... X... .... X...
hitom  ...X .... .X.. .XX.
lotom  X... ..X. ..X. ....

[p6]                         # VARIACION
kick   X... ..X. ..X. ....
snare  .... X... .... X...
clap   ..X. X..X X.X. .X.X
hitom  ...X .... .X.. .X..
lotom  X... ..X. ..X. ....

[p7]
kick   X... ..X. ..X. ....
snare  .... X... .... X...
clap   ..X. X..X X.X. .X.X
hitom  ...X .... .X.. XXX.
lotom  X... ..X. ..X. ...o

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
