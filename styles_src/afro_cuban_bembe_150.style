name: AFRO CUBAN BEMBE 150
meter: 6/8
# Jazz & blues. Tempo sugerido: 150 BPM (negras; compas 6/8).
# Bembe 6/8 (afrocubano, base do jazz modal): campa estandar de 12 pulsos.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X.XX .X.X.X

[p1]
kick   X..... ......
snare  ...... ...X..
clap   ...... X.....
hhc    X.X.XX .X.X.X
lotom  X..... ......

[p2]                         # ENERGIA
kick   X....x X.....
snare  ..x..x ..x..x
clap   .....o X.....
hhc    X-X-XX oXoXoX
hho    ...... ....X.
hitom  ...X.. ...X..
lotom  X..... X.....

[p3]
kick   X....x X..X..
snare  ..x..x ..xX.x
clap   .....o X.....
hhc    X-X-XX oXoXoX
hho    ...... ....X.
hitom  ...X.. ...XX.
lotom  X..... X..X..

[p4]                         # BASE
kick   X..... X.....
snare  ..x..x ..x..x
clap   ...... X.....
hhc    X.X.XX .X.X.X
hitom  ...X.. ...X..
lotom  X..... X.....

[p5]
kick   X..... X.....
snare  ..x..x ..xX.x
clap   ...... X.....
hhc    X.X.XX .X.X.X
hitom  ...X.. ...X..
lotom  X..... X..X..

[p6]                         # VARIACION
kick   X..... X.....
snare  ...... X.....
clap   ..x..x ..x..x
hhc    X.X..X .X.X.X
hho    ....X. ......
hitom  ...X.. ...X..
lotom  X..... X.....

[p7]
kick   X..... X.....
snare  ...... X.....
clap   ..x..x ..xX.x
hhc    X.X..X .X.X.X
hho    ....X. ......
hitom  ...X.. ..XX..
lotom  X..... X..XXo

[p8]                         # FILL
kick   X..... ......
snare  ...... ooxxXX
clap   ...... .....X
hhc    X.X.X. ......
hho    X..... ......
hitom  XxX... ......
lotom  ...xXx ......
