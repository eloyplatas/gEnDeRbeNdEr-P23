name: MOTOWN SOUL 120
# Soul & funk. Tempo sugerido: 120 BPM.
# Motown: caixa nos catro pulsos (acento no 2 e 4) e pandeiro no 2 e 4.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X.X. X.X. X.X.

[p1]
kick   X... .... .... ....
snare  .... X... .... X...
clap   .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ..Xx X... ..X.
snare  x..o X... x..o X...
clap   ...o X... ...o X...
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
lotom  X... ..X. X... ..X.

[p3]
kick   X... ..Xx X... .XX.
snare  x..o X... x..o X...
clap   ...o X... ...o X...
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
lotom  X... ..X. X..X ..X.

[p4]                         # BASE
kick   X... ..X. X... ..X.
snare  x... X... x... X...
clap   .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
lotom  X... ..X. X... ..X.

[p5]
kick   X... ..X. X... ..X.
snare  x... X... x... X...
clap   .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
lotom  X... ..X. X..X ..X.

[p6]                         # VARIACION
kick   X... ..X. X... ..X.
snare  .... X... .... X...
clap   x... X... x... X...
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
lotom  X... ..X. X... ..X.

[p7]
kick   X... ..X. X... ..X.
snare  .... X... .... X...
clap   x... X... x... X...
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
hitom  .... .... ...X Xx..
lotom  X... ..X. X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
