name: FRENCH FILTER HOUSE 124
# House & disco. Tempo sugerido: 124 BPM.
# French house: bucle filtrado, hats en semicorcheas e baixo disco en oitavas.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    XxXx XxXx XxXx XxXx
hho    ..X. ..X. ..X. ..X.

[p1]
kick   X... .... .... ....
clap   .... X... .... X...
hhc    XxXx XxXx XxXx XxXx
hho    ..X. ..X. ..X. ..X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... X..x X... X...
clap   ...o X... ...o X...
hhc    XXXX XXXX XXXX XXXX
hho    ..X. ..X. ..X. ..X.
hitom  ..X. ..X. ..X. ..X.
lotom  X... X... X... X...

[p3]
kick   X... X..x X... XX..
clap   ...o X... ...o X...
hhc    XXXX XXXX XXXX XXXX
hho    ..X. ..X. ..X. ..X.
hitom  ..X. ..X. ..X. .XX.
lotom  X... X... X... X...

[p4]                         # BASE
kick   X... X... X... X...
clap   .... X... .... X...
hhc    XxXx XxXx XxXx XxXx
hho    ..X. ..X. ..X. ..X.
hitom  ..X. ..X. ..X. ..X.
lotom  X... X... X... X...

[p5]
kick   X... X... X... X...
clap   .... X... .... X...
hhc    XxXx XxXx XxXx XxXx
hho    ..X. ..X. ..X. ..X.
hitom  ..X. ..X. ..X. .XX.
lotom  X... X... X... X...

[p6]                         # VARIACION
kick   X... X... X... X...
clap   .... X... .... X...
hhc    XxXx XxXx XxXx XxXx
hho    ..X. ..X. ..X. ..X.
hitom  ..X. ..X. ..X. ..X.
lotom  X... X... X... X...

[p7]
kick   X... X... X... X...
clap   .... X... .... X...
hhc    XxXx XxXx XxXx XxXx
hho    ..X. ..X. ..X. ..X.
hitom  ..X. ..X. ..X. .XX.
lotom  X... X... X... X..o

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
