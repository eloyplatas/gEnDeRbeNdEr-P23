name: DETROIT TECHNO 128
# Techno. Tempo sugerido: 128 BPM.
# Techno de Detroit: catro no chan, palmas no 2 e 4, hats a contratempo, baixo funk.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    -.X. -.X. -.X. -.X.
hho    ..x. .... .... .x..

[p1]
kick   X... .... .... ....
clap   .... X... .... X...
hhc    -.X. -.X. -.X. -.X.
hho    ..x. .... .... .x..
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... X..x X... X...
snare  .... ...- .... ..-.
clap   ...o X... ...o X...
hhc    --X- --X- --X- --X-
hho    ..x. .... .... .xX.
hitom  .... .... ..x. ....
lotom  ..X. ..X. ..X. ..X.

[p3]
kick   X... X..x X... XX..
snare  .... ...- .... ..o.
clap   ...o X... ...o X...
hhc    --X- --X- --X- --X-
hho    ..x. .... .... .xX.
hitom  .... .... ..x. ....
lotom  ..X. ..X. .XX. ..X.

[p4]                         # BASE
kick   X... X... X... X...
snare  .... ...- .... ..-.
clap   .... X... .... X...
hhc    -.X. -.X. -.X. -.X.
hho    ..x. .... .... .x..
hitom  .... .... ..x. ....
lotom  ..X. ..X. ..X. ..X.

[p5]
kick   X... X... X... X...
snare  .... ...- .... ..o.
clap   .... X... .... X...
hhc    -.X. -.X. -.X. -.X.
hho    ..x. .... .... .x..
hitom  .... .... ..x. ....
lotom  ..X. ..X. .XX. ..X.

[p6]                         # VARIACION
kick   X... X... X... X...
snare  .... X... .... X...
clap   .... ...- .... ..-.
hhc    -.X. -... -... -...
hho    ..x. ..X. ..X. .xX.
hitom  .... .... ..x. ....
lotom  ..X. ..X. ..X. ..X.

[p7]
kick   X... X... X... X...
snare  .... X... .... X...
clap   .... ...- .... ..o.
hhc    -.X. -... -... -...
hho    ..x. ..X. ..X. .xX.
hitom  .... .... .Xx. Xx..
lotom  ..X. ..X. ..X. ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
