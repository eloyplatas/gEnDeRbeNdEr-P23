name: KRAUT FUNK 115
# IDM & experimental. Tempo sugerido: 115 BPM.
# Kraut funk (tipo Can): bateria funk en bucle hipnotico.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    XxXx XxXx XxXx XxXx

[p1]
kick   X... .... .... ....
snare  .... X... .... X...
hhc    XxXx XxXx XxXx XxXx
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ..Xx ..X. ....
snare  ...o X... ...o X..o
hhc    XXXX XXXX XXXX XXXX
hho    .... .... .... ..X.
lotom  X... ..X. ..X. ....

[p3]
kick   X... ..Xx ..X. .X..
snare  ...o X..o ...o X..o
hhc    XXXX XXXX XXXX XXXX
hho    .... .... .... ..X.
hitom  .... .... .... ..X.
lotom  X... ..X. ..X. .X..

[p4]                         # BASE
kick   X... ..X. ..X. ....
snare  .... X... .... X..o
hhc    XxXx XxXx XxXx XxXx
lotom  X... ..X. ..X. ....

[p5]
kick   X... ..X. ..X. .X..
snare  .... X..o .... X..o
hhc    XxXx XxXx XxXx XxXx
lotom  X... ..X. ..X. .X..

[p6]                         # VARIACION
kick   X... ..X. ..X. ....
snare  .... X... .... X..o
hhc    Xx.x Xx.x Xx.x Xx.x
hho    ..X. ..X. ..X. ..X.
lotom  X... ..X. ..X. ....

[p7]
kick   X... ..X. ..X. .X..
snare  .... X..o .... X..o
hhc    Xx.x Xx.x Xx.x Xx.x
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .... XX..
lotom  X... ..X. ..X. ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
