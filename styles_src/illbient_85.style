name: ILLBIENT 85
# Trip hop & downtempo. Tempo sugerido: 85 BPM.
# Illbient: hip hop ambiental, golpes espazados e sirenas (toms).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    x... x... -... x...

[p1]
kick   X... .... .... ....
snare  .... .... .... X...
hhc    x... -... x... x...
hho    ..X. .... .... ....
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x ..X. ....
snare  .... oX.. ...o X...
hhc    X-o- X-o- --o- X-o-
hho    .... .... .... ..X.
hitom  .... .... X... ....
lotom  X... .... ..X. ....

[p3]
kick   .... ..Xx .... .X..
snare  .... .... ...o X...
hhc    X-o- --o- X-o- X-o-
hho    ..X. .... .... ..X.
hitom  .... .... .... ..X.
lotom  X... ..X. .... ....

[p4]                         # BASE
kick   X... .... ..X. ....
snare  .... .X.. .... X...
hhc    x... x... -... x...
hitom  .... .... X... ....
lotom  X... .... ..X. ....

[p5]
kick   .... ..X. .... ....
snare  .... .... .... X...
hhc    x... -... x... x...
hho    ..X. .... .... ....
hitom  .... .... .... ..X.
lotom  X... ..X. .... ....

[p6]                         # VARIACION
kick   X... .... ..X. ....
snare  .... .X.. .... X...
hhc    x... x... -... x...
hitom  .... .... X... ....
lotom  X... .... ..X. ....

[p7]
kick   .... ..X. .... ....
snare  .... .... .... X...
hhc    x... -... x... x...
hho    ..X. .... .... ....
hitom  .... .... .... XxX.
lotom  X... ..X. .... ...o

[p8]                         # FILL
kick   X... .... .... ....
hhc    x... x... -... x...
hho    .... .... .... ..X.
hitom  .... .... .... x.X.
lotom  X... .... .... ....
