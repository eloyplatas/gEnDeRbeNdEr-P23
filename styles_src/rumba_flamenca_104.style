name: RUMBA FLAMENCA 104
# Iberia & Mediterranean. Tempo sugerido: 104 BPM.
# Rumba flamenca: rasgueo ventilador, cajon e palmas a contratempo.
# Voces: kick/snare=cajon · clap=palmas.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.x. X.x. X.x. X.x.

[p1]
kick   X... .... .... ....
snare  .... X... .... X...
clap   ..X. ..X. ..X. ..X.
hhc    X.x. X.x. X.x. X.x.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ..Xx X... ..X.
snare  ...o X... ...o X...
clap   .oX. .oX. .oX. .oX.
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
hitom  .... .... .... ..-.
lotom  X... ..X. X... ....

[p3]
kick   X... ..Xx X... .XX.
snare  ...o X..o ...o X.o.
clap   .oX. .oX. .oX. .oX.
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
hitom  .... .... ..-. ..x.
lotom  X... ..X. X... ..X.

[p4]                         # BASE
kick   X... ..X. X... ..X.
snare  .... X... .... X...
clap   ..X. ..X. ..X. ..X.
hhc    X.x. X.x. X.x. X.x.
hitom  .... .... .... ..-.
lotom  X... ..X. X... ....

[p5]
kick   X... ..X. X... ..X.
snare  .... X..o .... X.o.
clap   ..X. ..X. ..X. ..X.
hhc    X.x. X.x. X.x. X.x.
hitom  .... .... ..-. ..x.
lotom  X... ..X. X... ..x.

[p6]                         # VARIACION
kick   X... ..X. X... ..X.
snare  ..X. ..X. ..X. ..X.
clap   .... X... .... X...
hhc    X... X... X... X...
hho    ..x. ..x. ..x. ..x.
hitom  .... .... .... ..-.
lotom  X... ..X. X... ....

[p7]
kick   X... ..X. X... ..X.
snare  ..X. ..X. ..X. ..X.
clap   .... X..o .... X.o.
hhc    X... X... X... X...
hho    ..x. ..x. ..x. ..x.
hitom  .... .... ..-. Xxx.
lotom  X... ..X. X... ..xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
