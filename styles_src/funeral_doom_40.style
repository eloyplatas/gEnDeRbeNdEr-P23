name: FUNERAL DOOM 40
# Metal. Tempo sugerido: 40 BPM.
# Funeral doom: un golpe por compas, caixa no 3 e pratos abertos.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hho    X... .... .... ....

[p1]
kick   X... .... .... ....
snare  .... .... X... ....
hho    X... .... X... ....
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x .... ....
snare  .... ...o X... ....
hho    X... .... .... ....
lotom  X... .... .... ....

[p3]
kick   X... ...x .... .X..
snare  .... ...o X... ....
hho    X... .... X... ....
hitom  .... .... .... ..X.
lotom  X... .... .... ....

[p4]                         # BASE
kick   X... .... .... ....
snare  .... .... X... ....
hho    X... .... .... ....
lotom  X... .... .... ....

[p5]
kick   X... .... .... ....
snare  .... .... X... ....
hho    X... .... X... ....
lotom  X... .... .... ....

[p6]                         # VARIACION
kick   X... .... .... ....
snare  .... .... X... ....
hho    X... .... .... ....
lotom  X... .... .... ....

[p7]
kick   X... .... .... ....
snare  .... .... X... ....
hho    X... .... X... ....
hitom  .... .... .... Xx..
lotom  X... .... .... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
hho    .... .... .... ..X.
hitom  .... .... .... x.X.
lotom  X... .... .... ....
