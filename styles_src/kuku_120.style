name: KUKU 120
# African traditional. Tempo sugerido: 120 BPM.
# Kuku (Guinea, Manding): ritmo de festa de mulleres.
# Voces: kick=dundunba · lotom=sangban · hitom=kenkeni · snare=slap de djembe · clap=ton de djembe
# hhc=campa (kenken) · hho=shekere. No canal BASS os dununs soan como baixo.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X... X... X... X...

[p1]
kick   X... .... .... ....
snare  X..X .X.. X..X .XX.
clap   ..X. .... X... ....
hhc    X... X... X... X...
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ..Xx ..X. ....
snare  X.oX oX.o X.oX oX..
clap   .oX. ...o X... ....
hhc    X-o- X-o- X-o- X-o-
hho    .... .... .... ..X.
hitom  X.X. X.X. X.X. X.X.
lotom  ..X. X... .... X.X.

[p3]
kick   X... ..Xx ..X. .X..
snare  X.oX oX.o X.oX oXX.
clap   .oX. ...o X... ....
hhc    X-o- X-o- X-o- X-o-
hho    .... .... .... ..X.
hitom  X.X. X.X. X.X. X.X.
lotom  ..X. X... .... X.X.

[p4]                         # BASE
kick   X... ..X. ..X. ....
snare  X..X .X.. X..X .X..
clap   ..X. .... X... ....
hhc    X... X... X... X...
hitom  X.X. X.X. X.X. X.X.
lotom  ..X. X... .... X.X.

[p5]
kick   X... ..X. ..X. ....
snare  X..X .X.. X..X .XX.
clap   ..X. .... X... ....
hhc    X... X... X... X...
hitom  X.X. X.X. X.X. X.X.
lotom  ..X. X... .... X.X.

[p6]                         # VARIACION
kick   X... ..X. ..X. ....
snare  ..X. .... X... ....
clap   X..X .X.. X..X .X..
hhc    X... X... X... X...
hitom  X.X. X.X. X.X. X.X.
lotom  ..X. X... .... X.X.

[p7]
kick   X... ..X. ..X. ....
snare  ..X. .... X... ....
clap   X..X .X.. X..X .XX.
hhc    X... X... X... X...
hitom  X.X. X.X. X.X. XxX.
lotom  ..X. X... .... X.Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
