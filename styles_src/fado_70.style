name: FADO 70
# European folk. Tempo sugerido: 70 BPM.
# Fado (Portugal): sen bateria; o baixo e a guitarra marcan o 1 e o 3 e os contratempos.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
clap   ..x. ..x. ..x. ..x.

[p1]
kick   X... .... .... ....
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x X... ....
clap   ..x. ..x. ..x. ..x.
lotom  X... .... X... ....

[p3]
kick   X... ...x X... .X..
clap   ..x. ..x. ..x. ..x.
hitom  .... .... .... ..X.
lotom  X... X... X... ....

[p4]                         # BASE
kick   X... .... X... ....
clap   ..x. ..x. ..x. ..x.
lotom  X... .... X... ....

[p5]
kick   X... .... X... ....
clap   ..x. ..x. ..x. ..x.
lotom  X... X... X... ....

[p6]                         # VARIACION
kick   X... .... X... ....
clap   ..x. ..x. ..x. ..x.
lotom  X... .... X... ....

[p7]
kick   X... .... X... ....
clap   ..x. ..x. ..x. ..x.
hitom  .... .... .... Xx..
lotom  X... X... X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
hho    .... .... .... ..X.
hitom  .... .... .... x.X.
lotom  X... .... .... ....
