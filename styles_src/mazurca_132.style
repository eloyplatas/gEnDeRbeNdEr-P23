name: MAZURCA 132
meter: 3/4
# Galicia. Tempo sugerido: 132 BPM (negras; compas 3/4).
# Mazurca, 3/4: corchea con punto e semicorchea no primeiro pulso, acento no segundo.
# Voces: kick=bombo · snare=tamboril/caixa · clap=pel da pandeireta, cunchas ou palmas
# hhc=ferrenas (pandeireta) · hho=xiro/arrastre de ferrenas · lotom/hitom=baixo (ronco, bordon).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X... X... X...
hho    .... .... x...

[p1]
kick   X... .... ....
snare  X... .... ....
clap   .... X... X...
hhc    X... X... X...
hho    .... .... x...
lotom  X... .... ....

[p2]                         # ENERGIA
kick   X... .x.. ....
snare  X..x .... ....
clap   ...o X... ....
hhc    X-o- X-o- X-o-
hho    .... .... x.X.
hitom  .... x... ....
lotom  X... .... X...

[p3]
kick   X... .x.. .X..
snare  X..x .... ....
clap   ...o X..o X...
hhc    X-o- X-o- X-o-
hho    .... .... x.X.
hitom  .... x... ..X.
lotom  X... .... X...

[p4]                         # BASE
kick   X... .... ....
snare  X..x .... ....
clap   .... X... ....
hhc    X... X... X...
hho    .... .... x...
hitom  .... x... ....
lotom  X... .... X...

[p5]
kick   X... .... ....
snare  X..x .... ....
clap   .... X... X...
hhc    X... X... X...
hho    .... .... x...
hitom  .... x... ....
lotom  X... .... X...

[p6]                         # VARIACION
kick   X... .... ....
snare  .... X... ....
clap   X..x .... ....
hhc    X... X... X...
hho    .... .... x...
hitom  .... x... ....
lotom  X... .... X...

[p7]
kick   X... .... ....
snare  .... X... X...
clap   X..x .... ....
hhc    X... X... X...
hho    .... .... x...
hitom  .... x... .x..
lotom  X... .... X.Xo

[p8]                         # FILL
kick   X... X... X...
snare  .... .... ooxX
clap   .... .... ...X
hhc    X... X... X...
hho    X... .... ....
hitom  .... Xx.. ....
lotom  .... ..Xx ....
