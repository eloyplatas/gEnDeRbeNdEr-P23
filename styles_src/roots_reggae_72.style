name: ROOTS REGGAE 72
# Reggae, dub & rocksteady. Tempo sugerido: 72 BPM.
# Roots reggae: one drop con aro (cross-stick) no 3 e hats con adornos.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.xX X.xX X.xX X.xX

[p1]
kick   X... .... .... ....
snare  .... .... X... ....
hhc    X.xX X.xX X.xX X.xX
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   .... ...x X... ....
snare  .... ...o X... ....
clap   .... -... .... -...
hhc    X-XX X-XX X-XX X-XX
hho    .... .... .... ..X.
lotom  X... ..X. ..X. ....

[p3]
kick   .... ...x X... .X..
snare  .... ...o X... o.o.
clap   .... -... .... -...
hhc    X-XX X-XX X-XX X-XX
hho    .... .... .... ..X.
hitom  .... .... ...x ..X.
lotom  X... ..X. ..X. .X..

[p4]                         # BASE
kick   .... .... X... ....
snare  .... .... X... ....
clap   .... -... .... -...
hhc    X.xX X.xX X.xX X.xX
lotom  X... ..X. ..X. ....

[p5]
kick   .... .... X... ....
snare  .... .... X... o.o.
clap   .... -... .... -...
hhc    X.xX X.xX X.xX X.xX
hitom  .... .... ...x ....
lotom  X... ..X. ..X. .X..

[p6]                         # VARIACION
kick   .... .... X... ....
snare  .... -... .... -...
clap   .... .... X... ....
hhc    X..X X..X X..X X..X
hho    ..x. ..x. ..x. ..x.
lotom  X... ..X. ..X. ....

[p7]
kick   .... .... X... ....
snare  .... -... .... -...
clap   .... .... X... o.o.
hhc    X..X X..X X..X X..X
hho    ..x. ..x. ..x. ..x.
hitom  .... .... ...x XX..
lotom  X... ..X. ..X. ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
