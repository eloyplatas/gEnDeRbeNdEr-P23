name: JAZZ BALLAD BRUSHES 70
# Jazz & blues. Tempo sugerido: 70 BPM.
# Balada con vasoiras: barrido continuo (hhc) e acentos no 2 e 4.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    Xxxx Xxxx Xxxx Xxxx
hho    .... X... .... X...

[p1]
kick   X... .... .... ....
snare  .... X... .... X...
hhc    Xxxx Xxxx Xxxx Xxxx
hho    .... X... .... X...
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x -... ....
snare  ...o X... ...o X...
hhc    XXXX XXXX XXXX XXXX
hho    .... X... .... X.X.
lotom  X... .... X... ....

[p3]
kick   X... ...x -... .X..
snare  ...o X... ...o X...
hhc    XXXX XXXX XXXX XXXX
hho    .... X... .... X.X.
hitom  .... .... .... ..X.
lotom  X... .... X... ....

[p4]                         # BASE
kick   X... .... -... ....
snare  .... X... .... X...
hhc    Xxxx Xxxx Xxxx Xxxx
hho    .... X... .... X...
lotom  X... .... X... ....

[p5]
kick   X... .... -... ....
snare  .... X... .... X...
hhc    Xxxx Xxxx Xxxx Xxxx
hho    .... X... .... X...
lotom  X... .... X... ....

[p6]                         # VARIACION
kick   X... .... -... ....
snare  .... X... .... X...
hhc    Xx.x Xx.x Xx.x Xx.x
hho    ..x. X.x. ..x. X.x.
lotom  X... .... X... ....

[p7]
kick   X... .... -... ....
snare  .... X... .... X...
hhc    Xx.x Xx.x Xx.x Xx.x
hho    ..x. X.x. ..x. X.x.
hitom  .... .... .... Xx..
lotom  X... .... X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
hhc    Xxxx Xxxx Xxxx Xxxx
hho    .... .... .... ..X.
hitom  .... .... .... x.X.
lotom  X... .... .... ....
