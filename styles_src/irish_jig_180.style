name: IRISH JIG 180
meter: 6/8
# European folk. Tempo sugerido: 180 BPM (negras; compas 6/8).
# Jig irlandes, 6/8 (negra con punto = 120): bodhran en corcheas con acento nos pulsos.
# Voces (bodhran): kick=golpe grave · snare=parte alta/aro · hhc=punta da baqueta.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X.X. X.X.X.

[p1]
kick   X..... ......
snare  ...... ...X..
hhc    X.X.X. X.X.X.
lotom  X..... ......

[p2]                         # ENERGIA
kick   X....x X.....
snare  ..x.x. ..x.x.
hhc    X-X-X- X-X-X-
hho    ...... ....X.
lotom  X..... X.....

[p3]
kick   X....x X..X..
snare  ..x.x. ..xXx.
hhc    X-X-X- X-X-X-
hho    ...... ....X.
hitom  ...... ....X.
lotom  X..... X.....

[p4]                         # BASE
kick   X..... X.....
snare  ..x.x. ..x.x.
hhc    X.X.X. X.X.X.
lotom  X..... X.....

[p5]
kick   X..... X.....
snare  ..x.x. ..xXx.
hhc    X.X.X. X.X.X.
lotom  X..... X.....

[p6]                         # VARIACION
kick   X..... X.....
snare  ..x.x. ..x.x.
hhc    X.X... X.X...
hho    ....X. ....X.
lotom  X..... X.....

[p7]
kick   X..... X.....
snare  ..x.x. ..xXx.
hhc    X.X... X.X...
hho    ....X. ....X.
hitom  ...... ..Xx..
lotom  X..... X...Xo

[p8]                         # FILL
kick   X..... X.....
snare  ...... ooxxXX
clap   ...... .....X
hhc    X.X.X. X.X.X.
hho    X..... ......
hitom  XxX... ......
lotom  ...xXx ......
