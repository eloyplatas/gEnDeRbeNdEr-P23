name: BASSLINE 136
# House & disco. Tempo sugerido: 136 BPM.
# Bassline (niche de Sheffield): baixo en semicorcheas que salta e caixa con salto.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    ..X. ..X. ..X. ..X.

[p1]
kick   X... .... .... ....
snare  .... X..X .... X.X.
hhc    ..X. ..X. ..X. ..X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... X..x X... X...
snare  ...o X.oX ...o X...
hhc    o-X- o-X- o-X- o-X-
hho    .... .... .... ..X.
hitom  ...X .... ..X. ....
lotom  X.XX .X.X X.XX .X.X

[p3]
kick   X... X..x X... XX..
snare  ...o X.oX ...o XoX.
hhc    o-X- o-X- o-X- o-X-
hho    .... .... .... ..X.
hitom  ...X .... ..X. ..X.
lotom  X.XX .X.X X.X. XX.X

[p4]                         # BASE
kick   X... X... X... X...
snare  .... X..X .... X...
hhc    ..X. ..X. ..X. ..X.
hitom  ...X .... ..X. ....
lotom  X.XX .X.X X.XX .X.X

[p5]
kick   X... X... X... X...
snare  .... X..X .... X.X.
hhc    ..X. ..X. ..X. ..X.
hitom  ...X .... ..X. ....
lotom  X.XX .X.X X.X. XX.X

[p6]                         # VARIACION
kick   X... X... X... X...
snare  .... X..X .... X...
hho    ..X. ..X. ..X. ..X.
hitom  ...X .... ..XX .X.X
lotom  X.XX .X.X X.X. ....

[p7]
kick   X... X... X... X...
snare  .... X..X .... X.X.
hho    ..X. ..X. ..X. ..X.
hitom  ...X .... ..X. .X.X
lotom  X.XX .X.X X.X. X.X.

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
