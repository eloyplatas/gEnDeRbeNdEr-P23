name: ALEGRIAS 130
meter: 6/8
# Flamenco. Tempo sugerido: 130 BPM (negras; compas 6/8).
# Alegrias (cantinas de Cadiz): mesmo compas ca a solea, maior e mais viva.
# Compas de 12 tempos en dous compases de 6/8 (cada tempo = unha corchea; o tempo do nome e a negra).
# Voces: clap=palmas claras · snare=palmas sordas ou cajon agudo · kick=cajon grave · hhc=nudillos/pitos.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X.X. X.X.X.

[p1]
kick   X..... ......
clap   ..X... X...X.
hhc    X.X.X. X.X.X.
lotom  X..... ......

[p2]                         # ENERGIA
kick   X...Xx ....X.
snare  ..x... ..x...
clap   x.xoX. x.xoX.
hhc    X-X-X- X-X-X-
hho    ...... ....X.
lotom  ....X. ....X.

[p3]
kick   ..X..x X..XX.
snare  x...x. ..x...
clap   xoX.xo X.xoX.
hhc    X-X-X- X-X-X-
hho    ...... ....X.
lotom  ..X... X...X.

[p4]                         # BASE
kick   X...X. ....X.
snare  ..x... ..x...
clap   x.x.X. x.x.X.
hhc    X.X.X. X.X.X.
lotom  ....X. ....X.

[p5]
kick   ..X... X...X.
snare  x...x. ..x...
clap   x.X.x. X.x.X.
hhc    X.X.X. X.X.X.
lotom  ..X... X...X.

[p6]                         # VARIACION
kick   X...X. ....X.
snare  x.x.X. x.x.X.
clap   ..x... ..x...
hhc    X.X... X.X...
hho    ....X. ....X.
lotom  ....X. ....X.

[p7]
kick   ..X... X...X.
snare  x.X.x. X.x.X.
clap   x...x. ..x...
hhc    X.X... X.X...
hho    ....X. ....X.
hitom  ...... ..Xx..
lotom  ..X... X...Xo

[p8]                         # FILL
kick   X..... X.....
snare  ...... ooxxXX
clap   ...... .....X
hhc    X.X.X. X.X.X.
hho    X..... ......
hitom  XxX... ......
lotom  ...xXx ......
