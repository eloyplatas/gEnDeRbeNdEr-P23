name: SOUL BALLAD 90
meter: 6/8
# Soul & funk. Tempo sugerido: 90 BPM (negras; compas 6/8).
# Balada soul / doo-wop en 12/8 (escrita como 6/8): tresillos e caixa no 2 e 4.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.x.x. X.x.x.

[p1]
kick   X..... ......
snare  ...... X.....
hhc    X.x.x. X.x.x.
lotom  X..... ......

[p2]                         # ENERGIA
kick   X....x ....x.
snare  .....o X.....
hhc    X-X-X- X-X-X-
hho    ...... ....X.
lotom  X..... X.....

[p3]
kick   X....x ...Xx.
snare  .....o X.....
hhc    X-X-X- X-X-X-
hho    ...... ....X.
hitom  ...... ....X.
lotom  X..... X.....

[p4]                         # BASE
kick   X..... ....x.
snare  ...... X.....
hhc    X.x.x. X.x.x.
lotom  X..... X.....

[p5]
kick   X..... ....x.
snare  ...... X.....
hhc    X.x.x. X.x.x.
lotom  X..... X.....

[p6]                         # VARIACION
kick   X..... ....x.
snare  ...... X.....
hhc    X.x... X.x...
hho    ....x. ....x.
lotom  X..... X.....

[p7]
kick   X..... ....x.
snare  ...... X.....
hhc    X.x... X.x...
hho    ....x. ....x.
hitom  ...... ..Xx..
lotom  X..... X...Xo

[p8]                         # FILL
kick   X..... ......
hhc    X.x.x. X.x.x.
hho    ...... ....X.
hitom  ...... ..x.X.
lotom  X..... ......
