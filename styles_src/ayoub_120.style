name: AYOUB 120
# Iberia & Mediterranean. Tempo sugerido: 120 BPM.
# Ayoub (zar), 2/4: D . . k D . T . — hipnotico, de transo.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.x. X.x. X.x. X.x.

[p1]
kick   X... .... .... ....
snare  .... ..X. .... ..X.
hhc    X.x. X.x. X.x. X.x.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... X..x X... X...
snare  ...x .oX. ...x .oX.
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
lotom  X... X... X... X...

[p3]
kick   X... X..x X... XX..
snare  ...x .oX. ...x .oX.
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
hitom  .... .... .... ..X.
lotom  X... X... X... X...

[p4]                         # BASE
kick   X... X... X... X...
snare  ...x ..X. ...x ..X.
hhc    X.x. X.x. X.x. X.x.
lotom  X... X... X... X...

[p5]
kick   X... X... X... X...
snare  ...x ..X. ...x ..X.
hhc    X.x. X.x. X.x. X.x.
lotom  X... X... X... X...

[p6]                         # VARIACION
kick   X... X... X... X...
snare  ...x ..X. ...x ..X.
hhc    X... X... X... X...
hho    ..x. ..x. ..x. ..x.
lotom  X... X... X... X...

[p7]
kick   X... X... X... X...
snare  ...x ..X. ...x ..X.
hhc    X... X... X... X...
hho    ..x. ..x. ..x. ..x.
hitom  .... .... .... .x..
lotom  X... X... X... X.Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
