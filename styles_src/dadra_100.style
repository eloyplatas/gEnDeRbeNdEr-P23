name: DADRA 100
meter: 6/8
# Asia & Middle East. Tempo sugerido: 100 BPM (negras; compas 6/8).
# Dadra (tabla, 6/8): dha dhin na | dha tin na.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
clap   X..... ......

[p1]
kick   X..... ......
snare  X.X.X. X.X.X.
clap   X..... ......
lotom  X..... ......

[p2]                         # ENERGIA
kick   X.X..x ......
snare  XoXoXo XoXoX.
clap   X..... ......
lotom  X.X... X.....

[p3]
kick   X.X..x ...X..
snare  XoXoXo XoXoX.
clap   X..... ......
hitom  ...... ....X.
lotom  X.X... ......

[p4]                         # BASE
kick   X.X... ......
snare  X.X.X. X.X.X.
clap   X..... ......
lotom  X.X... X.....

[p5]
kick   X.X... ......
snare  X.X.X. X.X.X.
clap   X..... ......
lotom  X.X... ......

[p6]                         # VARIACION
kick   X.X... ......
snare  X..... ......
clap   X.X.X. X.X.X.
lotom  X.X... X.....

[p7]
kick   X.X... ......
snare  X..... ......
clap   X.X.X. X.X.X.
hitom  ...... ..Xx..
lotom  X.X... ....Xo

[p8]                         # FILL
kick   X..... X.....
snare  ...... ooxxXX
clap   ...... .....X
hho    X..... ......
hitom  XxX... ......
lotom  ...xXx ......
