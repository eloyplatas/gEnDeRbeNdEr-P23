name: DUB 70
# Reggae, dub & rocksteady. Tempo sugerido: 70 BPM.
# Dub: one drop espido, ecos de caixa (hho) e baixo moi presente.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X... X... X... X...

[p1]
kick   X... .... .... ....
hhc    X... X... X... X...
hho    .... .... X... ..X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   .... ...x X... ....
snare  .... ...o X... ....
hhc    X-o- X-o- X-o- X-o-
hho    .... .... .... ..X.
lotom  X... ..X. ..X. X...

[p3]
kick   .... ...x X... .X..
hhc    X-o- X-o- X-o- X-o-
hho    .... .... X... ..X.
hitom  .... .... ..X. ..X.
lotom  X... ..X. .... ....

[p4]                         # BASE
kick   .... .... X... ....
snare  .... .... X... ....
hhc    X... X... X... X...
lotom  X... ..X. ..X. X...

[p5]
kick   .... .... X... ....
hhc    X... X... X... X...
hho    .... .... X... ..X.
hitom  .... .... ..X. ....
lotom  X... ..X. .... ....

[p6]                         # VARIACION
kick   .... .... X... ....
snare  .... .... X... ....
hhc    X... X... X... X...
lotom  X... ..X. ..X. X...

[p7]
kick   .... .... X... ....
hhc    X... X... X... X...
hho    .... .... X... ..X.
hitom  .... .... ..X. Xx..
lotom  X... ..X. .... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
hhc    X... X... X... X...
hho    .... .... .... ..X.
hitom  .... .... .... x.X.
lotom  X... .... .... ....
