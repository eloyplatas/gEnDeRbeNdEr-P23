name: PASARRUAS 108
# Galicia. Tempo sugerido: 108 BPM.
# Pasarruas, 2/4: marcha de gaiteiros pola rua, caixa sen parar.
# Voces: kick=bombo · snare=tamboril/caixa · clap=pel da pandeireta, cunchas ou palmas
# hhc=ferrenas (pandeireta) · hho=xiro/arrastre de ferrenas · lotom/hitom=baixo (ronco, bordon).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X... .... X... ....

[p1]
kick   X... .... .... ....
snare  X... X... X... XXXX
hhc    X... .... X... ....
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x X... ....
snare  X.oo X.oo X.oo XoXX
hhc    X-o- o-o- X-o- o-o-
hho    .... .... .... ..X.
lotom  X... X... X... X...

[p3]
kick   X... ...x X... .X..
snare  X.oo X.oo X.oo XXXX
hhc    X-o- o-o- X-o- o-o-
hho    .... .... .... ..X.
hitom  .... .... .... x.X.
lotom  X... X... X... X...

[p4]                         # BASE
kick   X... .... X... ....
snare  X.o. X.o. X.o. X.XX
hhc    X... .... X... ....
lotom  X... X... X... X...

[p5]
kick   X... .... X... ....
snare  X.o. X.o. X.oo XXXX
hhc    X... .... X... ....
hitom  .... .... .... x...
lotom  X... X... X... X...

[p6]                         # VARIACION
kick   X... .... X... ....
snare  X.o. X.o. X.o. X.XX
hhc    X... .... X... ....
lotom  X... X... X... X...

[p7]
kick   X... .... X... ....
snare  X.o. X.o. X.oo XXXX
hhc    X... .... X... ....
hitom  .... .... .... xx..
lotom  X... X... X... X.Xo

[p8]                         # FILL
kick   X... X... X... X...
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X... .... X... ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
