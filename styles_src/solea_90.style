name: SOLEA 90
meter: 6/8
# Flamenco. Tempo sugerido: 90 BPM (negras; compas 6/8).
# Solea: acentos no 3, 6, 8, 10 e 12. Lenta e grave.
# Compas de 12 tempos en dous compases de 6/8 (cada tempo = unha corchea; o tempo do nome e a negra).
# Voces: clap=palmas claras · snare=palmas sordas ou cajon agudo · kick=cajon grave · hhc=nudillos/pitos.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
clap   x.x.X. x.x.X.

[p1]
kick   X..... ......
clap   ..X... X...X.
lotom  X..... ......

[p2]                         # ENERGIA
kick   ....Xx ....X.
snare  -.-.-. -.-.-.
clap   x.xoX. x.xoX.
lotom  ....X. ....X.

[p3]
kick   ..X..x X..XX.
snare  -.-.-. -.-.-.
clap   xoX.xo X.xoX.
lotom  ..X... X...X.

[p4]                         # BASE
kick   ....X. ....X.
snare  -.-.-. -.-.-.
clap   x.x.X. x.x.X.
lotom  ....X. ....X.

[p5]
kick   ..X... X...X.
snare  -.-.-. -.-.-.
clap   x.X.x. X.x.X.
lotom  ..X... X...X.

[p6]                         # VARIACION
kick   ....X. ....X.
snare  x.x.X. x.x.X.
clap   -.-.-. -.-.-.
lotom  ....X. ....X.

[p7]
kick   ..X... X...X.
snare  x.X.x. X.x.X.
clap   -.-.-. -.-.-.
hitom  ...... ..Xx..
lotom  ..X... X...Xo

[p8]                         # FILL
kick   X..... ......
hho    ...... ....X.
hitom  ...... ..x.X.
lotom  X..... ......
