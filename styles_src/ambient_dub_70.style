name: AMBIENT DUB 70
# Ambient. Tempo sugerido: 70 BPM.
# Ambient dub: bombo espazado, caixa con eco (hho) e baixo profundo.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hho    .... .... ..X. ..X.

[p1]
kick   X... .... .... ....
snare  .... .... X... ....
hho    .... .... ..X. ....
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x ..X. ....
snare  .... ...o X... ....
hho    .... .... ..X. ..X.
lotom  X... ..X. .... ....

[p3]
kick   X... ...x .... .X..
snare  .... ...o X... ....
hho    .... .... ..X. ....
hitom  .... .... .... ..X.
lotom  X... ..X. ..X. ....

[p4]                         # BASE
kick   X... .... ..X. ....
snare  .... .... X... ....
hho    .... .... ..X. ..X.
lotom  X... ..X. .... ....

[p5]
kick   X... .... .... ....
snare  .... .... X... ....
hho    .... .... ..X. ....
lotom  X... ..X. ..X. ....

[p6]                         # VARIACION
kick   X... .... ..X. ....
snare  .... .... X... ....
hho    .... .... ..X. ..X.
lotom  X... ..X. .... ....

[p7]
kick   X... .... .... ....
snare  .... .... X... ....
hho    .... .... ..X. ....
hitom  .... .... .... Xx..
lotom  X... ..X. ..X. ..Xo

[p8]                         # FILL
kick   X... .... .... ....
hho    .... .... .... ..X.
hitom  .... .... .... x.X.
lotom  X... .... .... ....
