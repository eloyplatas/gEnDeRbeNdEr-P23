name: SEVILLANAS 180
meter: 3/4
# Iberia & Mediterranean. Tempo sugerido: 180 BPM (negras; compas 3/4).
# Sevillanas, 3/4: palmas nos tres pulsos, cajon e castanuelas con redobres.
# Voces: kick/snare=cajon · clap=palmas · hhc=castanuelas.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.-x X.-x X.x.

[p1]
kick   X... .... ....
snare  .... X... X...
clap   X... X... X...
hhc    X.-x X.-x X.x.
lotom  X... .... ....

[p2]                         # ENERGIA
kick   X... .x.. ....
snare  ...o X... ....
clap   X..o X..o X...
hhc    X--X X--X X-X-
hho    .... .... ..X.
hitom  .... -... -...
lotom  X... .... ....

[p3]
kick   X... .x.. XX..
snare  ...o X..o X...
clap   X..o X..o X...
hhc    X--X X--X X-X-
hho    .... .... ..X.
hitom  .... -... -.X.
lotom  X... .... ....

[p4]                         # BASE
kick   X... .... ....
snare  .... X... ....
clap   X... X... X...
hhc    X.-x X.-x X.x.
hitom  .... -... -...
lotom  X... .... ....

[p5]
kick   X... .... X...
snare  .... X... X...
clap   X... X... X...
hhc    X.-x X.-x X.x.
hitom  .... -... -...
lotom  X... .... ....

[p6]                         # VARIACION
kick   X... .... ....
snare  X... X... X...
clap   .... X... ....
hhc    X..x X..x X...
hho    ..-. ..-. ..x.
hitom  .... -... -...
lotom  X... .... ....

[p7]
kick   X... .... X...
snare  X... X... X...
clap   .... X... X...
hhc    X..x X..x X...
hho    ..-. ..-. ..x.
hitom  .... -... -x..
lotom  X... .... ..Xo

[p8]                         # FILL
kick   X... X... X...
snare  .... .... ooxX
clap   .... .... ...X
hhc    X.-x X.-x X.x.
hho    X... .... ....
hitom  .... Xx.. ....
lotom  .... ..Xx ....
