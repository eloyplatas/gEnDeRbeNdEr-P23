name: VALSE 160
meter: 3/4
# Galicia. Tempo sugerido: 160 BPM (negras; compas 3/4).
# Valse, 3/4: um-pa-pa.
# Voces: kick=bombo · snare=tamboril/caixa · clap=pel da pandeireta, cunchas ou palmas
# hhc=ferrenas (pandeireta) · hho=xiro/arrastre de ferrenas · lotom/hitom=baixo (ronco, bordon).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    .... X... X...

[p1]
kick   X... .... ....
clap   .... X... X...
hhc    .... X... X...
hho    .... .... x...
lotom  X... .... ....

[p2]                         # ENERGIA
kick   X... .x.. ....
clap   ...o X..o X...
hhc    o-o- X-o- X-o-
hho    .... .... ..X.
hitom  .... x... x...
lotom  X... .... ....

[p3]
kick   X... .x.. .X..
snare  .... .... ..oo
clap   ...o X..o X...
hhc    o-o- X-o- X-o-
hho    .... .... x.X.
hitom  .... x... x.X.
lotom  X... .... X...

[p4]                         # BASE
kick   X... .... ....
clap   .... X... X...
hhc    .... X... X...
hitom  .... x... x...
lotom  X... .... ....

[p5]
kick   X... .... ....
snare  .... .... ..oo
clap   .... X... X...
hhc    .... X... X...
hho    .... .... x...
hitom  .... x... x...
lotom  X... .... X...

[p6]                         # VARIACION
kick   X... .... ....
clap   .... X... X...
hhc    .... X... X...
hitom  .... x... x...
lotom  X... .... ....

[p7]
kick   X... .... ....
snare  .... X... X...
clap   .... .... ..oo
hhc    .... X... X...
hho    .... .... x...
hitom  .... x... xx..
lotom  X... .... X.Xo

[p8]                         # FILL
kick   X... X... X...
snare  .... .... ooxX
clap   .... .... ...X
hhc    .... X... X...
hho    X... .... ....
hitom  .... Xx.. ....
lotom  .... ..Xx ....
