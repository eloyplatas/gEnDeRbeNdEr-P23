name: PSYTRANCE 145
# Trance & hard dance. Tempo sugerido: 145 BPM.
# Psytrance: baixo rodando nas tres semicorcheas despois de cada bombo.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    ..X. ..X. ..X. ..X.

[p1]
kick   X... .... .... ....
clap   .... .... .... X...
hhc    ..X. ..X. ..X. ..X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... X..x X... X...
snare  .... ...- .... ..-.
clap   .... -... ...o X...
hhc    o-X- o-X- o-X- o-X-
hho    .... .... .... ..X.
lotom  .XXX .XXX .XXX .XXX

[p3]
kick   X... X..x X... XX..
snare  .... -..- .... -.x.
clap   .... -... ...o X...
hhc    o-X- o-X- o-X- o-X-
hho    .... .... .... ..X.
lotom  .XXX .XXX .XXX .XXX

[p4]                         # BASE
kick   X... X... X... X...
snare  .... ...- .... ..-.
clap   .... -... .... X...
hhc    ..X. ..X. ..X. ..X.
lotom  .XXX .XXX .XXX .XXX

[p5]
kick   X... X... X... X...
snare  .... -..- .... -.x.
clap   .... -... .... X...
hhc    ..X. ..X. ..X. ..X.
lotom  .XXX .XXX .XXX .XXX

[p6]                         # VARIACION
kick   X... X... X... X...
snare  .... -... .... X...
clap   .... ...- .... ..-.
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .X.X .X.X
lotom  .XXX .XXX ..X. ..X.

[p7]
kick   X... X... X... X...
snare  .... -... .... X...
clap   .... -..- .... -.x.
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .X.X XX.X
lotom  .XXX .XXX ..X. ..X.

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
