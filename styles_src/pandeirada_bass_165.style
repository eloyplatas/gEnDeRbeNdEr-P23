name: PANDEIRADA BASS 165
meter: 6/8
# Galicia. Tempo sugerido: 165 BPM (negras; compas 6/8).
# Fusion: pandeirada en 6/8 con bombo sincopado de trap e ferrenas con adornos.
# Voces: kick=bombo · snare=tamboril/caixa · clap=pel da pandeireta, cunchas ou palmas
# hhc=ferrenas (pandeireta) · hho=xiro/arrastre de ferrenas · lotom/hitom=baixo (ronco, bordon).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.XxX. X.XxX.
hho    ...... ....X.

[p1]
kick   X..... ......
clap   ...... X.....
hhc    X.XxX. X.XxX.
hho    ...... ....X.
lotom  X..... ......

[p2]                         # ENERGIA
kick   X....x X...X.
snare  ...... ..o.oo
clap   .....o X.....
hhc    X-XXX- X-XXX-
hho    ...... ....X.
hitom  ...... ....x.
lotom  X..... ..X...

[p3]
kick   X....x X.XXX.
snare  ...... ..o.oo
clap   .....o X.....
hhc    X-XXX- X-XXX-
hho    ...... ....X.
hitom  ...... x...X.
lotom  X...X. ..X...

[p4]                         # BASE
kick   X..... X...X.
snare  ...... ..o.oo
clap   ...... X.....
hhc    X.XxX. X.XxX.
hho    ...... ....X.
hitom  ...... ....x.
lotom  X..... ..X...

[p5]
kick   X..... X.X.X.
snare  ...... ..o.oo
clap   ...... X.....
hhc    X.XxX. X.XxX.
hho    ...... ....X.
hitom  ...... x.....
lotom  X...X. ..X...

[p6]                         # VARIACION
kick   X..... X...X.
snare  ...... X.....
clap   ...... ..o.oo
hhc    X.Xx.. X.XxX.
hho    ....X. ....X.
hitom  ...... ....x.
lotom  X..... ..X...

[p7]
kick   X..... X.X.X.
snare  ...... X.....
clap   ...... ..o.oo
hhc    X.Xx.. X.XxX.
hho    ....X. ....X.
hitom  ...... x..x..
lotom  X...X. ..X.Xo

[p8]                         # FILL
kick   X..... ......
snare  ...... ooxxXX
clap   ...... .....X
hhc    X.X.X. ......
hho    X..... ......
hitom  XxX... ......
lotom  ...xXx ......
