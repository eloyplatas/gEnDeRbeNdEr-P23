name: EUCLIDES 120
# IDM & experimental. Tempo sugerido: 120 BPM.
# Ritmos euclidianos: bombo E(5,16), palmas E(3,8), hats E(7,16), toms E(9,16).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X.X. .X.X .X..

[p1]
kick   X... .... .... ....
clap   X.X. .X.. X.X. .X..
hhc    X.X. X.X. .X.X .X..
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X.X. X.X. .X.X .X..
clap   XoX. oX.o XoX. oX..
hhc    XXX. XX.X X.XX .XX.
hho    .... .... .... ..X.
hitom  .... .... ..X. ....
lotom  XX.X .X.X X.X. X.X.

[p3]
kick   X.X. X.X. .X.X .X..
clap   XoX. oX.o XoX. oX..
hhc    XXX. XX.X X.XX .XX.
hho    .... .... .... ..X.
hitom  .... .... ..X. ....
lotom  XX.X .X.X X.X. X.X.

[p4]                         # BASE
kick   X..X ..X. .X.. X...
clap   X.X. .X.. X.X. .X..
hhc    X.X. X.X. .X.X .X..
hitom  .... .... ..X. ....
lotom  XX.X .X.X X.X. X.X.

[p5]
kick   X..X ..X. .X.. X...
clap   X.X. .X.. X.X. .X..
hhc    X.X. X.X. .X.X .X..
hitom  .... .... ..X. ....
lotom  XX.X .X.X X.X. X.X.

[p6]                         # VARIACION
kick   X... .X.. ..X. ....
clap   X..X ..X. .X.. X...
hhc    X... X... .X.X .X..
hho    ..X. ..X. .... ....
hitom  .... .... ..X. ....
lotom  XX.X .X.X X.X. X.X.

[p7]
kick   X... .X.. ..X. ....
clap   X..X ..X. .X.. X...
hhc    X... X... .X.X .X..
hho    ..X. ..X. .... ....
hitom  .... .... ..X. .x..
lotom  XX.X .X.X X.X. X.Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
