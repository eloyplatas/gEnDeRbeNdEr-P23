name: MAMBO 110
# Latin America & Caribbean. Tempo sugerido: 110 BPM.
# Mambo: campana de mambo e golpes de metais (caixa) a contratempo.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.XX X.XX X.XX X.XX

[p1]
kick   X... .... .... ....
snare  ...X ..X. ...X ..X.
clap   X..X ..X. ..X. X...
hhc    X.XX X.XX X.XX X.XX
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   .... ..Xx .... ..X.
snare  ..oX .oX. .... .oX.
clap   X.oX .oX. .oXo X...
hhc    X-XX X-XX X-XX X-XX
hho    .... .... .... ..X.
hitom  .... x.XX .... x.XX
lotom  ...X ...X ..X. ....

[p3]
kick   .... ..Xx .... .XX.
snare  ..oX .oX. ..oX .oX.
clap   X.oX .oX. .oXo X...
hhc    X-XX X-XX X-XX X-XX
hho    .... .... .... ..X.
hitom  .... x.XX .... x.XX
lotom  ...X ...X ..X. ....

[p4]                         # BASE
kick   .... ..X. .... ..X.
snare  ...X ..X. .... ..X.
clap   X..X ..X. ..X. X...
hhc    X.XX X.XX X.XX X.XX
hitom  .... x.XX .... x.XX
lotom  ...X ...X ..X. ....

[p5]
kick   .... ..X. .... ..X.
snare  ...X ..X. ...X ..X.
clap   X..X ..X. ..X. X...
hhc    X.XX X.XX X.XX X.XX
hitom  .... x.XX .... x.XX
lotom  ...X ...X ..X. ....

[p6]                         # VARIACION
kick   .... ..X. .... ..X.
snare  X..X ..X. ..X. X...
clap   ...X ..X. .... ..X.
hhc    X..X X..X X..X X..X
hho    ..X. ..X. ..X. ..X.
hitom  .... x.XX .... x.XX
lotom  ...X ...X ..X. ....

[p7]
kick   .... ..X. .... ..X.
snare  X..X ..X. ..X. X...
clap   ...X ..X. ...X ..X.
hhc    X..X X..X X..X X..X
hho    ..X. ..X. ..X. ..X.
hitom  .... x.XX .... xxXX
lotom  ...X ...X ..X. ....

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
