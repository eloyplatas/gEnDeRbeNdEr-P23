name: RUCENICA 140
meter: 7/8
# Iberia & Mediterranean. Tempo sugerido: 140 BPM (negras; compas 7/8).
# Rucenica (Bulgaria), 7/8 = 2+2+3.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X.X.X.X.X.X.

[p1]
kick   X.............
hhc    X.X.X.X.X.X.X.
lotom  X.............

[p2]                         # ENERGIA
kick   X...X.x.X.....
snare  ..x...x...x.x.
hhc    X-X-X-X-X-X-X-
hho    ............X.
hitom  ............x.
lotom  X...X...X.....

[p3]
kick   X...X.x.X..X..
snare  ..x...x...x.x.
hhc    X-X-X-X-X-X-X-
hho    ............X.
hitom  ..........x.X.
lotom  X...X...X.....

[p4]                         # BASE
kick   X...X...X.....
snare  ..x...x...x.x.
hhc    X.X.X.X.X.X.X.
hitom  ............x.
lotom  X...X...X.....

[p5]
kick   X...X...X.....
snare  ..x...x...x.x.
hhc    X.X.X.X.X.X.X.
hitom  ..........x...
lotom  X...X...X.....

[p6]                         # VARIACION
kick   X...X...X.....
snare  ..x...x...x.x.
hhc    X...X...X...X.
hho    ..X...X...X...
hitom  ............x.
lotom  X...X...X.....

[p7]
kick   X...X...X.....
snare  ..x...x...x.x.
hhc    X...X...X...X.
hho    ..X...X...X...
hitom  ..........xx..
lotom  X...X...X...Xo

[p8]                         # FILL
kick   X...X...X...X.
snare  ..........ooxX
clap   .............X
hhc    X.X.X.X.X.X.X.
hho    X.............
hitom  ......Xx......
lotom  ........Xx....
