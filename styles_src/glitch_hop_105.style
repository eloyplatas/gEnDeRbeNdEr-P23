name: GLITCH HOP 105
# IDM & experimental. Tempo sugerido: 105 BPM.
# Glitch hop: hip hop con tartamudeos en fusas.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X...X... X...X... X...X.XX X...X...

[p1]
kick   X... .... .... ....
snare  .... X... .... X...
hhc    X...X... X...X... X...X... X.XXXXXX
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x X.X. ....
snare  ...o X... ...o X...
hhc    X.-.X.-. X.-.X.-. X.-.X.XX X.-.X.-.
hho    .... .... .... ..X.
lotom  X... .... X.X. ....

[p3]
kick   X... ...x X... .X..
snare  ...o X... ...o X...
hhc    X.-.X.-. X.-.X.-. X.-.X.-. X.XXXXXX
hho    .... .... .... ..X.
hitom  .... .... .... ..X.
lotom  X... .... X... ....

[p4]                         # BASE
kick   X... .... X.X. ....
snare  .... X... .... X...
hhc    X...X... X...X... X...X.XX X...X...
lotom  X... .... X.X. ....

[p5]
kick   X... .... X... ....
snare  .... X... .... X...
hhc    X...X... X...X... X...X... X.XXXXXX
lotom  X... .... X... ....

[p6]                         # VARIACION
kick   X... .... X.X. ....
snare  .... X... .... X...
hhc    X....... X....... X.....XX X.......
hho    ..X. ..X. ..X. ..X.
lotom  X... .... X.X. ....

[p7]
kick   X... .... X... ....
snare  .... X... .... X...
hhc    X....... X....... X....... X.XX.XXX
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .... Xx..
lotom  X... .... X... ..Xo

[p8]                         # FILL
kick   X..X .... X... ....
snare  ........ ........ xoxoxoxo xoXXXXXX
hhc    ..Xo XoXo .... ....
hho    X... .... .... ....
hitom  .... ..XX .... ....
lotom  .... .... .... ...X
