name: SIGUIRIYA 75
meter: 6/8
# Flamenco. Tempo sugerido: 75 BPM (negras; compas 6/8).
# Siguiriya: 2+2+3+3+2 corcheas, acentos no 1, 3, 5, 8 e 11. Moi lenta e dramatica.
# Compas de 12 tempos en dous compases de 6/8 (cada tempo = unha corchea; o tempo do nome e a negra).
# Voces: clap=palmas claras · snare=palmas sordas ou cajon agudo · kick=cajon grave · hhc=nudillos/pitos.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
clap   X...X. ..X...

[p1]
kick   X..... ......
clap   ..X... ..X...
lotom  X..... ......

[p2]                         # ENERGIA
kick   X....x ......
snare  ..-... -...-.
clap   X..oX. .oX...
lotom  X...X. ..X...

[p3]
kick   ..X..x ...X..
snare  -...-. -...-.
clap   .oX... .oX...
hitom  ...... ....X.
lotom  ..X... ..X...

[p4]                         # BASE
kick   X..... ......
snare  ..-... -...-.
clap   X...X. ..X...
lotom  X...X. ..X...

[p5]
kick   ..X... ......
snare  -...-. -...-.
clap   ..X... ..X...
lotom  ..X... ..X...

[p6]                         # VARIACION
kick   X..... ......
snare  X...X. ..X...
clap   ..-... -...-.
lotom  X...X. ..X...

[p7]
kick   ..X... ......
snare  ..X... ..X...
clap   -...-. -...-.
hitom  ...... ...x..
lotom  ..X... ..X.Xo

[p8]                         # FILL
kick   X..... ......
hho    ...... ....X.
hitom  ...... ..x.X.
lotom  X..... ......
