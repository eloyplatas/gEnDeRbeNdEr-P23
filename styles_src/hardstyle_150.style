name: HARDSTYLE 150
# Trance & hard dance. Tempo sugerido: 150 BPM.
# Hardstyle: bombo saturado con reverse bass (os toms despois do bombo).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    ..X. ..X. ..X. ..X.

[p1]
kick   X... .... .... ....
clap   .... X... .... X...
hhc    ..X. ..X. ..X. ..X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... X..x X... X...
clap   ...o X... ...o X...
hhc    o-X- o-X- o-X- o-X-
hho    .... .... .... ..X.
lotom  ..XX ..XX ..XX ..XX

[p3]
kick   X... X..x X... XX..
clap   ...o X... ...o X...
hhc    o-X- o-X- o-X- o-X-
hho    .... .... .... ..X.
lotom  ..XX ..XX ..XX ..XX

[p4]                         # BASE
kick   X... X... X... X...
clap   .... X... .... X...
hhc    ..X. ..X. ..X. ..X.
lotom  ..XX ..XX ..XX ..XX

[p5]
kick   X... X... X... X...
clap   .... X... .... X...
hhc    ..X. ..X. ..X. ..X.
lotom  ..XX ..XX ..XX ..XX

[p6]                         # VARIACION
kick   X... X... X... X...
clap   .... X... .... X...
hho    ..X. ..X. ..X. ..X.
hitom  .... .... ...X ...X
lotom  ..XX ..XX ..X. ..X.

[p7]
kick   X... X... X... X...
clap   .... X... .... X...
hho    ..X. ..X. ..X. ..X.
hitom  .... .... ...X Xx.X
lotom  ..XX ..XX ..X. ..X.

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
