name: FARRUCA 100
# Flamenco. Tempo sugerido: 100 BPM.
# Farruca: binaria e solemne, golpes de cajon no 1 e 3 e palmas a contratempo.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
clap   ..x. ..x. ..x. ..x.

[p1]
kick   X... .... .... ....
snare  .... X... .... X..X
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x X... ....
snare  ...o X... ...o X...
clap   ..x. ..x. ..x. ..x.
lotom  X... .... X... ....

[p3]
kick   X... ...x X... .X..
snare  ...o X... ...o X.xX
clap   ..x. ..x. ..x. ..x.
hitom  .... .... .... ..X.
lotom  X... .... X... ....

[p4]                         # BASE
kick   X... .... X... ....
snare  .... X... .... X...
clap   ..x. ..x. ..x. ..x.
lotom  X... .... X... ....

[p5]
kick   X... .... X... ....
snare  .... X... .... X.xX
clap   ..x. ..x. ..x. ..x.
lotom  X... .... X... ....

[p6]                         # VARIACION
kick   X... .... X... ....
snare  ..x. ..x. ..x. ..x.
clap   .... X... .... X...
lotom  X... .... X... ....

[p7]
kick   X... .... X... ....
snare  ..x. ..x. ..x. ..x.
clap   .... X... .... X.xX
hitom  .... .... .... Xx..
lotom  X... .... X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
