name: CRUNK 76
# Hip hop. Tempo sugerido: 76 BPM.
# Crunk: 808 cheo, palmas fortes e redobres.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X.X. X.X. X.X.

[p1]
kick   X... .... .... ....
clap   .... X... .... X...
hhc    X.X. X.X. X.X. XXXX
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x X... ....
clap   ...o X... ...o X...
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
lotom  X... .... X... ....

[p3]
kick   X... ...x X..X .X..
clap   ...o X... ...o X...
hhc    X-X- X-X- X-X- XXXX
hho    .... .... .... ..X.
hitom  .... .... .... ..X.
lotom  X... .... X..X ....

[p4]                         # BASE
kick   X... .... X... ....
clap   .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
lotom  X... .... X... ....

[p5]
kick   X... .... X..X ....
clap   .... X... .... X...
hhc    X.X. X.X. X.X. XXXX
lotom  X... .... X..X ....

[p6]                         # VARIACION
kick   X... .... X... ....
clap   .... X... .... X...
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
lotom  X... .... X... ....

[p7]
kick   X... .... X..X ....
clap   .... X... .... X...
hhc    X... X... X... XX.X
hho    ..X. ..X. ..X. ..X.
hitom  .... .... ...X Xx..
lotom  X... .... X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
