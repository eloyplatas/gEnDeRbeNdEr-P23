name: DARK PSY 150
# Trance & hard dance. Tempo sugerido: 150 BPM.
# Dark psy: baixo rodando, hats en semicorcheas e glitches nos toms.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    XxXx XxXx XxXx XxXx

[p1]
kick   X... .... .... ....
hhc    XxXx XxXx XxXx XxXx
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... X..x X... X...
snare  ...x ..x. ...x ..x.
hhc    XXXX XXXX XXXX XXXX
hho    .... .... .... ..X.
hitom  .... .... .... ..X.
lotom  .XXX .XXX .XXX .XXX

[p3]
kick   X... X..x X... XX..
snare  ...x ..x. ...x x.x.
hhc    XXXX XXXX XXXX XXXX
hho    .... .... .... ..X.
hitom  .... ..X. .... ..XX
lotom  .XXX .XXX .XXX .XXX

[p4]                         # BASE
kick   X... X... X... X...
snare  ...x ..x. ...x ..x.
hhc    XxXx XxXx XxXx XxXx
hitom  .... .... .... ..X.
lotom  .XXX .XXX .XXX .XXX

[p5]
kick   X... X... X... X...
snare  ...x ..x. ...x x.x.
hhc    XxXx XxXx XxXx XxXx
hitom  .... ..X. .... ..XX
lotom  .XXX .XXX .XXX .XXX

[p6]                         # VARIACION
kick   X... X... X... X...
snare  ...x ..x. ...x ..x.
hhc    Xx.x Xx.x Xx.x Xx.x
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .X.X .XXX
lotom  .XXX .XXX ..X. ..X.

[p7]
kick   X... X... X... X...
snare  ...x ..x. ...x x.x.
hhc    Xx.x Xx.x Xx.x Xx.x
hho    ..X. ..X. ..X. ..X.
hitom  .... ..X. .X.X XXXX
lotom  .XXX .XXX ..X. ..XX

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
