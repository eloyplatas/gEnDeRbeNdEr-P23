name: VALS MUSETTE 160
meter: 3/4
# European folk. Tempo sugerido: 160 BPM (negras; compas 3/4).
# Vals musette (Paris), 3/4: baixo no un e acorde de acordeon no 2 e 3.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hho    .... x... x...

[p1]
kick   X... .... ....
clap   .... X... X...
hho    .... x... x...
lotom  X... .... ....

[p2]                         # ENERGIA
kick   X... .x.. ....
clap   ...o X..o X...
hho    .... x... x...
lotom  X... .... ....

[p3]
kick   X... .x.. .X..
clap   ...o X..o X...
hho    .... x... x...
hitom  X... .... ..X.
lotom  .... X... ....

[p4]                         # BASE
kick   X... .... ....
clap   .... X... X...
hho    .... x... x...
lotom  X... .... ....

[p5]
kick   X... .... ....
clap   .... X... X...
hho    .... x... x...
hitom  X... .... ....
lotom  .... X... ....

[p6]                         # VARIACION
kick   X... .... ....
clap   .... X... X...
hho    .... x... x...
lotom  X... .... ....

[p7]
kick   X... .... ....
clap   .... X... X...
hho    .... x... x...
hitom  X... .... Xx..
lotom  .... X... ..Xo

[p8]                         # FILL
kick   X... X... X...
snare  .... .... ooxX
clap   .... .... ...X
hho    X... .... ....
hitom  .... Xx.. ....
lotom  .... ..Xx ....
