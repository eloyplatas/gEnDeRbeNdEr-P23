name: MARACATU 90
# Latin America & Caribbean. Tempo sugerido: 90 BPM.
# Maracatu nacao: alfaias pesadas, caixa en semicorcheas e gongue.
# Voces: kick/toms=alfaias · hhc=gongue.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. .X.X .X.. X.X.

[p1]
kick   X... .... .... ....
snare  X..X X..X X..X X..X
hhc    X.X. .X.X .X.. X.X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X..X ..Xx X... ....
snare  XxxX XxxX XxxX XxxX
hhc    X-X- oXoX oXo- X-X-
hho    .... .... .... ..X.
hitom  .... .... ..X. .X..
lotom  X..X ..X. X... ....

[p3]
kick   X..X ..Xx X... XXX.
snare  XxxX XxxX XxxX XxxX
hhc    X-X- oXoX oXo- X-X-
hho    .... .... .... ..X.
hitom  .... .... ..X. XXX.
lotom  X..X ..X. X... ....

[p4]                         # BASE
kick   X..X ..X. X... ....
snare  XxxX XxxX XxxX XxxX
hhc    X.X. .X.X .X.. X.X.
hitom  .... .... ..X. .X..
lotom  X..X ..X. X... ....

[p5]
kick   X..X ..X. X... X.X.
snare  XxxX XxxX XxxX XxxX
hhc    X.X. .X.X .X.. X.X.
hitom  .... .... ..X. XX..
lotom  X..X ..X. X... ....

[p6]                         # VARIACION
kick   X..X ..X. X... ....
snare  XxxX XxxX XxxX XxxX
hhc    X... .X.X .X.. X...
hho    ..X. .... .... ..X.
hitom  .... .... ..X. .X..
lotom  X..X ..X. X... ....

[p7]
kick   X..X ..X. X... X.X.
snare  XxxX XxxX XxxX XxxX
hhc    X... .X.X .X.. X...
hho    ..X. .... .... ..X.
hitom  .... .... ..X. XX..
lotom  X..X ..X. X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
