name: JUJU 110
# Africa. Tempo sugerido: 110 BPM.
# Juju (Nixeria): tambores falantes (toms) e campa ternaria sobre catro.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.XX .X.X X.XX .X.X

[p1]
kick   X... .... .... ....
snare  .... X... .... X...
hhc    X.XX .X.X X.XX .X.X
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x X... ....
snare  ...o X... ...o X...
hhc    X-XX oXoX X-XX oXoX
hho    .... .... .... ..X.
hitom  ..X. .... X.X. X...
lotom  X..X ..X. X..X ..X.

[p3]
kick   X... ...x X... .X..
snare  ...o X... ...o X...
hhc    X-XX oXoX X-XX oXoX
hho    .... .... .... ..X.
hitom  ..X. .... XXX. X...
lotom  X..X ..X. X..X ..X.

[p4]                         # BASE
kick   X... .... X... ....
snare  .... X... .... X...
hhc    X.XX .X.X X.XX .X.X
hitom  ..X. .... X.X. X...
lotom  X..X ..X. X..X ..X.

[p5]
kick   X... .... X... ....
snare  .... X... .... X...
hhc    X.XX .X.X X.XX .X.X
hitom  ..X. .... XXX. X...
lotom  X..X ..X. X..X ..X.

[p6]                         # VARIACION
kick   X... .... X... ....
snare  .... X... .... X...
hhc    X..X .X.X X..X .X.X
hho    ..X. .... ..X. ....
hitom  ..X. .... X.XX X...
lotom  X..X ..X. X... ..X.

[p7]
kick   X... .... X... ....
snare  .... X... .... X...
hhc    X..X .X.X X..X .X.X
hho    ..X. .... ..X. ....
hitom  ..X. .... XXXX Xx..
lotom  X..X ..X. X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
