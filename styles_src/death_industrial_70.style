name: DEATH INDUSTRIAL 70
# Industrial & dark. Tempo sugerido: 70 BPM.
# Death industrial: golpes lentos e pesados, ruido aberto.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hho    .... .... X... ....

[p1]
kick   X... .... .... ....
snare  .... .... X... ....
hho    .... .... X... ....
lotom  X... .... .... ....

