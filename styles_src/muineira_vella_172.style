name: MUINEIRA VELLA 172
meter: 6/8
# Galicia. Tempo sugerido: 172 BPM (negras; compas 6/8).
# Muineira vella (empunada), 6/8: acento na segunda corchea, a pandeireta toca co puno.
# Voces: kick=bombo · snare=tamboril/caixa · clap=pel da pandeireta, cunchas ou palmas
# hhc=ferrenas (pandeireta) · hho=xiro/arrastre de ferrenas · lotom/hitom=baixo (ronco, bordon).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X.X. X.X.X.

[p1]
kick   X..... ......
clap   ..X... ..X...
hhc    X.X.X. X.X.X.
hho    ...... ....X.
lotom  X..... ......

[p2]                         # ENERGIA
kick   X....x -.....
snare  ..o... ..o..-
clap   .oX... .oX...
hhc    X-X-X- X-X-X-
hho    ...... ....X.
hitom  ....-. ....-.
lotom  ..X... ..X...

[p3]
kick   X....x -..X..
snare  ..o... ..o.oo
clap   .oX... .oX...
hhc    X-X-X- X-X-X-
hho    ...... ....X.
hitom  ....-. ..x.X.
lotom  ..X... ..X...

[p4]                         # BASE
kick   X..... -.....
snare  ..o... ..o..-
clap   ..X... ..X...
hhc    X.X.X. X.X.X.
hitom  ....-. ....-.
lotom  ..X... ..X...

[p5]
kick   X..... -.....
snare  ..o... ..o.oo
clap   ..X... ..X...
hhc    X.X.X. X.X.X.
hho    ...... ....X.
hitom  ....-. ..x...
lotom  ..X... ..X...

[p6]                         # VARIACION
kick   X..... -.....
snare  ..X... ..X...
clap   ..o... ..o..-
hhc    X.X... X.X...
hho    ....X. ....X.
hitom  ....-. ....-.
lotom  ..X... ..X...

[p7]
kick   X..... -.....
snare  ..X... ..X...
clap   ..o... ..o.oo
hhc    X.X... X.X.X.
hho    ....X. ....X.
hitom  ....-. ..xx..
lotom  ..X... ..X.Xo

[p8]                         # FILL
kick   X..... X.....
snare  ...... ooxxXX
clap   ...... .....X
hhc    X.X.X. X.X.X.
hho    X..... ......
hitom  XxX... ......
lotom  ...xXx ......
