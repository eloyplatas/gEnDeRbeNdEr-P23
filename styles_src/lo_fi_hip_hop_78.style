name: LO FI HIP HOP 78
# Hip hop. Tempo sugerido: 78 BPM.
# Lo-fi hip hop: break suave, hats con adornos e swing 58-62.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.x. X.x. X.x. X.x.

[p1]
kick   X... .... .... ....
snare  .... X... .... X...
hhc    X.x. X.x. X.x. X.x.
hho    .... .... .... ..X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...X ..X. ....
snare  ...o X... ...o X...
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
lotom  X... ...X ..X. ....

[p3]
kick   X... ...X ..X. .X..
snare  ...o X... ...o X...
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
hitom  .... .... .... ..X.
lotom  X... ...X ..X. .X..

[p4]                         # BASE
kick   X... ...X ..X. ....
snare  .... X... .... X...
hhc    X.x. X.x. X.x. X.x.
lotom  X... ...X ..X. ....

[p5]
kick   X... ...X ..X. ....
snare  .... X... .... X...
hhc    X.x. X.x. X.x. X.x.
hho    .... .... .... ..X.
lotom  X... ...X ..X. .X..

[p6]                         # VARIACION
kick   X... ...X ..X. ....
snare  .... X... .... X...
hhc    X... X... X... X...
hho    ..x. ..x. ..x. ..x.
lotom  X... ...X ..X. ....

[p7]
kick   X... ...X ..X. ....
snare  .... X... .... X...
hhc    X... X... X... X.x.
hho    ..x. ..x. ..x. ..X.
hitom  .... .... .... XX..
lotom  X... ...X ..X. ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
