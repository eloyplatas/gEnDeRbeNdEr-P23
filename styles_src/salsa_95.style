name: SALSA 95
# Latin America & Caribbean. Tempo sugerido: 95 BPM.
# Salsa: un compas = un ciclo de clave 3-2 (tempo real ~190 a dous).
# Voces: clap=clave · hhc=cascara · snare=bongo · hitom=conga · lotom=baixo anticipado (tumbao).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. XX.X X.XX .X.X

[p1]
kick   X... .... .... ....
snare  X... X... X... X...
clap   X..X ..X. ..X. X...
hhc    X.X. XX.X X.XX .X.X
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   .... ..Xx .... ..X.
snare  X.xo X.xo X.xo X.x.
clap   X.oX .oX. .oXo X...
hhc    X-X- XXoX X-XX oXoX
hho    .... .... .... ..X.
hitom  .... x.XX .... x.XX
lotom  ...X ...X ..X. ....

[p3]
kick   .... ..Xx .... .XX.
snare  X.xo X.xo X.xo X.x.
clap   X.oX .oX. .oXo X...
hhc    X-X- XXoX X-XX oXoX
hho    .... .... .... ..X.
hitom  .... x.XX .... x.XX
lotom  ...X ...X ..X. ....

[p4]                         # BASE
kick   .... ..X. .... ..X.
snare  X.x. X.x. X.x. X.x.
clap   X..X ..X. ..X. X...
hhc    X.X. XX.X X.XX .X.X
hitom  .... x.XX .... x.XX
lotom  ...X ...X ..X. ....

[p5]
kick   .... ..X. .... ..X.
snare  X.x. X.x. X.x. X.x.
clap   X..X ..X. ..X. X...
hhc    X.X. XX.X X.XX .X.X
hitom  .... x.XX .... x.XX
lotom  ...X ...X ..X. ....

[p6]                         # VARIACION
kick   .... ..X. .... ..X.
snare  X..X ..X. ..X. X...
clap   X.x. X.x. X.x. X.x.
hhc    X... XX.X X..X .X.X
hho    ..X. .... ..X. ....
hitom  .... x.XX .... x.XX
lotom  ...X ...X ..X. ....

[p7]
kick   .... ..X. .... ..X.
snare  X..X ..X. ..X. X...
clap   X.x. X.x. X.x. X.x.
hhc    X... XX.X X..X .X.X
hho    ..X. .... ..X. ....
hitom  .... x.XX .... xxXX
lotom  ...X ...X ..X. ....

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
