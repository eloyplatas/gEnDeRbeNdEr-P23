name: TANGOS FLAMENCOS 110
# Iberia & Mediterranean. Tempo sugerido: 110 BPM.
# Tangos flamencos, 4/4: palmas en 2, 3 e 4 (o 1 queda en silencio).
# Voces: kick/snare=cajon · clap=palmas.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    ..x. ..x. ..x. ..x.

[p1]
kick   X... .... .... ....
snare  .... X... X... X...
clap   .... X... X... X...
hhc    ..x. ..x. ..x. ..x.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x X..x ....
snare  ...o X..o X..o X...
clap   ...o X..o X..o X...
hhc    o-X- o-X- o-X- o-X-
hho    .... .... .... ..X.
lotom  X... .... X... ....

[p3]
kick   X... ...x X..x .X..
snare  ...o X..o X..o X.oo
clap   ...o X..o X..o X...
hhc    o-X- o-X- o-X- o-X-
hho    .... .... .... ..X.
hitom  .... .... .... ..X.
lotom  X... .... X... ....

[p4]                         # BASE
kick   X... .... X..x ....
snare  .... X... X... X...
clap   .... X... X... X...
hhc    ..x. ..x. ..x. ..x.
lotom  X... .... X... ....

[p5]
kick   X... .... X..x ....
snare  .... X... X... X.oo
clap   .... X... X... X...
hhc    ..x. ..x. ..x. ..x.
lotom  X... .... X... ....

[p6]                         # VARIACION
kick   X... .... X..x ....
snare  .... X... X... X...
clap   .... X... X... X...
hho    ..x. ..x. ..x. ..x.
lotom  X... .... X... ....

[p7]
kick   X... .... X..x ....
snare  .... X... X... X...
clap   .... X... X... X.oo
hho    ..x. ..x. ..x. ..x.
hitom  .... .... .... Xx..
lotom  X... .... X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
