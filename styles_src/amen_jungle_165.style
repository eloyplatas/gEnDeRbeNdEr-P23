name: AMEN JUNGLE 165
# Breaks, jungle & drum & bass. Tempo sugerido: 165 BPM.
# Jungle: break Amen (compases 1 e 3) con ride en corcheas e baixo reese.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X.X. X.X. X.X.

[p1]
kick   X... .... .... ....
snare  .... X..X .X.. ..X.
hhc    X.X. X.X. X.X. X.X.
hho    .... .... ..X. ....
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X.X. ...x ..XX ....
snare  ...o X.oX oX.o X.oX
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
lotom  X... .... X... ..X.

[p3]
kick   X.X. ...x ..X. .X..
snare  ...o X.oX oX.. .oX.
hhc    X-X- X-X- X-X- X-X-
hho    .... .... ..X. ..X.
hitom  .... .... .... X.X.
lotom  X... .... X... ....

[p4]                         # BASE
kick   X.X. .... ..XX ....
snare  .... X..X .X.. X..X
hhc    X.X. X.X. X.X. X.X.
lotom  X... .... X... ..X.

[p5]
kick   X.X. .... ..X. ....
snare  .... X..X .X.. ..X.
hhc    X.X. X.X. X.X. X.X.
hho    .... .... ..X. ....
hitom  .... .... .... X...
lotom  X... .... X... ....

[p6]                         # VARIACION
kick   X.X. .... ..XX ....
snare  .... X..X .X.. X..X
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
lotom  X... .... X... ..X.

[p7]
kick   X.X. .... ..X. ....
snare  .... X..X .X.. ..X.
hhc    X... X... X.X. X...
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .... Xx..
lotom  X... .... X... ..Xo

[p8]                         # FILL
kick   X..X .... X... ....
snare  ........ ........ xoxoxoxo xoXXXXXX
hhc    ..Xo XoXo .... ....
hho    X... .... .... ....
hitom  .... ..XX .... ....
lotom  .... .... .... ...X
