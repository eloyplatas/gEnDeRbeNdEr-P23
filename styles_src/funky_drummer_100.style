name: FUNKY DRUMMER 100
# Hip hop. Tempo sugerido: 100 BPM.
# Break tipo Funky Drummer: caixa con fantasmas e hat aberto no un-e.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    XXXX XXX. XXXX XXXX
hho    .... ...X .... ....

[p1]
kick   X... .... .... ....
snare  .... X..X .X.X ..X.
hhc    XXXX XXX. XXXX XXXX
hho    .... ...X .... ....
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X.X. ...x ..X. .X..
snare  ...o X.oX oXoX .oX.
hhc    XXXX XXX- XXXX XXXX
hho    .... ...X .... ..X.
lotom  X.X. .... ..X. .X..

[p3]
kick   X.X. ...x ..X. .X..
snare  ...o X.oX oXoX .oX.
hhc    XXXX XXX- XXXX XXXX
hho    .... ...X .... ..X.
hitom  .... .... .... ..X.
lotom  X.X. .... ..X. ....

[p4]                         # BASE
kick   X.X. .... ..X. .X..
snare  .... X..X .X.X ..X.
hhc    XXXX XXX. XXXX XXXX
hho    .... ...X .... ....
lotom  X.X. .... ..X. .X..

[p5]
kick   X.X. .... ..X. .X..
snare  .... X..X .X.X ..X.
hhc    XXXX XXX. XXXX XXXX
hho    .... ...X .... ....
lotom  X.X. .... ..X. ....

[p6]                         # VARIACION
kick   X.X. .... ..X. .X..
snare  .... X..X .X.X ..X.
hhc    XX.X XX.. XX.X XX.X
hho    ..X. ..XX ..X. ..X.
hitom  .... .... .... .X..
lotom  X.X. .... ..X. ....

[p7]
kick   X.X. .... ..X. .X..
snare  .... X..X .X.X ..X.
hhc    XX.X XX.. XX.X XX.X
hho    ..X. ..XX ..X. ..X.
hitom  .... .... .... Xx..
lotom  X.X. .... ..X. ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
