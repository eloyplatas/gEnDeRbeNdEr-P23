name: KPANLOGO 120
# African traditional. Tempo sugerido: 120 BPM.
# Kpanlogo (Ga, Acra): campa, shaker e tambores de conga.
# Voces: hhc=nono (campa) · hho=shaker.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X..X ..X. X...
hho    ..X. ..X. ..X. ..X.

[p1]
kick   X... .... .... ....
snare  ...X .X.. ...X .XX.
hhc    X.X. X..X ..X. X...
hho    ..X. ..X. ..X. ..X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ..Xx ..X. ....
snare  ..oX oX.. ..oX oX..
hhc    X-X- X-oX o-X- X-o-
hho    ..X. ..X. ..X. ..X.
hitom  ..X. .... .X.. .X..
lotom  X... ..X. ..X. ....

[p3]
kick   X... ..Xx ..X. .X..
snare  ..oX oX.. ..oX oXX.
hhc    X-X- X-oX o-X- X-o-
hho    ..X. ..X. ..X. ..X.
hitom  ..X. .... .X.. .XX.
lotom  X... ..X. ..X. .X..

[p4]                         # BASE
kick   X... ..X. ..X. ....
snare  ...X .X.. ...X .X..
hhc    X.X. X..X ..X. X...
hho    ..X. ..X. ..X. ..X.
hitom  ..X. .... .X.. .X..
lotom  X... ..X. ..X. ....

[p5]
kick   X... ..X. ..X. ....
snare  ...X .X.. ...X .XX.
hhc    X.X. X..X ..X. X...
hho    ..X. ..X. ..X. ..X.
hitom  ..X. .... .X.. .X..
lotom  X... ..X. ..X. .X..

[p6]                         # VARIACION
kick   X... ..X. ..X. ....
snare  ...X .X.. ...X .X..
hhc    X.X. X..X ..X. X...
hho    ..X. ..X. ..X. ..X.
hitom  ..X. .... .X.. .X..
lotom  X... ..X. ..X. ....

[p7]
kick   X... ..X. ..X. ....
snare  ...X .X.. ...X .XX.
hhc    X.X. X..X ..X. X...
hho    ..X. ..X. ..X. ..X.
hitom  ..X. .... .X.. XX..
lotom  X... ..X. ..X. .XXo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
