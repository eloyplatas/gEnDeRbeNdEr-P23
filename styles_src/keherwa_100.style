name: KEHERWA 100
# Asia & Middle East. Tempo sugerido: 100 BPM.
# Keherwa (tabla, 8 matras): dha ge na ti | na ka dhi na.
# Voces: kick=bayan · snare=dayan · clap=tali (sam).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
clap   X... .... .... ....

[p1]
kick   X... .... .... ....
snare  X... X.X. X.X. X.X.
clap   X... .... .... ....
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X.X. ...x .... X...
snare  X..o XoXo XoXo XoX.
clap   X... .... .... ....
lotom  X.X. .... .... X...

[p3]
kick   X.X. ...x .... XX..
snare  X..o XoXo XoXo XoX.
clap   X... .... .... ....
hitom  .... .... .... ..X.
lotom  X.X. .... .... X...

[p4]                         # BASE
kick   X.X. .... .... X...
snare  X... X.X. X.X. X.X.
clap   X... .... .... ....
lotom  X.X. .... .... X...

[p5]
kick   X.X. .... .... X...
snare  X... X.X. X.X. X.X.
clap   X... .... .... ....
lotom  X.X. .... .... X...

[p6]                         # VARIACION
kick   X.X. .... .... X...
snare  X... .... .... ....
clap   X... X.X. X.X. X.X.
lotom  X.X. .... .... X...

[p7]
kick   X.X. .... .... X...
snare  X... .... .... ....
clap   X... X.X. X.X. X.X.
hitom  .... .... .... .x..
lotom  X.X. .... .... X.Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
