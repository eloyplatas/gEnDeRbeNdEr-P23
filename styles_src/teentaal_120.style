name: TEENTAAL 120
# Asia & Middle East. Tempo sugerido: 120 BPM.
# Teentaal (16 matras en dous compases, unha matra por corchea):
# dha dhin dhin dha | dha dhin dhin dha | dha tin tin ta | ta dhin dhin dha.
# Bayan nas silabas resonantes; tali (palmas) nas matras 1, 5 e 13, khali na 9.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
clap   X... .... X... ....

[p1]
kick   X... .... .... ....
snare  X.X. X.X. X.X. X.X.
clap   .... .... X... ....
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X.X. X.Xx X.X. X.X.
snare  XoXo XoXo XoXo XoX.
clap   X... ...o X... ....
lotom  X... .... X... ....

[p3]
kick   X... ...x ..X. XXX.
snare  XoXo XoXo XoXo XoX.
clap   .... ...o X... ....
hitom  .... .... .... ..X.
lotom  .... .... ..X. ....

[p4]                         # BASE
kick   X.X. X.X. X.X. X.X.
snare  X.X. X.X. X.X. X.X.
clap   X... .... X... ....
lotom  X... .... X... ....

[p5]
kick   X... .... ..X. X.X.
snare  X.X. X.X. X.X. X.X.
clap   .... .... X... ....
lotom  .... .... ..X. ....

[p6]                         # VARIACION
kick   X.X. X.X. X.X. X.X.
snare  X... .... X... ....
clap   X.X. X.X. X.X. X.X.
lotom  X... .... X... ....

[p7]
kick   X... .... ..X. X.X.
snare  .... .... X... ....
clap   X.X. X.X. X.X. X.X.
hitom  .... .... .... Xx..
lotom  .... .... ..X. ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
