name: MBIRA SHONA 120
meter: 6/8
# African traditional. Tempo sugerido: 120 BPM (negras; compas 6/8).
# Musica de mbira (Shona, Zimbabwe), 12/8: hosho en tresillos e palmas.
# Voces: hhc=hosho · clap=palmas.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.xX.x X.xX.x

[p1]
kick   X..... ......
clap   X..... X.....
hhc    X.xX.x X.xX.x
lotom  X..... ......

[p2]                         # ENERGIA
kick   X....x X.....
clap   X....o X.....
hhc    X-XXoX X-XXoX
hho    ...... ....X.
lotom  X..X.. X..X..

[p3]
kick   X....x X..X..
clap   X....o X.....
hhc    X-XXoX X-XXoX
hho    ...... ....X.
hitom  ...... ....X.
lotom  X..X.. X..X..

[p4]                         # BASE
kick   X..... X.....
clap   X..... X.....
hhc    X.xX.x X.xX.x
lotom  X..X.. X..X..

[p5]
kick   X..... X.....
clap   X..... X.....
hhc    X.xX.x X.xX.x
lotom  X..X.. X..X..

[p6]                         # VARIACION
kick   X..... X.....
clap   X..... X.....
hhc    X.xX.x X.xX.x
hitom  ...... ...X..
lotom  X..X.. X.....

[p7]
kick   X..... X.....
clap   X..... X.....
hhc    X.xX.x X.xX.x
hitom  ...... ..XX..
lotom  X..X.. X...Xo

[p8]                         # FILL
kick   X..... ......
hhc    X.xX.x X.xX.x
hho    ...... ....X.
hitom  ...... ..x.X.
lotom  X..... ......
