name: DEEP HOUSE 120
# House & disco. Tempo sugerido: 120 BPM.
# Deep house: catro no chan, palmas suaves, hats abertos e baixo sincopado.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    x.x. x.x. x.x. x.x.
hho    ..X. ..X. ..X. ..X.

[p1]
kick   X... .... .... ....
clap   .... X... .... X...
hhc    x.x. x.x. x.x. x.x.
hho    ..X. ..X. ..X. ..X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... X..x X... X...
snare  ..x. ..-. .... x..x
clap   ...o X... ...o X...
hhc    X-X- X-X- X-X- X-X-
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .... ..x.
lotom  X..X ..X. ..X. .X..

[p3]
kick   X... X..x X... XX..
snare  ..x. ..-. .... x..x
clap   ...o X... ...o X...
hhc    X-X- X-X- X-X- X-X-
hho    ..X. ..X. ..X. ..X.
hitom  .... .... ..x. ..X.
lotom  X..X ..X. ..X. ....

[p4]                         # BASE
kick   X... X... X... X...
snare  ..x. ..-. .... x..x
clap   .... X... .... X...
hhc    x.x. x.x. x.x. x.x.
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .... ..x.
lotom  X..X ..X. ..X. .X..

[p5]
kick   X... X... X... X...
snare  ..x. ..-. .... x..x
clap   .... X... .... X...
hhc    x.x. x.x. x.x. x.x.
hho    ..X. ..X. ..X. ..X.
hitom  .... .... ..x. ....
lotom  X..X ..X. ..X. ....

[p6]                         # VARIACION
kick   X... X... X... X...
snare  .... X... .... X...
clap   ..x. ..-. .... x..x
hhc    x.x. x.x. x.x. x.x.
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .... .Xx.
lotom  X..X ..X. ..X. ....

[p7]
kick   X... X... X... X...
snare  .... X... .... X...
clap   ..x. ..-. .... x..x
hhc    x.x. x.x. x.x. x.x.
hho    ..X. ..X. ..X. ..X.
hitom  .... .... ..x. Xx..
lotom  X..X ..X. ..X. ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
