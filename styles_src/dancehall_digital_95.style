name: DANCEHALL DIGITAL 95
# Reggae, dub & rocksteady. Tempo sugerido: 95 BPM.
# Dancehall dixital (mediados dos 80): caixa de caixa de ritmos no 2 e 4 e baixo seco.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X.X. X.X. X.X.

[p1]
kick   X... .... .... ....
snare  .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ..Xx ..X. ....
snare  ...o X... ...o X...
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
lotom  X... ..X. ..X. X...

[p3]
kick   X... ..Xx ..X. .X..
snare  ...o X... ...o X...
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
hitom  .... .... .... ..X.
lotom  X... ..X. ..X. ....

[p4]                         # BASE
kick   X... ..X. ..X. ....
snare  .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
lotom  X... ..X. ..X. X...

[p5]
kick   X... ..X. ..X. ....
snare  .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
lotom  X... ..X. ..X. ....

[p6]                         # VARIACION
kick   X... ..X. ..X. ....
snare  .... X... .... X...
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
lotom  X... ..X. ..X. X...

[p7]
kick   X... ..X. ..X. ....
snare  .... X... .... X...
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .... Xx..
lotom  X... ..X. ..X. ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
