name: TIMBA 105
# Latin America & Caribbean. Tempo sugerido: 105 BPM.
# Timba (Cuba, anos 90): bombo funk sobre clave, bongo e campanas cruzadas.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.XX X.XX X.XX X.XX

[p1]
kick   X... .... .... ....
snare  ...X ..X. .X.X ..X.
clap   ..X. X... X..X ..X.
hhc    X.XX X.XX X.XX X.XX
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X..X ...x ..X. .X..
snare  ..oX .oX. ..oX .oX.
clap   .oXo X..o X.oX .oX.
hhc    X-XX X-XX X-XX X-XX
hho    .... .... .... ..X.
hitom  .... x.XX .... x.XX
lotom  X..X ...X ..X. .X..

[p3]
kick   X..X ...x ..X. .X..
snare  ..oX .oX. oXoX .oX.
clap   .oXo X..o X.oX .oX.
hhc    X-XX X-XX X-XX X-XX
hho    .... .... .... ..X.
hitom  .... x.XX .... x.XX
lotom  X..X ...X ..X. ....

[p4]                         # BASE
kick   X..X .... ..X. .X..
snare  ...X ..X. ...X ..X.
clap   ..X. X... X..X ..X.
hhc    X.XX X.XX X.XX X.XX
hitom  .... x.XX .... x.XX
lotom  X..X ...X ..X. .X..

[p5]
kick   X..X .... ..X. .X..
snare  ...X ..X. .X.X ..X.
clap   ..X. X... X..X ..X.
hhc    X.XX X.XX X.XX X.XX
hitom  .... x.XX .... x.XX
lotom  X..X ...X ..X. ....

[p6]                         # VARIACION
kick   X..X .... ..X. .X..
snare  ..X. X... X..X ..X.
clap   ...X ..X. ...X ..X.
hhc    X..X X..X X..X X..X
hho    ..X. ..X. ..X. ..X.
hitom  .... x.XX .... xXXX
lotom  X..X ...X ..X. ....

[p7]
kick   X..X .... ..X. .X..
snare  ..X. X... X..X ..X.
clap   ...X ..X. .X.X ..X.
hhc    X..X X..X X..X X..X
hho    ..X. ..X. ..X. ..X.
hitom  .... x.XX .... xxXX
lotom  X..X ...X ..X. ....

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
