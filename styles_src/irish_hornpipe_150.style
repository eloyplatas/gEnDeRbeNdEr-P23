name: IRISH HORNPIPE 150
# European folk. Tempo sugerido: 150 BPM.
# Hornpipe: corcheas con punto (swing marcado) e remate de tres negras.
# Voces (bodhran): kick=golpe grave · snare=parte alta/aro · hhc=punta da baqueta.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X..x X..x X..x X..x

[p1]
kick   X... .... .... ....
hhc    X..x X..x X... X...
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x X... ....
snare  ...x ...x ...x ...x
hhc    X-oX X-oX X-oX X-oX
hho    .... .... .... ..X.
lotom  X... .... X... ....

[p3]
kick   X... ...x X... XX..
snare  ...x ...x .... ....
hhc    X-oX X-oX X-o- X-o-
hho    .... .... .... ..X.
hitom  .... .... .... ..X.
lotom  X... .... X... X...

[p4]                         # BASE
kick   X... .... X... ....
snare  ...x ...x ...x ...x
hhc    X..x X..x X..x X..x
lotom  X... .... X... ....

[p5]
kick   X... .... X... X...
snare  ...x ...x .... ....
hhc    X..x X..x X... X...
lotom  X... .... X... X...

[p6]                         # VARIACION
kick   X... .... X... ....
snare  ...x ...x ...x ...x
hhc    X..x X..x X..x X..x
lotom  X... .... X... ....

[p7]
kick   X... .... X... X...
snare  ...x ...x .... ....
hhc    X..x X..x X... X...
hitom  .... .... .... .x..
lotom  X... .... X... X.Xo

[p8]                         # FILL
kick   X... X... X... X...
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X..x X..x X..x X..x
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
