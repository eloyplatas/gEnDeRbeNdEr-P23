name: TECH HOUSE 125
# Techno. Tempo sugerido: 125 BPM.
# Tech house: catro no chan, palmas, hats a contratempo e baixo saltarin.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    ..X. ..X. ..X. ..X.

[p1]
kick   X... .... .... ....
clap   .... X... .... X...
hhc    ..X. ..X. ..X. ..X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... X..x X... X...
snare  .... ...x .... ..x.
clap   ...o X... ...o X...
hhc    o-X- o-X- o-X- o-X-
hho    .... .... .... ..X.
lotom  ..X. .X.. ..X. .X..

[p3]
kick   X... X..x X... XX..
snare  ...x ...x .... ..x.
clap   ...o X... ...o X...
hhc    o-X- o-X- o-X- o-X-
hho    .... .... .... ..X.
lotom  ..X. .X.. ..X. .XX.

[p4]                         # BASE
kick   X... X... X... X...
snare  .... ...x .... ..x.
clap   .... X... .... X...
hhc    ..X. ..X. ..X. ..X.
lotom  ..X. .X.. ..X. .X..

[p5]
kick   X... X... X... X...
snare  ...x ...x .... ..x.
clap   .... X... .... X...
hhc    ..X. ..X. ..X. ..X.
lotom  ..X. .X.. ..X. .XX.

[p6]                         # VARIACION
kick   X... X... X... X...
snare  .... X... .... X...
clap   .... ...x .... ..x.
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .... .X..
lotom  ..X. .X.. ..X. ....

[p7]
kick   X... X... X... X...
snare  .... X... .... X...
clap   ...x ...x .... ..x.
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .... XX..
lotom  ..X. .X.. ..X. ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
