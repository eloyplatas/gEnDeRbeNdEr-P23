name: ALALA ESPAZO 60
# Galicia. Tempo sugerido: 60 BPM.
# Alala: canto de ritmo libre. Interpretacion ambiental: bombo lonxano e ferrenas soltas.
# Voces: kick=bombo · snare=tamboril/caixa · clap=pel da pandeireta, cunchas ou palmas
# hhc=ferrenas (pandeireta) · hho=xiro/arrastre de ferrenas · lotom/hitom=baixo (ronco, bordon).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X... .... .... ....
hho    .... .... X... ....

[p1]
kick   X... .... .... ....
hhc    .... ..-. .... x...
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x .... ....
hhc    X-o- o-o- o-o- o-o-
hho    .... .... X... ..X.
lotom  X... .... .... ....

[p3]
kick   .... ...x X... .X..
hhc    o-o- o--- o-o- X-o-
hho    .... .... .... ..X.
hitom  .... .... x... ..X.
lotom  X... .... -... ....

[p4]                         # BASE
kick   X... .... .... ....
hhc    X... .... .... ....
hho    .... .... X... ....
lotom  X... .... .... ....

[p5]
kick   .... .... X... ....
hhc    .... ..-. .... x...
hitom  .... .... x... ....
lotom  X... .... -... ....

[p6]                         # VARIACION
kick   X... .... .... ....
hhc    X... .... .... ....
hho    .... .... X... ....
lotom  X... .... .... ....

[p7]
kick   .... .... X... ....
hhc    .... .... .... x...
hho    .... ..-. .... ....
hitom  .... .... x... Xx..
lotom  X... .... -... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
hhc    X... .... .... ....
hho    .... .... .... ..X.
hitom  .... .... .... x.X.
lotom  X... .... .... ....
