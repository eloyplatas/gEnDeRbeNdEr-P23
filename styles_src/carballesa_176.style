name: CARBALLESA 176
meter: 6/8
# Galicia. Tempo sugerido: 176 BPM (negras; compas 6/8).
# Carballesa (redonda, do Courel), 6/8: bailase sempre en roda, viva.
# Voces: kick=bombo · snare=tamboril/caixa · clap=pel da pandeireta, cunchas ou palmas
# hhc=ferrenas (pandeireta) · hho=xiro/arrastre de ferrenas · lotom/hitom=baixo (ronco, bordon).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X.X. X.X.X.

[p1]
kick   X..... ......
snare  X...X. X...X.
clap   ...... X...X.
hhc    X.X.X. X.X.X.
lotom  X..... ......

[p2]                         # ENERGIA
kick   X....x X.X...
snare  X.oxXo X.oxX.
clap   .....o X.....
hhc    X-X-X- X-X-X-
hho    ...... ....X.
hitom  ..-... ..-...
lotom  X...X. X...X.

[p3]
kick   X....x X.XX..
snare  X.oxXo X.oxXo
clap   .....o X..oX.
hhc    X-X-X- X-X-X-
hho    ...... ....X.
hitom  ..-... ..X...
lotom  X...X. X...X.

[p4]                         # BASE
kick   X..... X.X...
snare  X.oxX. X.oxX.
clap   ...... X.....
hhc    X.X.X. X.X.X.
hitom  ..-... ..-...
lotom  X...x. X...x.

[p5]
kick   X..... X.X...
snare  X.oxX. X.oxXo
clap   ...... X...X.
hhc    X.X.X. X.X.X.
hitom  ..-... ..X...
lotom  X...x. X...X.

[p6]                         # VARIACION
kick   X..... X.X...
snare  ...... X.....
clap   X.oxX. X.oxX.
hhc    X.X... X.X...
hho    ....X. ....X.
hitom  ..-... ..-...
lotom  X...x. X...x.

[p7]
kick   X..... X.X...
snare  ...... X...X.
clap   X.oxX. X.oxXo
hhc    X.X... X.X...
hho    ....X. ....X.
hitom  ..-... ..Xx..
lotom  X...x. X...Xo

[p8]                         # FILL
kick   X..... X.....
snare  ...... ooxxXX
clap   ...... .....X
hhc    X.X.X. X.X.X.
hho    X..... ......
hitom  XxX... ......
lotom  ...xXx ......
