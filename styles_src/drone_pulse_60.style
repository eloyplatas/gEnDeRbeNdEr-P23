name: DRONE PULSE 60
# Ambient. Tempo sugerido: 60 BPM.
# Drone: un so latexo grave por compas e textura de hats ao fondo.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    .... .... -... -...

[p1]
hhc    .... -... .... -...
hho    .... .... X... ....
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x .... ....
hhc    o-o- o-o- --o- --o-
hho    .... .... .... ..X.
lotom  X... .... .... ....

[p3]
hhc    o-o- --o- o-o- --o-
hho    .... .... X... ..X.
hitom  .... .... .... ..X.
lotom  X... .... .... ....

[p4]                         # BASE
kick   X... .... .... ....
hhc    .... .... -... -...
lotom  X... .... .... ....

[p5]
hhc    .... -... .... -...
hho    .... .... X... ....
lotom  X... .... .... ....

[p6]                         # VARIACION
kick   X... .... .... ....
hhc    .... .... -... -...
lotom  X... .... .... ....

[p7]
hhc    .... -... .... -...
hho    .... .... X... ....
hitom  .... .... .... Xx..
lotom  X... .... .... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
hhc    .... .... -... -...
hho    .... .... .... ..X.
hitom  .... .... .... x.X.
lotom  X... .... .... ....
