name: CHA CHA CHA 120
# Latin America & Caribbean. Tempo sugerido: 120 BPM.
# Cha-cha-cha: guiro en corcheas e o "cha-cha-cha" no 4 e.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.xx X.xx X.xx X.xx

[p1]
kick   X... .... .... ....
snare  .... X... .... X.X.
clap   X... X... X... X.X.
hhc    X.xx X.xx X.xx X.xx
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x X... ....
snare  ...o X... ...o XoX.
clap   X..o X..o X..o XoX.
hhc    X-XX X-XX X-XX X-XX
hho    .... .... .... ..X.
lotom  X... .... X... X.X.

[p3]
kick   X... ...x X... .X..
snare  ...o X... ...o XoX.
clap   X..o X..o X..o XoX.
hhc    X-XX X-XX X-XX X-XX
hho    .... .... .... ..X.
lotom  X... .... X... X.X.

[p4]                         # BASE
kick   X... .... X... ....
snare  .... X... .... X.X.
clap   X... X... X... X.X.
hhc    X.xx X.xx X.xx X.xx
lotom  X... .... X... X.X.

[p5]
kick   X... .... X... ....
snare  .... X... .... X.X.
clap   X... X... X... X.X.
hhc    X.xx X.xx X.xx X.xx
lotom  X... .... X... X.X.

[p6]                         # VARIACION
kick   X... .... X... ....
snare  X... X... X... X.X.
clap   .... X... .... X.X.
hhc    X..x X..x X..x X..x
hho    ..x. ..x. ..x. ..x.
lotom  X... .... X... X.X.

[p7]
kick   X... .... X... ....
snare  X... X... X... X.X.
clap   .... X... .... X.X.
hhc    X..x X..x X..x X..x
hho    ..x. ..x. ..x. ..x.
hitom  .... .... .... .x..
lotom  X... .... X... X.Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
