name: DARK TRIP HOP 72
# Trip hop & downtempo. Tempo sugerido: 72 BPM.
# Trip hop escuro: caixa so no 3, hats fantasma.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    -x-x -x-x -x-x -x-x

[p1]
kick   X... .... .... ....
snare  .... .... X... ....
hhc    -x-x -x-x -x-x -x-x
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x ..X. ....
snare  .... ...o X... ....
hhc    XxXx XxXx XxXx XxXx
hho    .... .... .... ..X.
lotom  X... .... ..X. ....

[p3]
kick   X... ...x ..X. .X..
snare  .... ...o X... ....
hhc    XxXx XxXx XxXx XxXx
hho    .... .... .... ..X.
hitom  .... .... .... ..X.
lotom  X... .... ..X. ....

[p4]                         # BASE
kick   X... .... ..X. ....
snare  .... .... X... ....
hhc    -x-x -x-x -x-x -x-x
lotom  X... .... ..X. ....

[p5]
kick   X... .... ..X. .X..
snare  .... .... X... ....
hhc    -x-x -x-x -x-x -x-x
lotom  X... .... ..X. ....

[p6]                         # VARIACION
kick   X... .... ..X. ....
snare  .... .... X... ....
hhc    -x.x -x.x -x.x -x.x
hho    ..-. ..-. ..-. ..-.
lotom  X... .... ..X. ....

[p7]
kick   X... .... ..X. .X..
snare  .... .... X... ....
hhc    -x.x -x.x -x.x -x.x
hho    ..-. ..-. ..-. ..-.
hitom  .... .... .... Xx..
lotom  X... .... ..X. ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
