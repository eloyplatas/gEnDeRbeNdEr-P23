name: DISCO 118
# House & disco. Tempo sugerido: 118 BPM.
# Disco: bombo a negras, caixa no 2 e 4, hat aberto a contratempo e baixo en oitavas.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    XxXx XxXx XxXx XxXx
hho    ..X. ..X. ..X. ..X.

[p1]
kick   X... .... .... ....
snare  .... X... .... X...
hhc    XxXx XxXx XxXx XxXx
hho    ..X. ..X. ..X. ..X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... X..x X... X...
snare  ...o X... ...o X...
hhc    XXXX XXXX XXXX XXXX
hho    ..X. ..X. ..X. ..X.
hitom  ..X. ..X. ..X. ..X.
lotom  X... X... X... X...

[p3]
kick   X... X..x X... XX..
snare  ...o X... ...o X...
hhc    XXXX XXXX XXXX XXXX
hho    ..X. ..X. ..X. ..X.
hitom  ..X. ..X. ..X. ..X.
lotom  X... X... X... X...

[p4]                         # BASE
kick   X... X... X... X...
snare  .... X... .... X...
hhc    XxXx XxXx XxXx XxXx
hho    ..X. ..X. ..X. ..X.
hitom  ..X. ..X. ..X. ..X.
lotom  X... X... X... X...

[p5]
kick   X... X... X... X...
snare  .... X... .... X...
hhc    XxXx XxXx XxXx XxXx
hho    ..X. ..X. ..X. ..X.
hitom  ..X. ..X. ..X. ..X.
lotom  X... X... X... X...

[p6]                         # VARIACION
kick   X... X... X... X...
snare  .... X... .... X...
hhc    XxXx XxXx XxXx XxXx
hho    ..X. ..X. ..X. ..X.
hitom  ..X. ..X. ..X. ..X.
lotom  X... X... X... X...

[p7]
kick   X... X... X... X...
snare  .... X... .... X...
hhc    XxXx XxXx XxXx XxXx
hho    ..X. ..X. ..X. ..X.
hitom  ..X. ..X. ..X. .xX.
lotom  X... X... X... X..o

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
