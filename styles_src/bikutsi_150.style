name: BIKUTSI 150
meter: 6/8
# African traditional. Tempo sugerido: 150 BPM (negras; compas 6/8).
# Bikutsi (Camerun), 6/8 rapido sentido en catro: guitarras como balafon.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.XX.X X.XX.X

[p1]
kick   X..... ......
snare  ...... X..X..
hhc    X.XX.X X.XX.X
lotom  X..... ......

[p2]                         # ENERGIA
kick   X..X.x X..X..
snare  .....o X.....
hhc    X-XXoX X-XXoX
hho    ...... ....X.
lotom  X..X.. X..X..

[p3]
kick   X..X.x X..X..
snare  .....o X.oX..
hhc    X-XXoX X-XXoX
hho    ...... ....X.
hitom  ...... ....X.
lotom  X..X.. X..X..

[p4]                         # BASE
kick   X..X.. X..X..
snare  ...... X.....
hhc    X.XX.X X.XX.X
lotom  X..X.. X..X..

[p5]
kick   X..X.. X..X..
snare  ...... X..X..
hhc    X.XX.X X.XX.X
lotom  X..X.. X..X..

[p6]                         # VARIACION
kick   X..X.. X..X..
snare  ...... X.....
hhc    X.XX.X X.XX.X
hitom  ...... ...X..
lotom  X..X.. X.....

[p7]
kick   X..X.. X..X..
snare  ...... X..X..
hhc    X.XX.X X.XX.X
hitom  ...... ..XX..
lotom  X..X.. X...Xo

[p8]                         # FILL
kick   X..... X.....
snare  ...... ooxxXX
clap   ...... .....X
hhc    X.XX.X X.XX.X
hho    X..... ......
hitom  XxX... ......
lotom  ...xXx ......
