name: ALBORADA 100
# Galicia. Tempo sugerido: 100 BPM.
# Alborada, 2/4 (dous compases por compas de 4/4): instrumental, ao amencer.
# Cuarteto de gaita: bombo nos pulsos fortes e tamboril con redobres.
# Voces: kick=bombo · snare=tamboril/caixa · clap=pel da pandeireta, cunchas ou palmas
# hhc=ferrenas (pandeireta) · hho=xiro/arrastre de ferrenas · lotom/hitom=baixo (ronco, bordon).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X... .... X... ....

[p1]
kick   X... .... .... ....
snare  X... X... X... X.XX
hhc    X... .... X... ....
hho    .... .... .... ..x.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x X... ....
snare  X..o X.oo X..o X.ox
hhc    X-o- o-o- X-o- o-o-
hho    .... .... .... ..X.
hitom  .... .... x... ....
lotom  X... .... X... ....

[p3]
kick   X... ...x X... .X..
snare  X..o X.oo Xooo XoXX
hhc    X-o- o-o- X-o- o-o-
hho    .... .... .... ..x.
hitom  .... .... x... ..X.
lotom  X... .... X... ....

[p4]                         # BASE
kick   X... .... X... ....
snare  X..o X.o. X..o X.ox
hhc    X... .... X... ....
hitom  .... .... x... ....
lotom  X... .... X... ....

[p5]
kick   X... .... X... ....
snare  X..o X.o. Xooo X.XX
hhc    X... .... X... ....
hho    .... .... .... ..x.
hitom  .... .... x... ....
lotom  X... .... X... ....

[p6]                         # VARIACION
kick   X... .... X... ....
snare  X..o X.o. X..o X.ox
hhc    X... .... X... ....
hitom  .... .... x... ....
lotom  X... .... X... ....

[p7]
kick   X... .... X... ....
snare  X..o X.o. Xooo X.XX
hhc    X... .... X... ....
hho    .... .... .... ..x.
hitom  .... .... x... Xx..
lotom  X... .... X... ..Xo

[p8]                         # FILL
kick   X... X... X... X...
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X... .... X... ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
