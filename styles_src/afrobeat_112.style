name: AFROBEAT 112
# Africa. Tempo sugerido: 112 BPM.
# Afrobeat (Tony Allen): bombo sincopado, caixa con fantasmas e hats abertos/pechados.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X.x. X.X. X.x.
hho    ..X. .... ...X ....

[p1]
kick   X... .... .... ....
snare  .... X... .... X...
hhc    X.X. X.x. X.X. X.x.
hho    ..X. .... ...X ....
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...X ..X. ...x
snare  ...o X..o .o.o X..o
hhc    X-X- X-X- X-X- X-X-
hho    ..X. .... ...X ..X.
hitom  .... .... ..x. ....
lotom  X..X ..X. ..X. X...

[p3]
kick   X... ...X ..X. XX..
snare  ...o X..o .o.o X.oo
clap   .... .... .... ..x.
hhc    X-X- X-X- X-X- X-X-
hho    ..X. .... ...X ..X.
hitom  .... .... .... .xX.
lotom  X..X ..X. ..X. .X..

[p4]                         # BASE
kick   X... ...X ..X. ...x
snare  .... X..o .o.. X..o
hhc    X.X. X.x. X.X. X.x.
hho    ..X. .... ...X ....
hitom  .... .... ..x. ....
lotom  X..X ..X. ..X. X...

[p5]
kick   X... ...X ..X. X...
snare  .... X..o .o.. X.oo
clap   .... .... .... ..x.
hhc    X.X. X.x. X.X. X.x.
hho    ..X. .... ...X ....
hitom  .... .... .... .x..
lotom  X..X ..X. ..X. .X..

[p6]                         # VARIACION
kick   X... ...X ..X. ...x
snare  .... X..o .o.. X..o
hhc    X.X. X... X... X...
hho    ..X. ..x. ..XX ..x.
hitom  .... .... ..x. ....
lotom  X..X ..X. ..X. X...

[p7]
kick   X... ...X ..X. X...
snare  .... .... .... ..x.
clap   .... X..o .o.. X.oo
hhc    X.X. X... X... X...
hho    ..X. ..x. ..XX ..x.
hitom  .... .... .... Xx..
lotom  X..X ..X. ..X. .XXo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
