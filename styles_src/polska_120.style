name: POLSKA 120
meter: 3/4
# European folk. Tempo sugerido: 120 BPM (negras; compas 3/4).
# Polska sueca, 3/4: o un e o tres pesados, o dous lixeiro.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X.X. X.X.

[p1]
kick   X... .... ....
hhc    X.X. X.X. X.X.
lotom  X... .... ....

[p2]                         # ENERGIA
kick   X... .x.. X...
clap   .... x... ....
hhc    X-X- X-X- X-X-
hho    .... .... ..X.
lotom  X... .... X...

[p3]
kick   X... .x.. XX..
clap   .... x... ....
hhc    X-X- X-X- X-X-
hho    .... .... ..X.
hitom  .... .... ..X.
lotom  X... .... X...

[p4]                         # BASE
kick   X... .... X...
clap   .... x... ....
hhc    X.X. X.X. X.X.
lotom  X... .... X...

[p5]
kick   X... .... X...
clap   .... x... ....
hhc    X.X. X.X. X.X.
lotom  X... .... X...

[p6]                         # VARIACION
kick   X... .... X...
clap   .... x... ....
hhc    X... X... X...
hho    ..X. ..X. ..X.
lotom  X... .... X...

[p7]
kick   X... .... X...
clap   .... x... ....
hhc    X... X... X...
hho    ..X. ..X. ..X.
hitom  .... .... .x..
lotom  X... .... X.Xo

[p8]                         # FILL
kick   X... X... X...
snare  .... .... ooxX
clap   .... .... ...X
hhc    X.X. X.X. X.X.
hho    X... .... ....
hitom  .... Xx.. ....
lotom  .... ..Xx ....
