name: BROSTEP 150
# Club & bass. Tempo sugerido: 150 BPM.
# Brostep: medio tempo agresivo, bombos dobres e caixa no 3.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X.X. X.X. X.X.

[p1]
kick   X... .... .... ....
snare  .... .... X..X .X.X
hhc    X.X. X.X. X.X. X.X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X.X. ...x ..X. X...
snare  .... ...o X... ....
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
lotom  X.X. X.X. X.X. X.X.

[p3]
kick   X.X. ..Xx ..X. XX..
snare  .... ...o X.oX oXoX
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
lotom  XXXX XXXX XXXX XXXX

[p4]                         # BASE
kick   X.X. .... ..X. X...
snare  .... .... X... ....
hhc    X.X. X.X. X.X. X.X.
lotom  X.X. X.X. X.X. X.X.

[p5]
kick   X.X. ..X. ..X. X...
snare  .... .... X..X .X.X
hhc    X.X. X.X. X.X. X.X.
lotom  XXXX XXXX XXXX XXXX

[p6]                         # VARIACION
kick   X.X. .... ..X. X...
snare  .... .... X... ....
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
lotom  X.X. X.X. X.X. X.X.

[p7]
kick   X.X. ..X. ..X. X...
snare  .... .... X..X .X.X
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .X.X .X.X
lotom  XXXX XXXX X.X. X.X.

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
