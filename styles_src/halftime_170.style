name: HALFTIME 170
# Breaks, jungle & drum & bass. Tempo sugerido: 170 BPM.
# Halftime: caixa so no terceiro pulso, bombo pesado.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X.X. X.X. X.X.

[p1]
kick   X... .... .... ....
snare  .... .... X... ....
hhc    X.X. X.X. X.Xx XxXx
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x X.X. ....
snare  .... ...o X... ....
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
lotom  X... .... X.X. ....

[p3]
kick   X... ...x X... .XX.
snare  .... ...o X... ....
hhc    X-X- X-X- X-XX XXXX
hho    .... .... .... ..X.
lotom  X... .... X... ..X.

[p4]                         # BASE
kick   X... .... X.X. ....
snare  .... .... X... ....
hhc    X.X. X.X. X.X. X.X.
lotom  X... .... X.X. ....

[p5]
kick   X... .... X... ..X.
snare  .... .... X... ....
hhc    X.X. X.X. X.Xx XxXx
lotom  X... .... X... ..X.

[p6]                         # VARIACION
kick   X... .... X.X. ....
snare  .... .... X... ....
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
lotom  X... .... X.X. ....

[p7]
kick   X... .... X... ..X.
snare  .... .... X... ....
hhc    X... X... X..x Xx.x
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .... Xx..
lotom  X... .... X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
