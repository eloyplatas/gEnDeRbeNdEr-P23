name: XOTA DE PANDEIRETA 160
meter: 3/4
# Galicia. Tempo sugerido: 160 BPM (negras; compas 3/4).
# Xota de pandeireta, 3/4: so pandeiretas e voz; o bombo apenas suxire o un.
# Voces: kick=bombo · snare=tamboril/caixa · clap=pel da pandeireta, cunchas ou palmas
# hhc=ferrenas (pandeireta) · hho=xiro/arrastre de ferrenas · lotom/hitom=baixo (ronco, bordon).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.Xx X.Xx X.Xx
hho    .... .... x...

[p1]
kick   X... .... ....
clap   X... X... X...
hhc    X.Xx X.Xx X.Xx
hho    .... ..x. X...
lotom  X... .... ....

[p2]                         # ENERGIA
kick   o... .x.. ....
clap   X... ...o X...
hhc    X-XX X-XX X-XX
hho    .... .... x.X.
lotom  X... .... X...

[p3]
kick   o... .x.. .X..
clap   X..o X..o X...
hhc    X-XX X-XX X-XX
hho    .... ..x. X.X.
hitom  .... -... ..X.
lotom  X... .... X...

[p4]                         # BASE
kick   o... .... ....
clap   X... .... X...
hhc    X.Xx X.Xx X.Xx
hho    .... .... x...
lotom  X... .... X...

[p5]
kick   o... .... ....
clap   X... X... X...
hhc    X.Xx X.Xx X.Xx
hho    .... ..x. X...
hitom  .... -... ....
lotom  X... .... X...

[p6]                         # VARIACION
kick   o... .... ....
clap   X... .... X...
hhc    X..x X..x X..x
hho    ..X. ..X. x.X.
lotom  X... .... X...

[p7]
kick   o... .... ....
clap   X... X... X...
hhc    X..x X.Xx X..x
hho    ..X. ..x. X.X.
hitom  .... -... .x..
lotom  X... .... X.Xo

[p8]                         # FILL
kick   X... X... X...
snare  .... .... ooxX
clap   .... .... ...X
hhc    X.Xx X.Xx X.Xx
hho    X... .... ....
hitom  .... Xx.. ....
lotom  .... ..Xx ....
