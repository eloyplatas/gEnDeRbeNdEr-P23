name: AMBIENT TECHNO 115
# Ambient. Tempo sugerido: 115 BPM.
# Ambient techno: catro no chan amortecido e hats suaves.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    ..x. ..x. ..X. ..x.

[p1]
kick   X... .... .... ....
clap   .... .... .... X...
hhc    ..x. ..x. ..X. ..x.
hho    .... .... ..X. ....
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... x..x X... x...
hhc    o-X- o-X- o-X- o-X-
hho    .... .... .... ..X.
lotom  X... .... X... ....

[p3]
kick   X... x..x X... xX..
clap   .... .... ...o X...
hhc    o-X- o-X- o-X- o-X-
hho    .... .... ..X. ..X.
hitom  .... .... .... ..X.
lotom  X... .... X..X ....

[p4]                         # BASE
kick   X... x... X... x...
hhc    ..x. ..x. ..X. ..x.
lotom  X... .... X... ....

[p5]
kick   X... x... X... x...
clap   .... .... .... X...
hhc    ..x. ..x. ..X. ..x.
hho    .... .... ..X. ....
lotom  X... .... X..X ....

[p6]                         # VARIACION
kick   X... x... X... x...
hho    ..x. ..x. ..X. ..x.
lotom  X... .... X... ....

[p7]
kick   X... x... X... x...
clap   .... .... .... X...
hhc    .... .... ..X. ....
hho    ..x. ..x. ..X. ..x.
hitom  .... .... ...X Xx..
lotom  X... .... X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
hhc    ..x. ..x. ..X. ..x.
hho    .... .... .... ..X.
hitom  .... .... .... x.X.
lotom  X... .... .... ....
