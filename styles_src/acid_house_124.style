name: ACID HOUSE 124
# House & disco. Tempo sugerido: 124 BPM.
# Acid house (TR-808/303): baixo de semicorcheas con oitavas nos toms.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X.X. X.X. X.X.
hho    ..x. ..x. ..x. ..x.

[p1]
kick   X... .... .... ....
clap   .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
hho    ..x. ..x. ..x. ..x.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... X..x X... X...
clap   ...o X... ...o X...
hhc    X-X- X-X- X-X- X-X-
hho    ..x. ..x. ..x. ..x.
hitom  ...X ..X. .... .X..
lotom  X.XX .XX. X.X. XX.X

[p3]
kick   X... X..x X... XX..
clap   ...o X... ...o X...
hhc    X-X- X-X- X-X- X-X-
hho    ..x. ..x. ..x. ..x.
hitom  ..X. .X.. ...X ....
lotom  X.XX .XX. X.XX X.X.

[p4]                         # BASE
kick   X... X... X... X...
clap   .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
hho    ..x. ..x. ..x. ..x.
hitom  ...X ..X. .... .X..
lotom  X.XX .XX. X.X. XX.X

[p5]
kick   X... X... X... X...
clap   .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
hho    ..x. ..x. ..x. ..x.
hitom  ..X. .X.. ...X ....
lotom  X.XX .XX. X.XX X.X.

[p6]                         # VARIACION
kick   X... X... X... X...
clap   .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
hho    ..x. ..x. ..x. ..x.
hitom  ...X ..X. .... .X.X
lotom  X.XX .XX. X.X. XX..

[p7]
kick   X... X... X... X...
clap   .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
hho    ..x. ..x. ..x. ..x.
hitom  ..X. .X.. ...X .x..
lotom  X.XX .XX. X.XX X.Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
