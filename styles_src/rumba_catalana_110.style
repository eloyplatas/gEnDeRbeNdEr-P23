name: RUMBA CATALANA 110
# Iberia & Mediterranean. Tempo sugerido: 110 BPM.
# Rumba catalana: ventilador de guitarra (hhc), bongo e palmas a contratempo.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    XxXx XxXx XxXx XxXx

[p1]
kick   X... .... .... ....
snare  ..X. ..X. ..X. ..X.
clap   .... X... .... X...
hhc    XxXx XxXx XxXx XxXx
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ..Xx X... ..X.
snare  .oX. .oX. .oX. .oX.
clap   ...o X... ...o X...
hhc    XXXX XXXX XXXX XXXX
hho    .... .... .... ..X.
lotom  X... ..X. X... ....

[p3]
kick   X... ..Xx X... .XX.
snare  .oX. .oX. .oX. .oX.
clap   ...o X... ...o X...
hhc    XXXX XXXX XXXX XXXX
hho    .... .... .... ..X.
hitom  .... .... .... ..X.
lotom  X... ..X. X... ....

[p4]                         # BASE
kick   X... ..X. X... ..X.
snare  ..X. ..X. ..X. ..X.
clap   .... X... .... X...
hhc    XxXx XxXx XxXx XxXx
lotom  X... ..X. X... ....

[p5]
kick   X... ..X. X... ..X.
snare  ..X. ..X. ..X. ..X.
clap   .... X... .... X...
hhc    XxXx XxXx XxXx XxXx
lotom  X... ..X. X... ....

[p6]                         # VARIACION
kick   X... ..X. X... ..X.
snare  .... X... .... X...
clap   ..X. ..X. ..X. ..X.
hhc    Xx.x Xx.x Xx.x Xx.x
hho    ..X. ..X. ..X. ..X.
lotom  X... ..X. X... ....

[p7]
kick   X... ..X. X... ..X.
snare  .... X... .... X...
clap   ..X. ..X. ..X. ..X.
hhc    Xx.x Xx.x Xx.x Xx.x
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .... Xx..
lotom  X... ..X. X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
