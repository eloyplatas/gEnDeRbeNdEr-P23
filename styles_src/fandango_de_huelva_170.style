name: FANDANGO DE HUELVA 170
meter: 3/4
# Iberia & Mediterranean. Tempo sugerido: 170 BPM (negras; compas 3/4).
# Fandango de Huelva, 3/4: palmas, cajon e castanuelas.
# Voces: clap=palmas · hhc=castanuelas.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.xx X.x. X.x.

[p1]
kick   X... .... ....
snare  .... X... X...
clap   X... X... X...
hhc    X.xx X.x. X.x.
lotom  X... .... ....

[p2]                         # ENERGIA
kick   X... .x.. ....
snare  ...o X..o X...
clap   X..o X..o X...
hhc    X-XX X-X- X-X-
hho    .... .... ..X.
lotom  X... .... ....

[p3]
kick   X... .x.. .X..
snare  ...o X.xo Xoxo
clap   X..o X..o X...
hhc    X-XX X-X- X-X-
hho    .... .... ..X.
hitom  .... .... ..X.
lotom  X... .... X...

[p4]                         # BASE
kick   X... .... ....
snare  .... X... X...
clap   X... X... X...
hhc    X.xx X.x. X.x.
lotom  X... .... ....

[p5]
kick   X... .... ....
snare  .... X.xo Xoxo
clap   X... X... X...
hhc    X.xx X.x. X.x.
lotom  X... .... X...

[p6]                         # VARIACION
kick   X... .... ....
snare  X... X... X...
clap   .... X... X...
hhc    X..x X... X...
hho    ..x. ..x. ..x.
lotom  X... .... ....

[p7]
kick   X... .... ....
snare  X... X... X...
clap   .... X.xo Xoxo
hhc    X..x X... X...
hho    ..x. ..x. ..x.
hitom  .... .... .x..
lotom  X... .... X.Xo

[p8]                         # FILL
kick   X... X... X...
snare  .... .... ooxX
clap   .... .... ...X
hhc    X.xx X.x. X.x.
hho    X... .... ....
hitom  .... Xx.. ....
lotom  .... ..Xx ....
