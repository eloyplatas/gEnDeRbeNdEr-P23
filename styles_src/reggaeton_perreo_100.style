name: REGGAETON PERREO 100
# Latin America & Caribbean. Tempo sugerido: 100 BPM.
# Perreo: dembow cheo con palmas e baixo de 808.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    XxXx XxXx XxXx XxXx

[p1]
kick   X... .... .... ....
snare  ...X ..X. ...X ..X.
clap   ...X ..X. ...X .XX.
hhc    XxXx XxXx XxXx XxXx
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... X..x X... X...
snare  ..oX .oX. ..oX .oX.
clap   ..oX .oX. ..oX .oX.
hhc    XXXX XXXX XXXX XXXX
hho    .... .... .... ..X.
lotom  X..X ..X. ..X. .X..

[p3]
kick   X... X..x X... XX..
snare  ..oX .oX. ..oX .oX.
clap   ..oX .oX. ..oX oXX.
hhc    XXXX XXXX XXXX XXXX
hho    .... .... .... ..X.
hitom  .... .... .... ..X.
lotom  X..X ..X. ..X. X...

[p4]                         # BASE
kick   X... X... X... X...
snare  ...X ..X. ...X ..X.
clap   ...X ..X. ...X ..X.
hhc    XxXx XxXx XxXx XxXx
lotom  X..X ..X. ..X. .X..

[p5]
kick   X... X... X... X...
snare  ...X ..X. ...X ..X.
clap   ...X ..X. ...X .XX.
hhc    XxXx XxXx XxXx XxXx
lotom  X..X ..X. ..X. X...

[p6]                         # VARIACION
kick   X... X... X... X...
snare  ...X ..X. ...X ..X.
clap   ...X ..X. ...X ..X.
hhc    Xx.x Xx.x Xx.x Xx.x
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .... .X..
lotom  X..X ..X. ..X. ....

[p7]
kick   X... X... X... X...
snare  ...X ..X. ...X .XX.
clap   ...X ..X. ...X ..X.
hhc    Xx.x Xx.x Xx.x Xx.x
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .... .x..
lotom  X..X ..X. ..X. X.Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
