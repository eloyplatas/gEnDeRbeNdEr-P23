name: AMBIENT PULSE 70
# Ambient. Tempo sugerido: 70 BPM.
# Ambient: latexo de bombo moi suave e brillos soltos.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    ..-. ..x. .... -...
hho    .... .... X... ....

[p1]
kick   X... .... .... ....
hhc    .... ..-. ..x. ....
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x -... ....
hhc    o--- o-X- o-o- --o-
hho    .... .... X... ..X.
lotom  X... .... .... ....

[p3]
kick   X... ...x -... .X..
hhc    o-o- o--- o-X- o-o-
hho    .... .... .... ..X.
hitom  .... .... .... x.X.
lotom  X... .... X... ....

[p4]                         # BASE
kick   X... .... -... ....
hhc    ..-. ..x. .... -...
hho    .... .... X... ....
lotom  X... .... .... ....

[p5]
kick   X... .... -... ....
hhc    .... ..-. ..x. ....
hitom  .... .... .... x...
lotom  X... .... X... ....

[p6]                         # VARIACION
kick   X... .... -... ....
hhc    .... .... .... -...
hho    ..-. ..x. X... ....
lotom  X... .... .... ....

[p7]
kick   X... .... -... ....
hho    .... ..-. ..x. ....
hitom  .... .... .... xx..
lotom  X... .... X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
hhc    ..-. ..x. .... -...
hho    .... .... .... ..X.
hitom  .... .... .... x.X.
lotom  X... .... .... ....
