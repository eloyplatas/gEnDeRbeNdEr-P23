name: NOISE BLASTS 140
# IDM & experimental. Tempo sugerido: 140 BPM.
# Noise: explosions irregulares e silencios.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hho    X... .... X... ....

[p1]
kick   X... .... .... ....
snare  ..XX.... ...X.... .....XXX X....XX.
hho    .... X... ..X. ....
lotom  X... .... .... ....

