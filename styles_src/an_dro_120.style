name: AN DRO 120
# European folk. Tempo sugerido: 120 BPM.
# An dro (Bretana): danza en cadea, frase de 8 tempos con apoio no 1 e no 3.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X.X. X.X. X.X.

[p1]
kick   X... .... .... ....
hhc    X.X. X.X. X.X. X.X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x X... ....
snare  .... x... .... x...
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
lotom  X... .... X... ....

[p3]
kick   X... ...x X... XX..
snare  .... x... .... x...
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
hitom  .... .... .... ..X.
lotom  X... .... X... X...

[p4]                         # BASE
kick   X... .... X... ....
snare  .... x... .... x...
hhc    X.X. X.X. X.X. X.X.
lotom  X... .... X... ....

[p5]
kick   X... .... X... X...
snare  .... x... .... x...
hhc    X.X. X.X. X.X. X.X.
lotom  X... .... X... X...

[p6]                         # VARIACION
kick   X... .... X... ....
snare  .... x... .... x...
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
lotom  X... .... X... ....

[p7]
kick   X... .... X... X...
snare  .... x... .... x...
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .... .x..
lotom  X... .... X... X.Xo

[p8]                         # FILL
kick   X... X... X... X...
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. X.X.
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
