name: CUMBIA TROPICAL 104
# Cumbia. Tempo sugerido: 104 BPM.
# Cumbia tropical: guacharaca en semicorcheas, tambor alegre e baixo no 1 e 3.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    XxxX XxxX XxxX XxxX

[p1]
kick   X... .... .... ....
snare  ..X. ..X. ..X. .XX.
hhc    XxxX XxxX XxxX XxxX
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x X... ....
snare  .oX. .oX. .oX. .oX.
hhc    XXXX XXXX XXXX XXXX
hho    .... .... .... ..X.
hitom  .... .... .... ..X.
lotom  X... ..X. X... ..X.

[p3]
kick   X... ...x X... .X..
snare  .oX. .oX. .oX. oXX.
hhc    XXXX XXXX XXXX XXXX
hho    .... .... .... ..X.
hitom  .... .... ..X. ..X.
lotom  X... ..X. X... ....

[p4]                         # BASE
kick   X... .... X... ....
snare  ..X. ..X. ..X. ..X.
hhc    XxxX XxxX XxxX XxxX
hitom  .... .... .... ..X.
lotom  X... ..X. X... ..X.

[p5]
kick   X... .... X... ....
snare  ..X. ..X. ..X. .XX.
hhc    XxxX XxxX XxxX XxxX
hitom  .... .... ..X. ....
lotom  X... ..X. X... ....

[p6]                         # VARIACION
kick   X... .... X... ....
snare  ..X. ..X. ..X. ..X.
hhc    Xx.X Xx.X Xx.X Xx.X
hho    ..x. ..x. ..x. ..x.
hitom  .... .... .... ..X.
lotom  X... ..X. X... ..X.

[p7]
kick   X... .... X... ....
snare  ..X. ..X. ..X. .XX.
hhc    Xx.X Xx.X Xx.X Xx.X
hho    ..x. ..x. ..x. ..x.
hitom  .... .... ..X. Xx..
lotom  X... ..X. X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
