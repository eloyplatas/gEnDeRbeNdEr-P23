name: XOTA 168
meter: 3/4
# Galicia. Tempo sugerido: 168 BPM (negras; compas 3/4).
# Xota galega, 3/4: ferrenas en corcheas, pel nos pulsos 2 e 3, redobre de tamboril ao final.
# Voces: kick=bombo · snare=tamboril/caixa · clap=pel da pandeireta, cunchas ou palmas
# hhc=ferrenas (pandeireta) · hho=xiro/arrastre de ferrenas · lotom/hitom=baixo (ronco, bordon).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X.X. X.X.
hho    .... .... X...

[p1]
kick   X... .... ....
snare  .... .... ..X.
clap   .... X... X...
hhc    X.X. X.X. X.X.
hho    .... .... X.x.
lotom  X... .... ....

[p2]                         # ENERGIA
kick   X... .x.. ....
snare  .... .... ..oo
clap   ...o X..o X...
hhc    X-X- X-X- X-X-
hho    .... .... X.X.
hitom  .... x... ....
lotom  X... .... X...

[p3]
kick   X... .x.. xX..
snare  .... ..o. xoXo
clap   ...o X..o X...
hhc    X-X- X-X- X-X-
hho    .... .... X.x.
hitom  .... x... ..X.
lotom  X... X... X...

[p4]                         # BASE
kick   X... .... ....
snare  .... .... ..oo
clap   .... X... X...
hhc    X.X. X.X. X.X.
hho    .... .... X...
hitom  .... x... ....
lotom  X... .... X...

[p5]
kick   X... .... x...
snare  .... ..o. xoXo
clap   .... X... X...
hhc    X.X. X.X. X.X.
hho    .... .... X.x.
hitom  .... x... ....
lotom  X... X... X...

[p6]                         # VARIACION
kick   X... .... ....
snare  .... X... X...
clap   .... .... ..oo
hhc    X... X... X...
hho    ..X. ..X. X.X.
hitom  .... x... ....
lotom  X... .... X...

[p7]
kick   X... .... x...
snare  .... X... X...
clap   .... ..o. xoXo
hhc    X... X... X.X.
hho    ..X. ..X. X.x.
hitom  .... x... .x..
lotom  X... X... X.Xo

[p8]                         # FILL
kick   X... X... X...
snare  .... .... ooxX
clap   .... .... ...X
hhc    X.X. X.X. X.X.
hho    X... .... ....
hitom  .... Xx.. ....
lotom  .... ..Xx ....
