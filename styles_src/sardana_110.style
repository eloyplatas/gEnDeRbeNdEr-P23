name: SARDANA 110
meter: 6/8
# European folk. Tempo sugerido: 110 BPM (negras; compas 6/8).
# Sardana (Cataluna), 6/8 (tirada longa): tambori marcando e flabiol.
# Voces: snare=tambori.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X.X. X.X.X.

[p1]
kick   X..... ......
snare  X..... X...X.
hhc    X.X.X. X.X.X.
lotom  X..... ......

[p2]                         # ENERGIA
kick   X....x ......
snare  X...xo X...x.
hhc    X-X-X- X-X-X-
hho    ...... ....X.
lotom  X..... X.....

[p3]
kick   X....x X..X..
snare  X...xo X.xxX.
hhc    X-X-X- X-X-X-
hho    ...... ....X.
hitom  ...... ....X.
lotom  X..... X.....

[p4]                         # BASE
kick   X..... ......
snare  X...x. X...x.
hhc    X.X.X. X.X.X.
lotom  X..... X.....

[p5]
kick   X..... X.....
snare  X...x. X.xxX.
hhc    X.X.X. X.X.X.
lotom  X..... X.....

[p6]                         # VARIACION
kick   X..... ......
snare  X...x. X...x.
hhc    X.X... X.X...
hho    ....X. ....X.
lotom  X..... X.....

[p7]
kick   X..... X.....
snare  X...x. X.xxX.
hhc    X.X... X.X...
hho    ....X. ....X.
hitom  ...... ..Xx..
lotom  X..... X...Xo

[p8]                         # FILL
kick   X..... X.....
snare  ...... ooxxXX
clap   ...... .....X
hhc    X.X.X. X.X.X.
hho    X..... ......
hitom  XxX... ......
lotom  ...xXx ......
