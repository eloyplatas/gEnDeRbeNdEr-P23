name: VALS LENTO 90
meter: 3/4
# European folk. Tempo sugerido: 90 BPM (negras; compas 3/4).
# Vals lento (ingles), 3/4: un forte, pratos suaves.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.x. X.x. X.x.

[p1]
kick   X... .... ....
hhc    X.x. X.x. X.x.
lotom  X... .... ....

[p2]                         # ENERGIA
kick   X... .x.. ....
hhc    X-X- X-X- X-X-
hho    .... .... ..X.
lotom  X... .... ....

[p3]
kick   X... .x.. .X..
snare  .... .... -...
hhc    X-X- X-X- X-X-
hho    .... .... ..X.
hitom  .... .... ..X.
lotom  X... .... ....

[p4]                         # BASE
kick   X... .... ....
hhc    X.x. X.x. X.x.
lotom  X... .... ....

[p5]
kick   X... .... ....
snare  .... .... -...
hhc    X.x. X.x. X.x.
lotom  X... .... ....

[p6]                         # VARIACION
kick   X... .... ....
hhc    X... X... X...
hho    ..x. ..x. ..x.
lotom  X... .... ....

[p7]
kick   X... .... ....
snare  .... .... -...
hhc    X... X... X...
hho    ..x. ..x. ..x.
hitom  .... .... Xx..
lotom  X... .... ..Xo

[p8]                         # FILL
kick   X... .... ....
hhc    X.x. X.x. X.x.
hho    .... .... ..X.
hitom  .... .... x.X.
lotom  X... .... ....
