name: SOUKOUS 140
# Africa. Tempo sugerido: 140 BPM.
# Soukous (seben congoles): bombo a negras, caixa a contratempo e hats rapidos.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    XxXx XxXx XxXx XxXx

[p1]
kick   X... .... .... ....
snare  ..X. ..X. X.X. X.X.
hhc    XxXx XxXx XxXx XxXx
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... X..x X... X...
snare  .oX. .oXo XoX. .oX.
hhc    XXXX XXXX XXXX XXXX
hho    .... .... .... ..X.
lotom  X..X ..X. X..X ..X.

[p3]
kick   X... X..x X... XX..
snare  .oX. .oXo XoXo XoX.
hhc    XXXX XXXX XXXX XXXX
hho    .... .... .... ..X.
hitom  .... .... .... ..x.
lotom  X..X ..X. X..X ..X.

[p4]                         # BASE
kick   X... X... X... X...
snare  ..X. ..X. X.X. ..X.
hhc    XxXx XxXx XxXx XxXx
lotom  X..X ..X. X..X ..X.

[p5]
kick   X... X... X... X...
snare  ..X. ..X. X.X. X.X.
hhc    XxXx XxXx XxXx XxXx
hitom  .... .... .... ..x.
lotom  X..X ..X. X..X ..X.

[p6]                         # VARIACION
kick   X... X... X... X...
snare  ..X. ..X. X.X. ..X.
hhc    Xx.x Xx.x Xx.x Xx.x
hho    ..X. ..X. ..X. ..X.
hitom  .... .... ...X ....
lotom  X..X ..X. X... ..X.

[p7]
kick   X... X... X... X...
snare  ..X. ..X. X.X. X.X.
hhc    Xx.x Xx.x Xx.x Xx.x
hho    ..X. ..X. ..X. ..X.
hitom  .... .... ...X Xxx.
lotom  X..X ..X. X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
