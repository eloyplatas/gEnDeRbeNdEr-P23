name: HIGHLIFE 128
# Africa. Tempo sugerido: 128 BPM.
# Highlife (Ghana): campa de clave e baixo balanceado.
# Voces: hhc=campa (gankogui).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. XX.X .X.X X.X.

[p1]
kick   X... .... .... ....
snare  .... X... .... X...
hhc    X.X. XX.X .X.X X.X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x X... ....
snare  ...o X... ...o X...
hhc    X-X- XXoX oXoX X-X-
hho    .... .... .... ..X.
hitom  .... .... .... ..x.
lotom  X..X ..X. X..X ..X.

[p3]
kick   X... ...x X..X .X..
snare  ...o X... ...o X...
hhc    X-X- XXoX oXoX X-X-
hho    .... .... .... ..X.
hitom  .... .... ..x. ..X.
lotom  X..X ..X. X... ....

[p4]                         # BASE
kick   X... .... X... ....
snare  .... X... .... X...
hhc    X.X. XX.X .X.X X.X.
hitom  .... .... .... ..x.
lotom  X..X ..X. X..X ..X.

[p5]
kick   X... .... X..X ....
snare  .... X... .... X...
hhc    X.X. XX.X .X.X X.X.
hitom  .... .... ..x. ....
lotom  X..X ..X. X... ....

[p6]                         # VARIACION
kick   X... .... X... ....
snare  .... X... .... X...
hhc    X... XX.X .X.X X...
hho    ..X. .... .... ..X.
hitom  .... .... ...X ..x.
lotom  X..X ..X. X... ..X.

[p7]
kick   X... .... X..X ....
snare  .... X... .... X...
hhc    X... XX.X .X.X X...
hho    ..X. .... .... ..X.
hitom  .... .... ..x. Xx..
lotom  X..X ..X. X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
