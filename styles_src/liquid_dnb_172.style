name: LIQUID DNB 172
# Breaks, jungle & drum & bass. Tempo sugerido: 172 BPM.
# Liquid drum & bass: break suave, ride e baixo longo.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.Xx X.Xx X.Xx X.Xx
hho    ..X. .... ..X. ....

[p1]
kick   X... .... .... ....
snare  .... X... .... X...
hhc    X.Xx X.Xx X.Xx X.Xx
hho    ..X. .... ..X. ....
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x ..X. ....
snare  ...o X... ...o X...
hhc    X-XX X-XX X-XX X-XX
hho    ..X. .... ..X. ..X.
lotom  X... .... X..X ....

[p3]
kick   X... ...x X.X. .X..
snare  ...o X..o ...o X...
hhc    X-XX X-XX X-XX X-XX
hho    ..X. .... ..X. ..X.
hitom  .... .... .... ..X.
lotom  X... .... X... ....

[p4]                         # BASE
kick   X... .... ..X. ....
snare  .... X... .... X...
hhc    X.Xx X.Xx X.Xx X.Xx
hho    ..X. .... ..X. ....
lotom  X... .... X..X ....

[p5]
kick   X... .... X.X. ....
snare  .... X..o .... X...
hhc    X.Xx X.Xx X.Xx X.Xx
hho    ..X. .... ..X. ....
lotom  X... .... X... ....

[p6]                         # VARIACION
kick   X... .... ..X. ....
snare  .... X... .... X...
hhc    X.Xx X..x X.Xx X..x
hho    ..X. ..X. ..X. ..X.
hitom  .... .... ...X ....
lotom  X... .... X... ....

[p7]
kick   X... .... X.X. ....
snare  .... X..o .... X...
hhc    X.Xx X..x X.Xx X..x
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .... Xx..
lotom  X... .... X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
