name: MBALAX 125
# Africa. Tempo sugerido: 125 BPM.
# Mbalax (Senegal): sabar con frases cruzadas.
# Voces: snare/clap=sabar · lotom=mbeung-mbeung.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.x. X.x. X.x. X.x.

[p1]
kick   X... .... .... ....
snare  X.XX ..X. X.XX .XX.
clap   ...X .... ..X. ....
hhc    X.x. X.x. X.x. X.x.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ..Xx ..X. ....
snare  XoXX .oXo XoXX .oX.
clap   ..oX .... .oX. ....
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
hitom  ..X. .... ..-. .X..
lotom  X... ..X. ..X. ....

[p3]
kick   X... ..Xx ..X. .X..
snare  XoXX .oXo XoXX oXX.
clap   ..oX .... .oX. ....
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
hitom  ..X. .... ..-. .XX.
lotom  X... ..X. ..X. ....

[p4]                         # BASE
kick   X... ..X. ..X. ....
snare  X.XX ..X. X.XX ..X.
clap   ...X .... ..X. ....
hhc    X.x. X.x. X.x. X.x.
hitom  ..X. .... ..-. .X..
lotom  X... ..X. ..X. ....

[p5]
kick   X... ..X. ..X. .X..
snare  X.XX ..X. X.XX .XX.
clap   ...X .... ..X. ....
hhc    X.x. X.x. X.x. X.x.
hitom  ..X. .... ..-. .X..
lotom  X... ..X. ..X. ....

[p6]                         # VARIACION
kick   X... ..X. ..X. ....
snare  ...X .... ..X. ....
clap   X.XX ..X. X.XX ..X.
hhc    X... X... X... X...
hho    ..x. ..x. ..x. ..x.
hitom  ..X. .... ..-. .X..
lotom  X... ..X. ..X. ....

[p7]
kick   X... ..X. ..X. .X..
snare  ...X .... ..X. ....
clap   X.XX ..X. X.XX .XX.
hhc    X... X... X... X...
hho    ..x. ..x. ..x. ..x.
hitom  ..X. .... ..-. XX..
lotom  X... ..X. ..X. ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
