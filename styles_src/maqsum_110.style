name: MAQSUM 110
# Iberia & Mediterranean. Tempo sugerido: 110 BPM.
# Maqsum (Exipto): D T . T D . T . — darbuka con ka de adorno.
# Voces: kick=dum · snare=tek · hhc=riq.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.xx X.xx X.xx X.xx

[p1]
kick   X... .... .... ....
snare  ..X. ..X. .... X...
hhc    X.xx X.xx X.xx X.xx
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x X... ....
snare  .oX. .oX. ...o X...
clap   -... -... -... -...
hhc    X-XX X-XX X-XX X-XX
hho    .... .... .... ..X.
lotom  X... .... X... ....

[p3]
kick   X... ...x X... .X..
snare  .oX. .oX. ...o X.-.
clap   -... -... -... -...
hhc    X-XX X-XX X-XX X-XX
hho    .... .... .... ..X.
hitom  .... .... .... ..X.
lotom  X... .... X... ....

[p4]                         # BASE
kick   X... .... X... ....
snare  ..X. ..X. .... X...
clap   -... -... -... -...
hhc    X.xx X.xx X.xx X.xx
lotom  X... .... X... ....

[p5]
kick   X... .... X... ....
snare  ..X. ..X. .... X.-.
clap   -... -... -... -...
hhc    X.xx X.xx X.xx X.xx
lotom  X... .... X... ....

[p6]                         # VARIACION
kick   X... .... X... ....
snare  -... -... -... -...
clap   ..X. ..X. .... X...
hhc    X..x X..x X..x X..x
hho    ..x. ..x. ..x. ..x.
lotom  X... .... X... ....

[p7]
kick   X... .... X... ....
snare  -... -... -... -...
clap   ..X. ..X. .... X.-.
hhc    X..x X..x X..x X..x
hho    ..x. ..x. ..x. ..x.
hitom  .... .... .... Xx..
lotom  X... .... X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
