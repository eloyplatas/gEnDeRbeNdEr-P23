name: MUINEIRA DE ROMARIA 186
meter: 6/8
# Galicia. Tempo sugerido: 186 BPM (negras; compas 6/8).
# Muineira de romaria, 6/8: bombo forte, caixa redobrando e pandeiretas a encher.
# Voces: kick=bombo · snare=tamboril/caixa · clap=pel da pandeireta, cunchas ou palmas
# hhc=ferrenas (pandeireta) · hho=xiro/arrastre de ferrenas · lotom/hitom=baixo (ronco, bordon).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X.X. X.X.X.
hho    ....x. ....x.

[p1]
kick   X..... ......
snare  X...X. X...XX
hhc    X.X.X. X.X.X.
hho    ....x. ....X.
lotom  X..... ......

[p2]                         # ENERGIA
kick   X....x X.....
snare  XoxoXo XoxoX.
clap   ..x... ..x...
hhc    X-X-X- X-X-X-
hho    ....x. ....x.
hitom  ...... x.....
lotom  X..... X.....

[p3]
kick   X....x X.XXX.
snare  XoxoXo XoxoXX
clap   ..x... ..x...
hhc    X-X-X- X-X-X-
hho    ....x. ....X.
hitom  ...... ....x.
lotom  X..... X.....

[p4]                         # BASE
kick   X..... X.....
snare  XoxoX. XoxoX.
clap   ..x... ..x...
hhc    X.X.X. X.X.X.
hho    ....x. ....x.
hitom  ...... x.....
lotom  X..... X.....

[p5]
kick   X..... X.X.X.
snare  XoxoX. XoxoXX
clap   ..x... ..x...
hhc    X.X.X. X.X.X.
hho    ....x. ....X.
hitom  ...... ....x.
lotom  X..... X.....

[p6]                         # VARIACION
kick   X..... X.....
snare  ..x... ..x...
clap   XoxoX. XoxoX.
hhc    X.X.X. X.X.X.
hho    ....x. ....x.
hitom  ...... x.....
lotom  X..... X.....

[p7]
kick   X..... X.X.X.
snare  ..x... ..x...
clap   XoxoX. XoxoXX
hhc    X.X.X. X.X.X.
hho    ....x. ....X.
hitom  ...... ..Xxx.
lotom  X..... X....o

[p8]                         # FILL
kick   X..... X.....
snare  ...... ooxxXX
clap   ...... .....X
hhc    X.X.X. X.X.X.
hho    X..... ......
hitom  XxX... ......
