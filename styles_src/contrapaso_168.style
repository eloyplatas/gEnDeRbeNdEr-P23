name: CONTRAPASO 168
meter: 6/8
# Galicia. Tempo sugerido: 168 BPM (negras; compas 6/8).
# Contrapaso, 6/8: danza de moitas parellas con guias, andar solemne.
# Voces: kick=bombo · snare=tamboril/caixa · clap=pel da pandeireta, cunchas ou palmas
# hhc=ferrenas (pandeireta) · hho=xiro/arrastre de ferrenas · lotom/hitom=baixo (ronco, bordon).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X...X. X...X.

[p1]
kick   X..... ......
snare  X..... X.X...
hhc    X...X. X...X.
hho    ...... ...x..
lotom  X..... ......

[p2]                         # ENERGIA
kick   X....x X.....
snare  X.o.xo X.o.x.
hhc    X-o-X- X-o-X-
hho    ...... ....X.
hitom  ....-. ....-.
lotom  X..... X.....

[p3]
kick   X....x ...X..
snare  X.o.xo XoXox.
hhc    X-o-X- X-o-X-
hho    ...... ...xX.
hitom  ....-. ....X.
lotom  X..... X..X..

[p4]                         # BASE
kick   X..... X.....
snare  X.o.x. X.o.x.
hhc    X...X. X...X.
hitom  ....-. ....-.
lotom  X..... X.....

[p5]
kick   X..... ...X..
snare  X.o.x. XoXox.
hhc    X...X. X...X.
hho    ...... ...x..
hitom  ....-. ......
lotom  X..... X..X..

[p6]                         # VARIACION
kick   X..... X.....
snare  X.o.x. X.o.x.
hhc    X..... X.....
hho    ....X. ....X.
hitom  ....-. ....-.
lotom  X..... X.....

[p7]
kick   X..... ...X..
snare  X.o.x. XoXox.
hhc    X..... X.....
hho    ....X. ...xX.
hitom  ....-. ..XX..
lotom  X..... X...Xo

[p8]                         # FILL
kick   X..... X.....
snare  ...... ooxxXX
clap   ...... .....X
hhc    X...X. X...X.
hho    X..... ......
hitom  XxX... ......
lotom  ...xXx ......
