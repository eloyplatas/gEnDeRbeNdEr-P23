name: GUAGUANCO 105
# Latin America & Caribbean. Tempo sugerido: 105 BPM.
# Rumba guaguanco: clave de rumba 3-2, tumbadora e quinto.
# Voces: clap=clave · toms=tumbadoras.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X.X. X.X. X.X.

[p1]
snare  .... ..X. .... ..X.
clap   X..X ...X ..X. X...
hhc    X.X. X.X. X.X. X.X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
snare  .... .oX. .... .oX.
clap   X.oX ..oX .oXo X...
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
hitom  ..X. X... ...X .X..
lotom  X... ..X. ..X. ....

[p3]
snare  ...x .oX. ...x .oX.
clap   X.oX ..oX .oXo X...
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
hitom  ..X. X... ...X .XX.
lotom  X... ..X. ..X. ....

[p4]                         # BASE
snare  .... ..X. .... ..X.
clap   X..X ...X ..X. X...
hhc    X.X. X.X. X.X. X.X.
hitom  ..X. X... ...X .X..
lotom  X... ..X. ..X. ....

[p5]
snare  ...x ..X. ...x ..X.
clap   X..X ...X ..X. X...
hhc    X.X. X.X. X.X. X.X.
hitom  ..X. X... ...X .XX.
lotom  X... ..X. ..X. ....

[p6]                         # VARIACION
snare  X..X ...X ..X. X...
clap   .... ..X. .... ..X.
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
hitom  ..X. X... ...X .X..
lotom  X... ..X. ..X. ....

[p7]
snare  X..X ...X ..X. X...
clap   ...x ..X. ...x ..X.
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
hitom  ..X. X... ...X XXX.
lotom  X... ..X. ..X. ...o

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
