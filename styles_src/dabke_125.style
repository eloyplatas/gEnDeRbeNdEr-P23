name: DABKE 125
# Iberia & Mediterranean. Tempo sugerido: 125 BPM.
# Dabke levantino: tabl con dum en 1, 4 e 5, e teks sincopados; riq en corcheas.
# Voces: kick=dum · snare=tek · hhc=riq.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X.X. X.X. X.X.

[p1]
kick   X... .... .... ....
snare  ...X .... ..X. X.X.
hhc    X.X. X.X. X.X. X.X.
hho    .... .... .... ..x.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ..Xx X... ....
snare  ..oX .... .oX. .oX.
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
lotom  X... ..X. X... ....

[p3]
kick   X... ..Xx X... .X..
snare  ..oX .... .oXo XoX.
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..x.
hitom  .... .... .... ..X.
lotom  X... ..X. X... ....

[p4]                         # BASE
kick   X... ..X. X... ....
snare  ...X .... ..X. ..X.
hhc    X.X. X.X. X.X. X.X.
lotom  X... ..X. X... ....

[p5]
kick   X... ..X. X... ....
snare  ...X .... ..X. X.X.
hhc    X.X. X.X. X.X. X.X.
hho    .... .... .... ..x.
lotom  X... ..X. X... ....

[p6]                         # VARIACION
kick   X... ..X. X... ....
snare  ...X .... ..X. ..X.
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
lotom  X... ..X. X... ....

[p7]
kick   X... ..X. X... ....
snare  ...X .... ..X. X.X.
hhc    X... X... X... X.X.
hho    ..X. ..X. ..X. ..x.
hitom  .... .... .... Xx..
lotom  X... ..X. X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
