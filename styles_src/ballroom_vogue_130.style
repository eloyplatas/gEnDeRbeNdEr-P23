name: BALLROOM VOGUE 130
# Club & bass. Tempo sugerido: 130 BPM.
# Ballroom (vogue): o "ha" de prato no un, bombo partido e palmas.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    ..X. ..X. ..X. ..X.
hho    X... .... .... ....

[p1]
kick   X... .... .... ....
clap   .... X..X .... X...
hhc    ..X. ..X. ..X. ..X.
hho    X... .... .... X...
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...x X..X ....
clap   ...o X.oX ...o X...
hhc    o-X- o-X- o-X- o-X-
hho    X... .... .... ..X.
lotom  X... .... X..X ....

[p3]
kick   X... ...x X..X .XX.
clap   ...o X.oX ...o X...
hhc    o-X- o-X- o-X- o-X-
hho    X... .... .... X.X.
hitom  .... .... .... ..X.
lotom  X... .... X..X ....

[p4]                         # BASE
kick   X... .... X..X ....
clap   .... X..X .... X...
hhc    ..X. ..X. ..X. ..X.
hho    X... .... .... ....
lotom  X... .... X..X ....

[p5]
kick   X... .... X..X ..X.
clap   .... X..X .... X...
hhc    ..X. ..X. ..X. ..X.
hho    X... .... .... X...
lotom  X... .... X..X ....

[p6]                         # VARIACION
kick   X... .... X..X ....
clap   .... X..X .... X...
hho    X.X. ..X. ..X. ..X.
hitom  .... .... ...X ....
lotom  X... .... X... ....

[p7]
kick   X... .... X..X ..X.
clap   .... X..X .... X...
hho    X.X. ..X. ..X. X.X.
hitom  .... .... ...X Xx..
lotom  X... .... X... ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
