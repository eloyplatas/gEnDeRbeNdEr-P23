name: LOVERS ROCK 74
# Reggae, dub & rocksteady. Tempo sugerido: 74 BPM.
# Lovers rock (Londres): one drop suave, aro e hats de soul.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.xX X.xX X.xX X.xX

[p1]
kick   X... .... .... ....
snare  .... .... X... ....
clap   .... .... .... X...
hhc    X.xX X.xX X.xX X.xX
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   .... ...x X... ....
snare  .... ...o X... ....
clap   .... x... ...o X...
hhc    X-XX X-XX X-XX X-XX
hho    .... .... .... ..X.
lotom  X... ..X. ..X. ....

[p3]
kick   X... ...x X... .X..
snare  .... ...o X... ....
clap   .... x... ...o X...
hhc    X-XX X-XX X-XX X-XX
hho    .... .... .... ..X.
hitom  .... .... .... ..X.
lotom  X... ..X. ..X. ....

[p4]                         # BASE
kick   .... .... X... ....
snare  .... .... X... ....
clap   .... x... .... X...
hhc    X.xX X.xX X.xX X.xX
lotom  X... ..X. ..X. ....

[p5]
kick   X... .... X... ....
snare  .... .... X... ....
clap   .... x... .... X...
hhc    X.xX X.xX X.xX X.xX
lotom  X... ..X. ..X. ....

[p6]                         # VARIACION
kick   .... .... X... ....
snare  .... x... .... X...
clap   .... .... X... ....
hhc    X..X X..X X..X X..X
hho    ..x. ..x. ..x. ..x.
lotom  X... ..X. ..X. ....

[p7]
kick   X... .... X... ....
snare  .... x... .... X...
clap   .... .... X... ....
hhc    X..X X..X X..X X..X
hho    ..x. ..x. ..x. ..x.
hitom  .... .... .... Xx..
lotom  X... ..X. ..X. ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
