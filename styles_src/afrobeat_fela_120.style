name: AFROBEAT FELA 120
# Africa. Tempo sugerido: 120 BPM.
# Afrobeat (estilo Fela/Tony Allen): bombo cruzado, caixa con fantasmas e shekere.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. XxX. X.X. XxX.
hho    .... .... ..X. ....

[p1]
kick   X... .... .... ....
snare  .... X... .X.. X...
clap   X..X ..X. ..X. X...
hhc    X.X. XxX. X.X. XxX.
hho    .... .... ..X. ....
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ..Xx ..X. ..X.
snare  ...o X..o oX.o X.o.
clap   X.oX .oX. .oXo X...
hhc    X-X- XXX- X-X- XXX-
hho    .... .... ..X. ..X.
lotom  X..X ..X. ..X. .X..

[p3]
kick   X... ..Xx X... .XX.
snare  ...o X..o oX.o X.oo
clap   X.oX .oX. .oXo X...
hhc    X-X- XXX- X-X- XXX-
hho    .... .... ..X. ..X.
hitom  .... .... .... ..X.
lotom  X..X ..X. ..X. X...

[p4]                         # BASE
kick   X... ..X. ..X. ..X.
snare  .... X..o .X.. X.o.
clap   X..X ..X. ..X. X...
hhc    X.X. XxX. X.X. XxX.
hho    .... .... ..X. ....
lotom  X..X ..X. ..X. .X..

[p5]
kick   X... ..X. X... ..X.
snare  .... X..o .X.. X.oo
clap   X..X ..X. ..X. X...
hhc    X.X. XxX. X.X. XxX.
hho    .... .... ..X. ....
lotom  X..X ..X. ..X. X...

[p6]                         # VARIACION
kick   X... ..X. ..X. ..X.
snare  X..X ..X. ..X. X...
clap   .... X..o .X.. X.o.
hhc    X... Xx.. X.X. Xx..
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .... .X..
lotom  X..X ..X. ..X. ....

[p7]
kick   X... ..X. X... ..X.
snare  X..X ..X. ..X. X...
clap   .... X..o .X.. X.oo
hhc    X... Xx.. X.X. Xx..
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .... .x..
lotom  X..X ..X. ..X. X.Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
