name: FUNK JB 108
# Soul & funk. Tempo sugerido: 108 BPM.
# Funk tipo James Brown: o un forte, caixa con fantasmas e bombo sincopado.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    XxXx XxXx XxXx XxXx
hho    .... ...X .... ....

[p1]
kick   X... .... .... ....
snare  .... X... .... X...
hhc    XxXx XxXx XxXx XxXx
hho    .... ...X .... ....
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X.X. ...x ..X. .X..
snare  ...o X..o .o.o X..o
hhc    XXXX XXXX XXXX XXXX
hho    .... ...X .... ..X.
lotom  X.X. .... ..X. .X..

[p3]
kick   X.X. ...x ..X. .X..
snare  ...o X..o .o.o X.o.
hhc    XXXX XXXX XXXX XXXX
hho    .... ...X .... ..X.
hitom  .... .... .... ..X.
lotom  X.X. .... ..X. .X..

[p4]                         # BASE
kick   X.X. .... ..X. .X..
snare  .... X..o .o.o X..o
hhc    XxXx XxXx XxXx XxXx
hho    .... ...X .... ....
lotom  X.X. .... ..X. .X..

[p5]
kick   X.X. .... ..X. ....
snare  .... X..o .o.o X.o.
hhc    XxXx XxXx XxXx XxXx
hho    .... ...X .... ....
lotom  X.X. .... ..X. .X..

[p6]                         # VARIACION
kick   X.X. .... ..X. .X..
snare  .... X..o .o.o X..o
hhc    Xx.x Xx.x Xx.x Xx.x
hho    ..X. ..XX ..X. ..X.
hitom  .... .... .... .X..
lotom  X.X. .... ..X. ....

[p7]
kick   X.X. .... ..X. ....
snare  .... X..o .o.o X.o.
hhc    Xx.x Xx.x Xx.x Xx.x
hho    ..X. ..XX ..X. ..X.
hitom  .... .... .... XX..
lotom  X.X. .... ..X. ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
