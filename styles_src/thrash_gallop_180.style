name: THRASH GALLOP 180
# Metal. Tempo sugerido: 180 BPM.
# Thrash: galope (corchea + dúas semicorcheas) no bombo e no baixo.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X... X... X... X...
hho    X... .... .... ....

[p1]
kick   X... .... .... ....
snare  .... X... .... X...
hhc    X... X... X... X...
hho    X... .... .... ....
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X.XX X.XX X.XX X.XX
snare  ...o X... ...o X...
hhc    X-o- X-o- X-o- X-o-
hho    X... .... .... ..X.
lotom  X.XX X.XX X.XX X.XX

[p3]
kick   X.XX X.XX X.XX XXXX
snare  ...o X... ...o X...
hhc    X-o- X-o- X-o- X-o-
hho    X... .... .... ..X.
lotom  X.XX X.XX X.XX X.XX

[p4]                         # BASE
kick   X.XX X.XX X.XX X.XX
snare  .... X... .... X...
hhc    X... X... X... X...
hho    X... .... .... ....
lotom  X.XX X.XX X.XX X.XX

[p5]
kick   X.XX X.XX X.XX X.XX
snare  .... X... .... X...
hhc    X... X... X... X...
hho    X... .... .... ....
lotom  X.XX X.XX X.XX X.XX

[p6]                         # VARIACION
kick   X.XX X.XX X.XX X.XX
snare  .... X... .... X...
hhc    X... X... X... X...
hho    X... .... .... ....
hitom  .... .... ...X ...X
lotom  X.XX X.XX X.X. X.X.

[p7]
kick   X.XX X.XX X.XX X.XX
snare  .... X... .... X...
hhc    X... X... X... X...
hho    X... .... .... ....
hitom  .... .... ...X .x.X
lotom  X.XX X.XX X.X. X.X.

[p8]                         # FILL
kick   X..X .... X... ....
snare  ........ ........ xoxoxoxo xoXXXXXX
hhc    ..Xo XoXo .... ....
hho    X... .... .... ....
hitom  .... ..XX .... ....
lotom  .... .... .... ...X
