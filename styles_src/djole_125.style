name: DJOLE 125
# African traditional. Tempo sugerido: 125 BPM.
# Djole (Serra Leoa, Guinea): ritmo de mascaras.
# Voces: kick=dundunba · lotom=sangban · hitom=kenkeni · snare=slap de djembe · clap=ton de djembe
# hhc=campa (kenken) · hho=shekere. No canal BASS os dununs soan como baixo.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X.X. X.X. X.X.

[p1]
kick   X... .... .... ....
snare  X..X X..X X... XXXX
hhc    X.X. X.X. X.X. X.X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ..Xx .... X...
snare  X.oX X.oX X..o X.oX
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
hitom  ..X. ..X. ..X. ..X.
lotom  .... X... X.X. ....

[p3]
kick   X... ..Xx .... XX..
snare  X.oX X.oX X..o XXXX
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
hitom  ..X. ..X. ..X. ..X.
lotom  .... X... X.X. ....

[p4]                         # BASE
kick   X... ..X. .... X...
snare  X..X X..X X... X..X
hhc    X.X. X.X. X.X. X.X.
hitom  ..X. ..X. ..X. ..X.
lotom  .... X... X.X. ....

[p5]
kick   X... ..X. .... X...
snare  X..X X..X X... XXXX
hhc    X.X. X.X. X.X. X.X.
hitom  ..X. ..X. ..X. ..X.
lotom  .... X... X.X. ....

[p6]                         # VARIACION
kick   X... ..X. .... X...
snare  X..X X..X X... X..X
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
hitom  ..X. ..X. ..X. ..X.
lotom  .... X... X.X. ....

[p7]
kick   X... ..X. .... X...
snare  X..X X..X X... XXXX
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
hitom  ..X. ..X. ..X. XxX.
lotom  .... X... X.X. ...o

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
