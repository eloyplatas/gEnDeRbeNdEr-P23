name: TARANTELLA 190
meter: 6/8
# Iberia & Mediterranean. Tempo sugerido: 190 BPM (negras; compas 6/8).
# Tarantella, 6/8: tamburello en corcheas con acento nos pulsos.
# Voces: hhc=sonallas do tamburello · clap/snare=pel.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X.X. X.X.X.

[p1]
kick   X..... ......
snare  ..X.X. ..X.X.
clap   ...... X.....
hhc    X.X.X. X.X.X.
lotom  X..... ......

[p2]                         # ENERGIA
kick   X....x X.....
snare  .oXoX. .oXoX.
clap   .....o X.....
hhc    X-X-X- X-X-X-
hho    ...... ....X.
hitom  ....X. ....X.
lotom  X..... X.....

[p3]
kick   X....x X..X..
snare  .oXoX. .oXoX.
clap   .....o X.....
hhc    X-X-X- X-X-X-
hho    ...... ....X.
hitom  ....X. ....x.
lotom  X..... X.....

[p4]                         # BASE
kick   X..... X.....
snare  ..X.X. ..X.X.
clap   ...... X.....
hhc    X.X.X. X.X.X.
hitom  ....X. ....X.
lotom  X..... X.....

[p5]
kick   X..... X.....
snare  ..X.X. ..X.X.
clap   ...... X.....
hhc    X.X.X. X.X.X.
hitom  ....X. ....x.
lotom  X..... X.....

[p6]                         # VARIACION
kick   X..... X.....
snare  ...... X.....
clap   ..X.X. ..X.X.
hhc    X.X... X.X...
hho    ....X. ....X.
hitom  ....X. ....X.
lotom  X..... X.....

[p7]
kick   X..... X.....
snare  ...... X.....
clap   ..X.X. ..X.X.
hhc    X.X... X.X...
hho    ....X. ....X.
hitom  ....X. ..Xxx.
lotom  X..... X....o

[p8]                         # FILL
kick   X..... X.....
snare  ...... ooxxXX
clap   ...... .....X
hhc    X.X.X. X.X.X.
hho    X..... ......
hitom  XxX... ......
lotom  ...xXx ......
