name: SAMBA 100
# Latin America & Caribbean. Tempo sugerido: 100 BPM.
# Samba, 2/4: surdo de primeira forte no segundo pulso, caixa en semicorcheas, tamborim.
# Voces: kick=surdo de primeira · lotom=surdo de segunda · hhc=tamborim.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.XX .X.X X.XX .X.X

[p1]
kick   X... .... .... ....
snare  X..X X..X X..X X..X
clap   .... .... ..X. .X..
hhc    X.XX .X.X X.XX .X.X
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   .... X..x .... X...
snare  XxxX XxxX XxxX XxxX
clap   .... .... .oX. ....
hhc    X-XX oXoX X-XX oXoX
hho    .... .... .... ..X.
hitom  .... .... ..X. ...X
lotom  X... .... X... ....

[p3]
kick   .... X..x .... XX..
snare  XxxX XxxX XxxX XxxX
clap   .... .... .oX. oX..
hhc    X-XX oXoX X-XX oXoX
hho    .... .... .... ..X.
hitom  .... .... ..X. ..XX
lotom  X... .... X... ....

[p4]                         # BASE
kick   .... X... .... X...
snare  XxxX XxxX XxxX XxxX
clap   .... .... ..X. ....
hhc    X.XX .X.X X.XX .X.X
hitom  .... .... ..X. ...X
lotom  x... .... x... ....

[p5]
kick   .... X... .... X...
snare  XxxX XxxX XxxX XxxX
clap   .... .... ..X. .X..
hhc    X.XX .X.X X.XX .X.X
hitom  .... .... ..X. ...X
lotom  x... .... x... ....

[p6]                         # VARIACION
kick   .... X... .... X...
snare  .... .... ..X. ....
clap   XxxX XxxX XxxX XxxX
hhc    X..X .X.X X..X .X.X
hho    ..X. .... ..X. ....
hitom  .... .... ..X. ...X
lotom  x... .... x... ....

[p7]
kick   .... X... .... X...
snare  .... .... ..X. .X..
clap   XxxX XxxX XxxX XxxX
hhc    X..X .X.X X..X .X.X
hho    ..X. .... ..X. ....
hitom  .... .... ..X. Xx.X
lotom  x... .... x... ..X.

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
