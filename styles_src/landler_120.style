name: LANDLER 120
meter: 3/4
# European folk. Tempo sugerido: 120 BPM (negras; compas 3/4).
# Landler (Austria, Baviera), 3/4: antepasado do vals, pisadas no un.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X... X... X...

[p1]
kick   X... .... ....
clap   .... X... X...
hhc    X... X... X...
lotom  X... .... ....

[p2]                         # ENERGIA
kick   X... .x.. ....
clap   ...o X..o X...
hhc    X-o- X-o- X-o-
hho    .... .... ..X.
lotom  X... .... ....

[p3]
kick   X... .x.. .X..
clap   ...o X..o X...
hhc    X-o- X-o- X-o-
hho    .... .... ..X.
hitom  .... .... ..X.
lotom  X... .... ....

[p4]                         # BASE
kick   X... .... ....
clap   .... X... X...
hhc    X... X... X...
lotom  X... .... ....

[p5]
kick   X... .... ....
clap   .... X... X...
hhc    X... X... X...
lotom  X... .... ....

[p6]                         # VARIACION
kick   X... .... ....
clap   .... X... X...
hhc    X... X... X...
lotom  X... .... ....

[p7]
kick   X... .... ....
clap   .... X... X...
hhc    X... X... X...
hitom  .... .... Xx..
lotom  X... .... ..Xo

[p8]                         # FILL
kick   X... X... X...
snare  .... .... ooxX
clap   .... .... ...X
hhc    X... X... X...
hho    X... .... ....
hitom  .... Xx.. ....
lotom  .... ..Xx ....
