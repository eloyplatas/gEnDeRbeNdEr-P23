name: OLD SCHOOL RAP 100
# Hip hop. Tempo sugerido: 100 BPM.
# Rap old school (caixa de ritmos dos 80): bombo e caixa rectos, palmas.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X.X. X.X. X.X.

[p1]
kick   X... .... .... ....
snare  .... X... .... X...
clap   .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...X X... ....
snare  ...o X... ...o X...
clap   ...o X... ...o X...
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
lotom  X... ...X X... ....

[p3]
kick   X... ...X X.X. .X..
snare  ...o X... ...o X...
clap   ...o X... ...o X...
hhc    X-X- X-X- X-X- X-X-
hho    .... .... .... ..X.
hitom  .... .... .... ..X.
lotom  X... ...X X.X. ....

[p4]                         # BASE
kick   X... ...X X... ....
snare  .... X... .... X...
clap   .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
lotom  X... ...X X... ....

[p5]
kick   X... ...X X.X. ....
snare  .... X... .... X...
clap   .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
lotom  X... ...X X.X. ....

[p6]                         # VARIACION
kick   X... ...X X... ....
snare  .... X... .... X...
clap   .... X... .... X...
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
lotom  X... ...X X... ....

[p7]
kick   X... ...X X.X. ....
snare  .... X... .... X...
clap   .... X... .... X...
hhc    X... X... X... X...
hho    ..X. ..X. ..X. ..X.
hitom  .... .... .... Xx..
lotom  X... ...X X.X. ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
