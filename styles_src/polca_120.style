name: POLCA 120
# Galicia. Tempo sugerido: 120 BPM.
# Polca, 2/4: baixo nos pulsos e acorde nos contratempos.
# Voces: kick=bombo · snare=tamboril/caixa · clap=pel da pandeireta, cunchas ou palmas
# hhc=ferrenas (pandeireta) · hho=xiro/arrastre de ferrenas · lotom/hitom=baixo (ronco, bordon).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    ..X. ..X. ..X. ..X.

[p1]
kick   X... .... .... ....
snare  .... .... .... ..XX
clap   ..X. ..X. ..X. ..X.
hhc    ..X. ..X. ..X. ..X.
hho    .... .... .... ..x.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... X..x X... X...
clap   .oX. .oX. .oX. .oX.
hhc    o-X- o-X- o-X- o-X-
hho    .... .... .... ..X.
hitom  .... X... .... X...
lotom  X... .... X... ....

[p3]
kick   X... X..x X... XX..
snare  .... .... .... oxXX
clap   .oX. .oX. .oX. .oX.
hhc    o-X- o-X- o-X- o-X-
hho    .... .... .... ..x.
hitom  .... X... .... X.X.
lotom  X... .... X... ....

[p4]                         # BASE
kick   X... X... X... X...
clap   ..X. ..X. ..X. ..X.
hhc    ..X. ..X. ..X. ..X.
hitom  .... X... .... X...
lotom  X... .... X... ....

[p5]
kick   X... X... X... X...
snare  .... .... .... oxXX
clap   ..X. ..X. ..X. ..X.
hhc    ..X. ..X. ..X. ..X.
hho    .... .... .... ..x.
hitom  .... X... .... X...
lotom  X... .... X... ....

[p6]                         # VARIACION
kick   X... X... X... X...
clap   ..X. ..X. ..X. ..X.
hho    ..X. ..X. ..X. ..X.
hitom  .... X... .... X...
lotom  X... .... X... ....

[p7]
kick   X... X... X... X...
snare  ..X. ..X. ..X. ..X.
clap   .... .... .... oxXX
hhc    .... .... .... ..X.
hho    ..X. ..X. ..X. ..x.
hitom  .... X... .... Xx..
lotom  X... .... X... ..Xo

[p8]                         # FILL
kick   X... X... X... X...
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    ..X. ..X. ..X. ..X.
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
