name: TRAP 140
# Hip hop. Tempo sugerido: 140 BPM.
# Trap: palmas no 3, hats en semicorcheas con redobres de fusas e 808.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X.X.X. X.X.X.X. X.X.X.XX X.X.X.X.

[p1]
kick   X... .... .... ....
clap   .... .... X... ....
hhc    X.X.X.X. X.X.X.X. X.X.X.X. XXXXXXXX
hho    .... .... .... ..x.
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ...X ..X. ....
clap   .... ...o X... ....
hhc    X.X.X.X. X.X.X.X. X.X.X.XX X.X.X.X.
hho    .... .... .... ..X.
lotom  X... ...X ..X. ....

[p3]
kick   X... ...X ..X. .X..
clap   .... ...o X... ....
hhc    X.X.X.X. X.X.X.X. X.X.X.X. XXXXXXXX
hho    .... .... .... ..x.
hitom  .... .... .... ..X.
lotom  X... ...X ..X. .X..

[p4]                         # BASE
kick   X... ...X ..X. ....
clap   .... .... X... ....
hhc    X.X.X.X. X.X.X.X. X.X.X.XX X.X.X.X.
lotom  X... ...X ..X. ....

[p5]
kick   X... ...X ..X. .X..
clap   .... .... X... ....
hhc    X.X.X.X. X.X.X.X. X.X.X.X. XXXXXXXX
hho    .... .... .... ..x.
lotom  X... ...X ..X. .X..

[p6]                         # VARIACION
kick   X... ...X ..X. ....
clap   .... .... X... ....
hhc    X.X...X. X.X...X. X.X...XX X.X...X.
hho    ..X. ..X. ..X. ..X.
lotom  X... ...X ..X. ....

[p7]
kick   X... ...X ..X. .X..
clap   .... .... X... ....
hhc    X.X...X. X.X...X. X.X...X. XXXXXXXX
hho    ..X. ..X. ..X. ..x.
hitom  .... .... .... XX..
lotom  X... ...X ..X. ..Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
