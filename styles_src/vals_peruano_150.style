name: VALS PERUANO 150
meter: 3/4
# Latin America & Caribbean. Tempo sugerido: 150 BPM (negras; compas 3/4).
# Vals criollo peruano, 3/4: cajon con golpes cruzados (hemiola).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
clap   .... X... X...

[p1]
kick   X... .... ....
snare  ..X. ..X. ..X.
clap   .... X... X...
lotom  X... .... ....

[p2]                         # ENERGIA
kick   X... .x.. X...
snare  ...o X... .oX.
clap   ...o X..o X...
lotom  X... .... X...

[p3]
kick   X... .xX. .X..
snare  .oX. .oX. .oX.
clap   ...o X..o X...
hitom  .... .... ..X.
lotom  X... .... ....

[p4]                         # BASE
kick   X... .... X...
snare  .... X... ..X.
clap   .... X... X...
lotom  X... .... X...

[p5]
kick   X... ..X. ....
snare  ..X. ..X. ..X.
clap   .... X... X...
lotom  X... .... ....

[p6]                         # VARIACION
kick   X... .... X...
snare  .... X... X...
clap   .... X... ..X.
lotom  X... .... X...

[p7]
kick   X... ..X. ....
snare  .... X... X...
clap   ..X. ..X. ..X.
hitom  .... .... Xx..
lotom  X... .... ..Xo

[p8]                         # FILL
kick   X... X... X...
snare  .... .... ooxX
clap   .... .... ...X
hho    X... .... ....
hitom  .... Xx.. ....
lotom  .... ..Xx ....
