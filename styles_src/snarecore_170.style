name: SNARECORE 170
meter: 7/8
# Breakcore & extreme. Tempo sugerido: 170 BPM (negras; compas 7/8).
# Breakcore en 7/8 (estilo Venetian Snares): caixas en fusas sobre sete corcheas.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X.X.X.X.X.X.

[p1]
kick   X.............
snare  ....X.....X.X......XXXXXXXXX
hhc    X.X.X.X.X.X.X.
lotom  X.............

[p2]                         # ENERGIA
kick   X...X.x.X.....
snare  ..o.X...o.X.X....o.Xo.XoXXXX
hhc    X-X-X-X-X-X-X-
hho    ............X.
lotom  X.......X.....

[p3]
kick   X...X.x.X..XX.
snare  ..o.X...o.X.X....ooXXXXXXXXX
hhc    X-X-X-X-X-X-X-
hho    ............X.
lotom  X.......X...X.

[p4]                         # BASE
kick   X...X...X.....
snare  ....X.....X.X......X..X.XXXX
hhc    X.X.X.X.X.X.X.
lotom  X.......X.....

[p5]
kick   X...X...X...X.
snare  ....X.....X.X......XXXXXXXXX
hhc    X.X.X.X.X.X.X.
lotom  X.......X...X.

[p6]                         # VARIACION
kick   X...X...X.....
snare  ....X.....X.X......X..X.XXXX
hhc    X...X...X...X.
hho    ..X...X...X...
lotom  X.......X.....

[p7]
kick   X...X...X...X.
snare  ....X.....X.X......XXXXXXXXX
hhc    X...X...X...X.
hho    ..X...X...X...
hitom  ..........Xx..
lotom  X.......X...Xo

[p8]                         # FILL
kick   X..X...X......
snare  ..............xoxoxoxoXXXXXX
hhc    ..XoXoX.......
hho    X.............
hitom  .....XX.......
lotom  .............X
