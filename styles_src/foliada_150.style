name: FOLIADA 150
meter: 3/4
# Galicia. Tempo sugerido: 150 BPM (negras; compas 3/4).
# Foliada, 3/4: cancion alegre de tipo xota, de romaria; palmas nos pulsos 2 e 3.
# Voces: kick=bombo · snare=tamboril/caixa · clap=pel da pandeireta, cunchas ou palmas
# hhc=ferrenas (pandeireta) · hho=xiro/arrastre de ferrenas · lotom/hitom=baixo (ronco, bordon).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X.X. X.X.

[p1]
kick   X... .... ....
snare  X... .... ....
clap   .... X... X...
hhc    X.X. X.X. X.X.
lotom  X... .... ....

[p2]                         # ENERGIA
kick   X... .x.. ....
snare  X... o... o.oo
clap   ...o X..o X...
hhc    X-X- X-X- X-X-
hho    .... .... ..X.
hitom  .... .... x.x.
lotom  X... X... X...

[p3]
kick   X... .x.. XX..
snare  X... o... o.oo
clap   ...o X..o X...
hhc    X-X- X-X- X-X-
hho    .... .... ..X.
hitom  .... .... x.x.
lotom  X... X... X...

[p4]                         # BASE
kick   X... .... ....
snare  X... o... o.oo
clap   .... X... X...
hhc    X.X. X.X. X.X.
hitom  .... .... x.x.
lotom  X... X... X...

[p5]
kick   X... .... X...
snare  X... o... o.oo
clap   .... X... X...
hhc    X.X. X.X. X.X.
hitom  .... .... x.x.
lotom  X... X... X...

[p6]                         # VARIACION
kick   X... .... ....
snare  .... X... X...
clap   X... o... o.oo
hhc    X... X... X...
hho    ..X. ..X. ..X.
hitom  .... .... x.x.
lotom  X... X... X...

[p7]
kick   X... .... X...
snare  .... X... X...
clap   X... o... o.oo
hhc    X... X... X...
hho    ..X. ..X. ..X.
hitom  .... .... xxx.
lotom  X... X... X..o

[p8]                         # FILL
kick   X... X... X...
snare  .... .... ooxX
clap   .... .... ...X
hhc    X.X. X.X. X.X.
hho    X... .... ....
hitom  .... Xx.. ....
lotom  .... ..Xx ....
