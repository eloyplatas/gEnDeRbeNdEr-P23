name: SOLI 90
meter: 6/8
# African traditional. Tempo sugerido: 90 BPM (negras; compas 6/8).
# Soli (Guinea), 12/8: un compas = 12 pulsos (negra = 90).
# Voces: kick=dundunba · lotom=sangban · hitom=kenkeni · snare=slap de djembe · clap=ton de djembe
# hhc=campa (kenken) · hho=shekere. No canal BASS os dununs soan como baixo.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X.XX .X.X.X

[p1]
kick   X..... ......
snare  X.XX.X X.XXXX
clap   ...X.. ...X..
hhc    X.X.XX .X.X.X
lotom  X..... ......

[p2]                         # ENERGIA
kick   X....x X.....
snare  XoXXoX XoXXoX
clap   ..oX.. ..oX..
hhc    X-X-XX oXoXoX
hho    ...... ....X.
hitom  X..X.. X..X..
lotom  ..X..X ..X..X

[p3]
kick   X....x X..X..
snare  XoXXoX XoXXXX
clap   ..oX.. ..oX..
hhc    X-X-XX oXoXoX
hho    ...... ....X.
hitom  X..X.. X..XX.
lotom  ..X..X ..X..X

[p4]                         # BASE
kick   X..... X.....
snare  X.XX.X X.XX.X
clap   ...X.. ...X..
hhc    X.X.XX .X.X.X
hitom  X..X.. X..X..
lotom  ..X..X ..X..X

[p5]
kick   X..... X.....
snare  X.XX.X X.XXXX
clap   ...X.. ...X..
hhc    X.X.XX .X.X.X
hitom  X..X.. X..X..
lotom  ..X..X ..X..X

[p6]                         # VARIACION
kick   X..... X.....
snare  ...X.. ...X..
clap   X.XX.X X.XX.X
hhc    X.X..X .X.X.X
hho    ....X. ......
hitom  X..X.. X..X.X
lotom  ..X..X ..X...

[p7]
kick   X..... X.....
snare  ...X.. ...X..
clap   X.XX.X X.XXXX
hhc    X.X..X .X.X.X
hho    ....X. ......
hitom  X..X.. X..X.X
lotom  ..X..X ..X.X.

[p8]                         # FILL
kick   X..... X.....
snare  ...... ooxxXX
clap   ...... .....X
hhc    X.X.XX .X.X.X
hho    X..... ......
hitom  XxX... ......
lotom  ...xXx ......
