name: ELECTRO FUNK 110
# Club & bass. Tempo sugerido: 110 BPM.
# Electro funk (808): bombo sincopado, palmas e cencerro (hho).
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.X. X.X. X.X. X.X.
hho    ...X .... ..X. ....

[p1]
kick   X... .... .... ....
clap   .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
hho    ...X .... ..X. ....
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... ..Xx ..X. ....
clap   ...o X... ...o X...
hhc    X-X- X-X- X-X- X-X-
hho    ...X .... ..X. ..X.
lotom  X... ..X. ..X. ....

[p3]
kick   X... ..Xx ..X. .X..
clap   ...o X... ...o X...
hhc    X-X- X-X- X-X- X-X-
hho    ...X .... ..X. ..X.
hitom  .... .... .... ..X.
lotom  X... ..X. ..X. X...

[p4]                         # BASE
kick   X... ..X. ..X. ....
clap   .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
hho    ...X .... ..X. ....
lotom  X... ..X. ..X. ....

[p5]
kick   X... ..X. ..X. .X..
clap   .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
hho    ...X .... ..X. ....
lotom  X... ..X. ..X. X...

[p6]                         # VARIACION
kick   X... ..X. ..X. ....
clap   .... X... .... X...
hhc    X... X... X.X. X...
hho    ..XX ..X. ..X. ..X.
lotom  X... ..X. ..X. ....

[p7]
kick   X... ..X. ..X. .X..
clap   .... X... .... X...
hhc    X... X... X.X. X...
hho    ..XX ..X. ..X. ..X.
hitom  .... .... .... .x..
lotom  X... ..X. ..X. X.Xo

[p8]                         # FILL
kick   X... .... .... ....
snare  .... .... .... ooxX
clap   .... .... .... ...X
hhc    X.X. X.X. X.X. ....
hho    X... .... .... ....
hitom  .... .... Xx.. ....
lotom  .... .... ..Xx ....
