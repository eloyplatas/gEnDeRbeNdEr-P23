name: IDM GLITCH 110
# IDM & experimental. Tempo sugerido: 110 BPM.
# IDM glitch: tartamudeos en fusas e golpes desprazados.
# Pad: centro=BASE p4/5 · ENERGIA p2/3 · VARIACION p6/7 · INTRO p0/1 · FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0 (con DENS por defecto solo suena X)

[p0]                         # INTRO
hhc    X.XX..X. X...X.XX X.X...X. XX..X...

[p1]
kick   X... .... .... ....
snare  ........ X.X...XX ........ X..XXXX.
hhc    X.X...XX ..X.X.X. X.XX..X. ..X.XX..
lotom  X... .... .... ....

[p2]                         # ENERGIA
kick   X... .X.x X..X ....
snare  ......o. X...ooXX ......o. Xo.X....
hhc    X.XXo.X. X.-.X.XX X.X.o.X. XX-.X.-.
hho    .... .... .... ..X.
lotom  X... .X.. ..X. ....

[p3]
kick   X..X .X.x ..X. .X..
snare  ......o. X.X.ooXX ......o. XooXXXX.
hhc    X.X.o.XX o.X.X.X. X.XXo.X. o.X.XX-.
hho    .... .... .... ..X.
hitom  .... .... .... ..X.
lotom  X..X .... ..X. ....

[p4]                         # BASE
kick   X... .X.. X..X ....
snare  ........ X.....XX ........ X..X....
hhc    X.XX..X. X...X.XX X.X...X. XX..X...
lotom  X... .X.. ..X. ....

[p5]
kick   X..X .X.. ..X. .X..
snare  ........ X.X...XX ........ X..XXXX.
hhc    X.X...XX ..X.X.X. X.XX..X. ..X.XX..
lotom  X..X .... ..X. ....

[p6]                         # VARIACION
kick   X... .X.. X..X ....
snare  ........ X.....XX ........ X..X....
hhc    X.XX..X. X.....XX X.X...X. XX......
hho    .... ..X. .... ..X.
lotom  X... .X.. ..X. ....

[p7]
kick   X..X .X.. ..X. .X..
snare  ........ X.X...XX ........ X..XXXX.
hhc    X.X...XX ..X...X. X.XX..X. ..X..X..
hho    .... ..X. .... ..X.
hitom  .... .... .... Xx..
lotom  X..X .... ..X. ..Xo

[p8]                         # FILL
kick   X..X .... X... ....
snare  ........ ........ xoxoxoxo xoXXXXXX
hhc    ..Xo XoXo .... ....
hho    X... .... .... ....
hitom  .... ..XX .... ....
lotom  .... .... .... ...X
